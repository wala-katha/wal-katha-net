/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://widget.trustpilot.com; style-src 'self' 'unsafe-inline' https://widget.trustpilot.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://comments.wala-katha.workers.dev https://api.web3forms.com https://cloudflareinsights.com https://widget.trustpilot.com https://www.trustpilot.com; frame-src 'self' https://www.trustpilot.com https://widget.trustpilot.com; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# PAGESPEED "USE EFFICIENT CACHE LIFETIMES" FIX (Est savings 5 KiB):
# PageSpeed flagged the Cloudflare beacon.min.js script (1d TTL) - that
# script is served from Cloudflare's own static.cloudflareinsights.com
# origin (Web Analytics dashboard feature), NOT from this codebase, so
# its cache lifetime cannot be controlled here (see chat explanation).
#
# What CAN be controlled from this file is every asset WE serve from our
# own origin. Astro's build output hashes filenames for JS/CSS bundles
# and this site's images are all static (never mutate in-place - see
# optimize-images.yml, which always writes to the same .webp path only
# when content actually changed), so it is 100% safe to cache these
# aggressively for a full year with "immutable" - eliminating any
# repeat-visit re-download entirely for these paths, which directly
# improves the "Use efficient cache lifetimes" score for every asset
# this site actually controls.
#
# 2026-08 CSP UPDATE (Trustpilot in-site review modal + widget fix):
# script-src now includes widget.trustpilot.com - the existing
# TrustpilotReview.astro component already loads Trustpilot's official
# TrustBox bootstrap script from this exact origin, but it was missing
# from the whitelist, meaning the star-rating widget was likely being
# silently blocked by the browser before this fix. frame-src is a NEW
# directive (previously absent, so it fell back to default-src 'self'
# and would have blocked any cross-origin iframe) added specifically to
# allow www.trustpilot.com (Trustpilot's official, documented "Embedded
# Review Form" - see support.trustpilot.com/hc/en-us/articles/206514477)
# so a visitor can submit a review inside an in-site popup modal without
# ever leaving walakatha.net. connect-src additions cover the widget's
# own background data-fetch calls.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
