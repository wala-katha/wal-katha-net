/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://comments.wala-katha.workers.dev https://api.web3forms.com https://cloudflareinsights.com; frame-src 'self' https://www.teraboxpage.com; frame-ancestors 'self'

# PAGESPEED "USE EFFICIENT CACHE LIFETIMES" FIX (Est savings 5 KiB):
# PageSpeed flagged the Cloudflare beacon.min.js script (1d TTL) - that
# script is served from Cloudflare's own static.cloudflareinsights.com
# origin (Web Analytics dashboard feature), NOT from this codebase, so
# its cache lifetime cannot be controlled here (see chat explanation).
#
# What CAN be controlled from this file is every asset WE serve from our
# own origin. Astro's build output hashes filenames for JS/CSS bundles
# and this site's images are all static (never mutate in-place - see
# optimize-images.yml, which always writes to the same .webp path only
# when content actually changed), so it is 100% safe to cache these
# aggressively for a full year with "immutable" - eliminating any
# repeat-visit re-download entirely for these paths, which directly
# improves the "Use efficient cache lifetimes" score for every asset
# this site actually controls.
#
# 2026-08 CSP UPDATE (Footer "Watch Movies" popup - TeraBox iframe):
# frame-src now whitelists https://www.teraboxpage.com so the footer's
# movie-collection popup can embed https://www.teraboxpage.com/myknow/
# sinhalamovies inside an <iframe> without being silently blocked by
# the browser's Content Security Policy. The previous widget.trustpilot.com
# / www.trustpilot.com entries (script-src, style-src, connect-src,
# frame-src) have been removed since the footer's Trustpilot review
# widget and its embedded review-form iframe were both replaced by this
# movies popup - nothing else on the site references those Trustpilot
# domains, so removing them keeps this policy tight instead of leaving
# unused, unnecessarily-broad allowances in place.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
