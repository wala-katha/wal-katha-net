---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PostSingle from "@/partials/PostSingle.astro";
import config from "@/config/config.json";
import { isValid } from "date-fns";
import { slugify as globalSlugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const BLOG_FOLDER = "posts";
  const posts = await getSinglePage(BLOG_FOLDER);
  if (!posts || posts.length === 0) return [];
  const paths = posts.map((post) => ({
    params: { single: post.id },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;

if (!post || !post.data) {
  return Astro.redirect("/404");
}

const { title, meta_title, image, description, date, updated, authors, tags } = post.data;

const parsedDate = date ? new Date(date) : null;
const safeDateISO = parsedDate && isValid(parsedDate) ? parsedDate.toISOString() : new Date().toISOString();

// dateModified derivation: only true if "updated" genuinely differs from "date" (not just present).
const parsedUpdated = updated ? new Date(updated) : null;
const hasGenuineUpdate =
  parsedUpdated && isValid(parsedUpdated) && parsedDate && isValid(parsedDate)
    ? parsedUpdated.getTime() !== parsedDate.getTime()
    : false;
const safeUpdatedISO = hasGenuineUpdate ? parsedUpdated!.toISOString() : safeDateISO;

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

// Cloudflare Pages trailing-slash consistency: canonical tag and schema URL must match exactly.
const canonicalUrl = `${base_url}/blog/${post.id}/`;

// NEW: dynamic, auto-generated OG image path for this post
// (/og/{slug}.png, generated at build time by src/pages/og/[slug].png.ts).
// Passed into <Base image={...}> below so Base.astro's own generic
// og:image/twitter:image meta block stays in sync with the
// article-specific og:image/twitter:image tags PostSingle.astro
// renders separately.
const ogImagePath = `/og/${post.id}.png`;

const authorName = Array.isArray(authors) && authors.length > 0 ? authors[0] : config?.metadata?.meta_author || "Admin";
const authorSlug = globalSlugify(authorName || "");

// NEW: author image lookup for the Person schema below (E-E-A-T
// enhancement). Reuses the same slugify-match pattern PostSingle.astro
// already uses to resolve an author frontmatter name against the
// authors content collection - a pattern already proven safe/working
// on this codebase, so no new matching logic is introduced here.
const allAuthors = await getSinglePage("authors");
const matchedAuthorEntry = allAuthors.find(
  (a) => globalSlugify(a.data.title || "") === authorSlug
);
const authorImageUrl = matchedAuthorEntry?.data.image
  ? matchedAuthorEntry.data.image.startsWith("http")
    ? matchedAuthorEntry.data.image
    : `${base_url}${matchedAuthorEntry.data.image}`
  : undefined;

const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : undefined;

// ImageObject (recommended over a plain string URL per Google's
// Article/NewsArticle structured-data docs). Now points at the
// dynamically-generated /og/{slug}.png instead of the frontmatter
// thumbnail, so every post (even ones without a manual "image" field)
// gets a proper social-share image.
const imageObject = {
  "@type": "ImageObject",
  "url": `${base_url}${ogImagePath}`,
  "width": 1200,
  "height": 630
};

// keywords: reuses the same post.data.tags source already rendered
// via <meta name="keywords"> in PostSingle.astro, so both can never
// drift out of sync.
const keywordsString = Array.isArray(tags) && tags.length > 0 ? tags.join(", ") : undefined;

// speakable: points at the two real, crawlable DOM nodes
// PostSingle.astro already renders for this purpose
// (#speakable-headline on the article H1, #speakable-summary on the
// sr-only description paragraph).
const speakableSpecification = {
  "@type": "SpeakableSpecification",
  "cssSelector": ["#speakable-headline", "#speakable-summary"]
};

// publisher references the single, authoritative Organization entity
// defined once (with logo.webp + sameAs) on index.astro via @id - no
// duplicate/conflicting inline Organization object here.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title || "",
  "description": description || "",
  "image": imageObject,
  "datePublished": safeDateISO,
  "dateModified": safeUpdatedISO,
  "inLanguage": "si",
  "isAccessibleForFree": true,
  "license": `${base_url}/copyright-credit-policy/`,
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorSlug ? `${base_url}/authors/${authorSlug}/` : undefined,
    "image": authorImageUrl
  },
  "publisher": { "@id": `${base_url}/#organization` },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${base_url}/#website`
  },
  "wordCount": wordCount,
  "keywords": keywordsString,
  "speakable": speakableSpecification
};
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={ogImagePath}
  canonical={canonicalUrl}
  isArticle={true}
>
  {/* isArticle={true} - Base.astro duplicate OG/Twitter/robots tags render නොකරයි */}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <PostSingle post={post} />
</Base>
