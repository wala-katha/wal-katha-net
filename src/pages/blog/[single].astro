---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PostSingle from "@/partials/PostSingle.astro";
import config from "@/config/config.json";
import { isValid } from "date-fns";
import { humanize, slugify as globalSlugify } from "@/lib/utils/textConverter";
import { buildMetaKeywords } from "@/lib/utils/keywordExtractor";

export async function getStaticPaths() {
  const BLOG_FOLDER = "posts";
  const posts = await getSinglePage(BLOG_FOLDER);
  if (!posts || posts.length === 0) return [];
  const paths = posts.map((post) => ({
    params: { single: post.id },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;

if (!post || !post.data) {
  return Astro.redirect("/404");
}

const { title, meta_title, image, image_alt, description, date, updated, authors, categories, tags } = post.data;

// Null-safe copies: a post without categories/tags must not break the build.
const safeCategories: string[] = Array.isArray(categories) ? categories : [];
const safeTags: string[] = Array.isArray(tags) ? tags : [];

// Frontmatter strings routinely carry a trailing newline from editors, which
// leaked straight into <title> and <meta name="description">.
const titleClean = typeof title === "string" ? title.trim() : title;
const metaTitleClean = typeof meta_title === "string" ? meta_title.trim() : meta_title;
const descriptionClean = typeof description === "string" ? description.trim() : description;
const imageAltClean = (image_alt || title || "").toString().trim();

const parsedDate = date ? new Date(date) : null;
const safeDateISO = parsedDate && isValid(parsedDate) ? parsedDate.toISOString() : new Date().toISOString();

// dateModified derivation: only true if "updated" genuinely differs from "date" (not just present).
const parsedUpdated = updated ? new Date(updated) : null;
const hasGenuineUpdate =
  parsedUpdated && isValid(parsedUpdated) && parsedDate && isValid(parsedDate)
    ? parsedUpdated.getTime() !== parsedDate.getTime()
    : false;
const safeUpdatedISO = hasGenuineUpdate ? parsedUpdated!.toISOString() : safeDateISO;

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

// Cloudflare Pages trailing-slash consistency: canonical tag and schema URL must match exactly.
const canonicalUrl = `${base_url}/blog/${post.id}/`;

// Brand name from config so og:site_name cannot drift from the site title.
const siteName = config?.site?.title || "Wal Katha";

// NEW: dynamic, auto-generated OG image path for this post
// (/og/{slug}.png, generated at build time by src/pages/og/[slug].png.ts).
// Passed into <Base image={...}> below so Base.astro emits the
// og:image/og:image:width/og:image:type/twitter:image set in <head>.
const ogImagePath = `/og/${post.id}.png`;

const authorName = Array.isArray(authors) && authors.length > 0 ? authors[0] : config?.metadata?.meta_author || "Admin";
const authorSlug = globalSlugify(authorName || "");

// NEW: author image lookup for the Person schema below (E-E-A-T
// enhancement). Reuses the same slugify-match pattern PostSingle.astro
// already uses to resolve an author frontmatter name against the
// authors content collection.
const allAuthors = await getSinglePage("authors");
const matchedAuthorEntry = allAuthors.find(
  (a) => globalSlugify(a.data.title || "") === authorSlug
);
const authorImageUrl = matchedAuthorEntry?.data.image
  ? matchedAuthorEntry.data.image.startsWith("http")
    ? matchedAuthorEntry.data.image
    : `${base_url}${matchedAuthorEntry.data.image}`
  : undefined;

const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : undefined;

// ImageObject (recommended over a plain string URL per Google's
// Article/NewsArticle structured-data docs).
const imageObject = {
  "@type": "ImageObject",
  "url": `${base_url}${ogImagePath}`,
  "width": 1200,
  "height": 630
};

// keywords: frontmatter tags merged with auto-extracted body keywords
// via keywordExtractor.ts's buildMetaKeywords().
const mergedKeywords = buildMetaKeywords(safeTags, post.body);
const keywordsString = mergedKeywords.length > 0 ? mergedKeywords.join(", ") : undefined;

// Extra entity/topic signals for AI Overviews, beyond the curated tags.
const extractedOnlyKeywords = mergedKeywords.filter(
  (k) => !safeTags.some((t: string) => t.toLowerCase() === k.toLowerCase())
);

// speakable: points at the two real, crawlable DOM nodes
// PostSingle.astro already renders for this purpose.
const speakableSpecification = {
  "@type": "SpeakableSpecification",
  "cssSelector": ["#speakable-headline", "#speakable-summary"]
};

// publisher references the single, authoritative Organization entity
// defined once on index.astro via @id.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": titleClean || "",
  "description": descriptionClean || "",
  "image": imageObject,
  "datePublished": safeDateISO,
  "dateModified": safeUpdatedISO,
  "inLanguage": "si",
  "isAccessibleForFree": true,
  "license": `${base_url}/copyright-credit-policy/`,
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorSlug ? `${base_url}/authors/${authorSlug}/` : undefined,
    "image": authorImageUrl
  },
  "publisher": { "@id": `${base_url}/#organization` },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${base_url}/#website`
  },
  "wordCount": wordCount,
  "keywords": keywordsString,
  "speakable": speakableSpecification
};
---

<Base
  title={titleClean}
  meta_title={metaTitleClean}
  description={descriptionClean}
  image={ogImagePath}
  canonical={canonicalUrl}
  isArticle={true}
>
  <Fragment slot="head">
    {image && <link rel="preload" as="image" href={image} fetchpriority="high" />}

    <meta property="og:type" content="article" />
    <meta property="og:title" content={titleClean} />
    <meta property="og:description" content={descriptionClean} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image:alt" content={imageAltClean} />
    <meta property="og:locale" content="si_LK" />
    <meta property="og:site_name" content={siteName} />

    <meta property="article:published_time" content={safeDateISO} />
    <meta property="article:modified_time" content={safeUpdatedISO} />
    <meta property="article:author" content={authorName} />
    {safeCategories.map((category: string) => (
      <meta property="article:section" content={humanize(category)} />
    ))}
    {safeTags.map((tag: string) => (
      <meta property="article:tag" content={humanize(tag)} />
    ))}
    {extractedOnlyKeywords.map((keyword: string) => (
      <meta property="article:tag" content={keyword} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleClean} />
    <meta name="twitter:description" content={descriptionClean} />
    <meta name="twitter:image:alt" content={imageAltClean} />
    <meta name="twitter:site" content="@WalaKatha" />

    {keywordsString && <meta name="keywords" content={keywordsString} />}
    <meta name="author" content={authorName} />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <PostSingle post={post} />
</Base>
