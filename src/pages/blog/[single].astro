---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PostSingle from "@/partials/PostSingle.astro";
import config from "@/config/config.json";
import { isValid } from "date-fns";
import { slugify as globalSlugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const BLOG_FOLDER = "posts";
  const posts = await getSinglePage(BLOG_FOLDER);
  if (!posts || posts.length === 0) return [];
  const paths = posts.map((post) => ({
    params: { single: post.id },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;

if (!post || !post.data) {
  return Astro.redirect("/404");
}

const { title, meta_title, image, description, date, authors } = post.data;

const parsedDate = date ? new Date(date) : null;
const safeDateISO = parsedDate && isValid(parsedDate) ? parsedDate.toISOString() : new Date().toISOString();

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

// 🎯 CLOUDFLARE PAGES TRAILING-SLASH CONSISTENCY:
// Base.astro auto-appends a trailing slash to <link rel="canonical">
// (Cloudflare Pages serves directory-style URLs with a trailing slash
// by default). This local canonicalUrl is also embedded directly inside
// the JSON-LD Article schema's mainEntityOfPage.@id below, bypassing
// Base.astro's trailing-slash logic, so we add the slash here too to
// keep both in sync. NOTE: PostSingle.astro's own postUrl (used for
// og:url / social share links) is built independently from
// Astro.site + post.id and is NOT affected by this change.
const canonicalUrl = `${base_url}/blog/${post.id}/`;

const authorName = Array.isArray(authors) && authors.length > 0 ? authors[0] : config?.metadata?.meta_author || "Admin";
const authorSlug = globalSlugify(authorName || "");

// 🎯 2026 SCHEMA UPGRADE: Article -> BlogPosting
// Google's structured data docs list BlogPosting as the semantically
// correct subtype for blog content (Article/NewsArticle/BlogPosting are
// structurally interchangeable, but BlogPosting is the precise type for
// this site's content). Added "isPartOf" (ties the post to the site's
// WebSite entity already defined in index.astro's homePageSchema, which
// strengthens topical/entity association for Google) and "wordCount"
// (an optional-but-recommended field that adds a small E-E-A-T content-
// depth signal). No existing fields were removed or renamed, so this is
// purely additive — safe for any tooling already reading this schema.
const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title || "",
  "description": description || "",
  "image": image ? (image.startsWith("http") ? image : `${base_url}${image}`) : undefined,
  "datePublished": safeDateISO,
  "dateModified": safeDateISO,
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorSlug ? `${base_url}/authors/${authorSlug}/` : undefined
  },
  "publisher": {
    "@type": "Organization",
    "name": config?.site?.title || "Wala Katha",
    "logo": {
      "@type": "ImageObject",
      "url": `${base_url}/images/logo.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": `${base_url}/#website`
  },
  "wordCount": wordCount
};
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonicalUrl}
  isArticle={true}
>
  {/* ✅ isArticle={true} — Base.astro duplicate OG/Twitter/robots tags render නොකරයි */}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <PostSingle post={post} />
</Base>
