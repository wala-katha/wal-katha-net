---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import FeaturedSlider from "@/layouts/components/FeaturedSlider.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

// 🎯 HTML PAGE SIZE FIX (SEO Site Checkup — "HTML Page Size Test"
// flagged 37.35 KB vs 33 KB average, recommending "external style
// sheets"): the large :global(...) CSS block that used to live inline
// inside this file's <style is:global> tag (below) has been moved,
// byte-for-byte identical, to src/styles/index-overrides.css and is
// now imported here as a static asset import instead. Astro's Vite
// pipeline (cssCodeSplit: true, already set in astro.config.mjs)
// extracts this into its own hashed, cacheable .css file at build
// time — public/_headers already has a site-wide
// "/*.css -> Cache-Control: public, max-age=31536000, immutable"
// rule, so this file is automatically cached for a year with zero
// additional config. This directly shrinks the HTML payload (the CSS
// text is no longer duplicated inside every homepage HTML response)
// while being 100% functionally and visually identical — same
// selectors, same !important flags, same cascade order, same output
// CSS. Base.astro's inline <style>/<script> and PostSingle.astro's
// inline comment-system CSS/JS were intentionally left untouched
// (see index-overrides.css's own header comment for why) to protect
// existing working behavior exactly as requested.
import "@/styles/index-overrides.css";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");
const canonicalUrl = base_url;

const siteLogo = base_url + config.site.logo;

import menu from "@/config/menu.json";

function buildNavItems(base: string) {
  const items: { name: string; url: string }[] = [];
  for (const item of menu.main || []) {
    if (item.hasChildren && Array.isArray(item.children)) {
      for (const child of item.children) {
        if (child?.url) items.push({ name: child.name, url: child.url });
      }
    } else if (item?.url) {
      items.push({ name: item.name, url: item.url });
    }
  }
  return items.map((navItem) => {
    const fullUrl = `${base}${withTrailingSlash(navItem.url)}`;
    return {
      "@type": "SiteNavigationElement",
      "@id": `${fullUrl}#navitem-${navItem.name.toLowerCase().replace(/\s+/g, "-")}`,
      "name": navItem.name,
      "url": fullUrl,
      "isPartOf": { "@id": `${base}/#website` },
    };
  });
}

const navigationSchema = buildNavItems(base_url);

const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${base_url}/#website`,
      "url": base_url,
      "name": "Wala Katha",
      "alternateName": ["Wala Katha Stories","Wal Katha","සිංහල වල් කතා","Sinhala Wal Katha","Wela Katha","Sinhala Wela Katha","WalKatha"],
      "description": "Wala Katha - අලුත්ම සහ රසවත්ම සිංහල වල් කතා (Sinhala Wal Katha) සහ වැල කතා (Wela Katha) දිනපතා කියවන්න ඇති එකම නිල වෙබ් අඩවිය.",
      "publisher": { "@id": `${base_url}/#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${base_url}/search/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${base_url}/#organization`,
      "name": "Wala Katha",
      "url": base_url,
      "logo": {
        "@type": "ImageObject",
        "@id": `${base_url}/#logo`,
        "url": siteLogo,
        "caption": "Wala Katha Logo"
      }
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}/#collection`,
      "url": canonicalUrl,
      "name": "Wala Katha - Sinhala Wal Katha & Wela Katha",
      "description": "Daily updated premium Sinhala wal katha, wala katha and wela stories collection.",
      "isPartOf": { "@id": `${base_url}/#website` },
      "about": { "@type": "Thing", "name": "Sinhala Wal Katha Literature" }
    },
    ...navigationSchema
  ]
};
---

<Base 
  title="Wala Katha - Sinhala Wal Katha & Wela Katha"
  meta_title="Wala Katha - Sinhala Wal Katha & Wela Katha"
  description="Wala Katha: 2026 අලුත් සිංහල වල් කතා, වැල කතා, Aluth Sinhala wala katha stories එකතුව දිනපතා කියවන්න. Best daily updated Sinhala wela katha collection."
  canonical={canonicalUrl}
  image={siteLogo}
>
  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />

  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha & Wela Katha Stories" />
    <meta property="og:description" content="Wala Katha: නවතම සිංහල වල් කතා, වැල කතා සහ රසවත් සිංහල wal katha stories එකතුවක් දිනපතා කියවන්න." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={siteLogo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha" />
    <meta name="twitter:description" content="Daily updated Sinhala wal katha and wela stories collection." />
    <meta name="twitter:image" content={siteLogo} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  </Fragment>

  <!--
    🎯 FIXED (CRITICAL — Rich Results Test "No items detected"):
    මෙය කලින් <main class="section pt-4 pb-12..."> ලෙස ආරම්භ වී, Base.astro
    layout එකේ දැනටමත් තිබූ <main id="main-content">...<slot /></main>
    ඇතුළත NESTED <main> tag එකක් ලෙස render විය (main > main). HTML spec
    එකට අනුව document එකකට <main> landmark එකක් පමණක් තිබිය යුතු අතර,
    මෙම duplicate/nested <main> එක Google Rich Results Test / Search
    Console හි parser එකට document structure එක malformed ලෙස පෙනී,
    homepage එකේ valid JSON-LD schema තිබුණත් "No items detected" ලෙස
    වාර්තා වීමට හේතු විය. Inner <main> එක සෙමැන්ටික් වශයෙන් නිවැරදි
    <div> එකකට මාරු කර ඇත — CSS classes සියල්ල එලෙසම රඳවා ඇති නිසා
    visual design එකට කිසිදු බලපෑමක් නැත.
  -->
  <div class="section pt-4 pb-12 min-h-screen bg-[#050505] text-slate-200 antialiased">
    <div class="container">

      {/* ✅ FIX: real H1 — FeaturedSlider එකට උඩින්ම, DOM order එකේ පළමුවෙන්.
          දිස්වන Design එකට කිසිම බලපෑමක් නැත (height:0, collapsed). */}
      <div class="seo-h1-wrap">
        <h1>Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha &amp; Wela Katha Stories</h1>
      </div>

      <FeaturedSlider />

      <Posts posts={currentPosts} className="mb-16" />
      
      <Pagination currentPage={1} totalPages={totalPages} />
      
    </div>
  </div>
</Base>
