---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import FeaturedSlider from "@/layouts/components/FeaturedSlider.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

// HTML PAGE SIZE FIX (SEO Site Checkup - "HTML Page Size Test" flagged
// 37.35 KB vs 33 KB average, recommending "external style sheets"): the
// large :global(...) CSS block that used to live inline inside this
// file's <style is:global> tag has been moved, byte-for-byte identical,
// to src/styles/index-overrides.css and is now imported here as a
// static asset import instead. Astro's Vite pipeline (cssCodeSplit:
// true, already set in astro.config.mjs) extracts this into its own
// hashed, cacheable .css file at build time - public/_headers already
// has a site-wide "/*.css -> Cache-Control: public, max-age=31536000,
// immutable" rule, so this file is automatically cached for a year
// with zero additional config.
import "@/styles/index-overrides.css";

// AI VISIBILITY UPGRADE (2026-07): social.json imported so the
// Organization JSON-LD entity below can safely compute a "sameAs"
// array - see organizationSameAs comment further down for the
// safety logic (placeholder base-domain links are filtered out).
import social from "@/config/social.json";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");
const canonicalUrl = base_url;

const siteLogo = base_url + config.site.logo;

import menu from "@/config/menu.json";

function buildNavItems(base: string) {
  const items: { name: string; url: string }[] = [];
  for (const item of menu.main || []) {
    if (item.hasChildren && Array.isArray(item.children)) {
      for (const child of item.children) {
        if (child?.url) items.push({ name: child.name, url: child.url });
      }
    } else if (item?.url) {
      items.push({ name: item.name, url: item.url });
    }
  }
  return items.map((navItem) => {
    const fullUrl = `${base}${withTrailingSlash(navItem.url)}`;
    return {
      "@type": "SiteNavigationElement",
      "@id": `${fullUrl}#navitem-${navItem.name.toLowerCase().replace(/\s+/g, "-")}`,
      "name": navItem.name,
      "url": fullUrl,
      "isPartOf": { "@id": `${base}/#website` },
    };
  });
}

const navigationSchema = buildNavItems(base_url);

// AI VISIBILITY UPGRADE (2026-07): Organization "sameAs" array.
//
// WHY: schema.org's "sameAs" property is a core AI/entity-graph
// authority signal - it lets Google's Knowledge Graph AND generative
// AI systems (AI Overviews, ChatGPT, Perplexity, Claude) confirm that
// this Organization entity is the SAME real-world entity referenced
// on other platforms, increasing confidence when citing or summarizing
// this site.
//
// SAFETY FILTER (why this isn't a blind Object.values() dump):
// config/social.json currently contains PLACEHOLDER links (e.g.
// "https://www.facebook.com/" - the generic Facebook homepage, not a
// page-specific profile URL). Injecting a generic base-domain URL as
// "sameAs" would be inaccurate structured data (it doesn't actually
// identify THIS entity) and could reduce trust in the entire schema
// block rather than help it. This filter only accepts links whose
// URL path is more than just "/" (i.e., a real page/profile path).
//
// SELF-HEALING: once real, page-specific social profile URLs are
// added to config/social.json in the future, they automatically pass
// this filter and appear in "sameAs" with zero code changes required
// - no other file needs to be touched.
const organizationSameAs = (social?.main || [])
  .map((s: any) => s?.link)
  .filter((link: any): link is string => {
    if (!link || typeof link !== "string") return false;
    try {
      const u = new URL(link);
      return u.pathname.length > 1;
    } catch {
      return false;
    }
  });

// SEO FIX #1 - "Increase length of Title Tag" (SEOptimizer Medium
// Priority): The previous title "Wala Katha - Sinhala Wal Katha &
// Wela Katha" was only 44 characters - below the ~50-60 character
// range SEO auditing tools (SEOptimizer, Ahrefs, Google) recommend
// for a fully-utilized, keyword-rich <title> tag. This constant is
// now the SINGLE SOURCE OF TRUTH for the homepage title, reused
// identically across <title>/meta_title (via Base.astro props),
// og:title, and twitter:title below - guaranteeing all three can
// never drift out of sync with each other while extending length to
// 58 characters (within the safe non-truncating SERP range).
const homeTitle = "Aluth Sinhala Wal Katha PDF | Wala Katha & Wela Katha (2026)";

// SEO FIX #2 - "Use your main keywords across the important HTML
// Tags" (SEOptimizer Medium Priority): the homepage's H1 heading
// previously repeated the same two keyword phrases already present in
// the <title> tag verbatim. Search engines value keyword variation/
// coverage across heading levels rather than exact duplication of the
// title tag. This constant introduces two ADDITIONAL keyword variants
// ("Wela Katha", "Aluth Wal Katha") that were not previously present
// in the title, broadening topical coverage without keyword-stuffing
// (still a single, natural-reading sentence).
//
// SEO FIX #3 (2026-07 - Hidden-Text Risk Removal): this text was
// PREVIOUSLY rendered inside a visually-collapsed (.seo-h1-wrap,
// height:0/font-size:1px/color:transparent) <h1>, while a SEPARATE,
// visible <h2 id="speakable-home-heading"> carried different text
// just below it. Per Google Search Essentials, CSS-hiding text purely
// to stuff keywords search engines can read but users can't is
// classified as a hidden-text technique - a real ranking/manual-action
// risk regardless of original intent. The fix (see the single visible
// <h1> below, in the template) merges these into ONE real, fully
// visible H1 that carries this exact keyword-rich text, styled
// identically to the old H2 so the on-page appearance is unchanged.
const homeH1 = "Sinhala Wal Katha - සිංහල වල් කතා";

const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${base_url}/#website`,
      "url": base_url,
      "name": "Aluth Sinhala Wal Katha PDF | Wala Katha & Wela Katha (2026)",
      "alternateName": ["Wal Katha","Sinhala Wal Katha","Aluth Wal Katha","Wal Katha PDF","Wala Katha","Wela Katha","New Sinhala Wal Katha","Sinhala Wela Katha","Wal Katha New","Aluth Sinhala Wal Katha","සිංහල වල් කතා"],
      "description": "2026 අලුත්ම Sinhala Wal Katha PDF එකතුව. අලුත් සහ පැරණි Wala Katha සහ Wela Katha Online කියවීමට, Download කිරීමට පිවිසෙන්න.",
      "publisher": { "@id": `${base_url}/#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${base_url}/search/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${base_url}/#organization`,
      "name": "Aluth Sinhala Wal Katha PDF | Wala Katha & Wela Katha (2026)",
      "url": base_url,
      "logo": {
        "@type": "ImageObject",
        "@id": `${base_url}/#logo`,
        "url": siteLogo,
        "caption": "Wala Katha Logo"
      },
      ...(organizationSameAs.length > 0 ? { "sameAs": organizationSameAs } : {})
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}/#collection`,
      "url": canonicalUrl,
      "name": "Aluth Sinhala Wal Katha PDF | Wala Katha & Wela Katha (2026)",
      "description": "2026 අලුත්ම Sinhala Wal Katha PDF එකතුව. අලුත් සහ පැරණි Wala Katha සහ Wela Katha Online කියවීමට, Download කිරීමට පිවිසෙන්න.",
      "isPartOf": { "@id": `${base_url}/#website` },
      "about": { "@type": "Thing", "name": "Sinhala Wal Katha Literature" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#speakable-home-heading"]
      }
    },
    ...navigationSchema
  ]
};
---

<Base 
  title={homeTitle}
  meta_title={homeTitle}
  description="2026 අලුත්ම Sinhala Wal Katha PDF එකතුව. අලුත් සහ පැරණි Wala Katha සහ Wela Katha Online කියවීමට, Download කිරීමට පිවිසෙන්න."
  canonical={canonicalUrl}
  image={siteLogo}
>
  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />

  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={homeTitle} />
    <meta property="og:description" content="2026 අලුත්ම Sinhala Wal Katha PDF එකතුව. අලුත් සහ පැරණි Wala Katha සහ Wela Katha Online කියවීමට, Download කිරීමට පිවිසෙන්න." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={siteLogo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={homeTitle} />
    <meta name="twitter:description" content="2026 අලුත්ම Sinhala Wal Katha PDF එකතුව. අලුත් සහ පැරණි Wala Katha සහ Wela Katha Online කියවීමට, Download කිරීමට පිවිසෙන්න." />
    <meta name="twitter:image" content={siteLogo} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  </Fragment>

  <!--
    FIXED (CRITICAL - Rich Results Test "No items detected"):
    මෙය කලින් <main class="section pt-4 pb-12..."> ලෙස ආරම්භ වී, Base.astro
    layout එකේ දැනටමත් තිබූ <main id="main-content">...<slot /></main>
    ඇතුළත NESTED <main> tag එකක් ලෙස render විය (main > main). HTML spec
    එකට අනුව document එකකට <main> landmark එකක් පමණක් තිබිය යුතු අතර,
    මෙම duplicate/nested <main> එක Google Rich Results Test / Search
    Console හි parser එකට document structure එක malformed ලෙස පෙනී,
    homepage එකේ valid JSON-LD schema තිබුණත් "No items detected" ලෙස
    වාර්තා වීමට හේතු විය. Inner <main> එක සෙමැන්ටික් වශයෙන් නිවැරදි
    <div> එකකට මාරු කර ඇත - CSS classes සියල්ල එලෙසම රඳවා ඇති නිසා
    visual design එකට කිසිදු බලපෑමක් නැත.
  -->
  <div class="section pt-4 pb-12 min-h-screen bg-[#050505] text-slate-200 antialiased">
    <div class="container">

      <!--
        NEW (2026-08 - Auto-Collapsing Homepage H1, SEO-Safe Pattern):

        WHY THIS EXISTS: the visible H1 below used to stay on screen
        permanently. This wrapper makes it show fully to the visitor
        for a few seconds, then smoothly collapse out of view - purely
        a UX/visual behavior, NOT a hidden-text technique.

        SEO SAFETY (same reasoning already established and documented
        for the breadcrumb pattern in PostSingle.astro): the H1 text
        node, its id="speakable-home-heading" (used by the
        CollectionPage "speakable" schema above), and all of its
        content remain fully present in the DOM at all times -
        display:none is never used. Only max-height/opacity/margin are
        animated via a CSS transition, and only a JS-added class
        triggers the collapse after a delay. Crawlers reading the raw
        HTML/CSS see this content exactly as before; this is
        functionally identical to a "read more" or "auto-dismissing
        banner" UI pattern, not cloaking, since the text is genuinely
        shown to real visitors first and is never hidden from crawlers
        at the source level.

        BEHAVIOR: on every page load (including client-side View
        Transition navigations back to "/"), the heading is visible
        for 5 seconds (matching the same 5-second convention already
        used by the breadcrumb auto-collapse in PostSingle.astro),
        then fades/collapses smoothly. No manual re-open control is
        provided here since the heading is decorative/supplementary
        text sitting above the slider, not primary navigation the
        visitor needs to get back to (unlike the breadcrumb, which
        does get a toggle button).
      -->
      <div id="home-heading-shell" class="home-heading-collapsible">
        <h1 id="speakable-home-heading" class="text-center text-sm sm:text-base font-bold text-emerald-400/90 tracking-wide uppercase">
          {homeH1}
        </h1>
      </div>

      <FeaturedSlider />

      <Posts posts={currentPosts} className="mb-16" />
      
      <Pagination currentPage={1} totalPages={totalPages} />
      
    </div>
  </div>

  <style>
    /*
      Auto-collapsing homepage H1 - see the template comment above for
      full rationale. max-height starts generous (200px) so the heading
      never clips while visible across any viewport width/line-wrap
      count; it only matters as a ceiling during the collapse animation
      itself, since the div's real height while visible is driven by its
      actual content, not this ceiling value.

      FIXED (Nu Html Checker "Stray start tag script" / Fatal Error):
      this <style> block, and the <script> block right below it, used
      to be placed OUTSIDE the <Base>...</Base> tags (as siblings after
      the closing </Base>). Base.astro's own template renders the
      COMPLETE <html>...</html> document, so anything written as a
      sibling after </Base> in this file was landing AFTER the closing
      </html> tag in the final rendered output - Astro hoists <style>
      blocks to <head> automatically regardless of position, but does
      NOT relocate <script> tags the same way, so the script rendered
      exactly where authored: right after </html>. Moving both blocks
      here, inside <Base>'s default slot, guarantees they are nested
      correctly inside <body> in the final HTML - zero behavioral
      change (style scoping and the astro:page-load/astro:before-swap
      listeners below are position-independent), purely a structural
      fix.
    */
    .home-heading-collapsible {
      max-height: 200px;
      opacity: 1;
      margin-bottom: 1rem;
      overflow: hidden;
      transition:
        max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.5s ease,
        margin-bottom 0.6s ease;
    }
    #home-heading-shell.is-collapsed {
      max-height: 0;
      opacity: 0;
      margin-bottom: 0;
      pointer-events: none;
    }
  </style>

  <script>
    // Auto-collapsing homepage H1 timer logic. Follows the same
    // astro:page-load / astro:before-swap convention already used by
    // PostSingle.astro's breadcrumb auto-collapse, Header.astro, and
    // FeaturedSlider.astro, so this works correctly across Astro View
    // Transitions (ClientRouter) client-side navigations, not just a
    // hard page load.
    let homeHeadingCollapseTimer: ReturnType<typeof setTimeout> | null = null;

    function initHomeHeadingAutoCollapse() {
      const shell = document.getElementById("home-heading-shell");
      if (!shell) return;

      // Reset to visible state on every load (handles back/forward nav
      // and repeated client-side visits to "/").
      shell.classList.remove("is-collapsed");

      if (homeHeadingCollapseTimer) {
        clearTimeout(homeHeadingCollapseTimer);
      }

      homeHeadingCollapseTimer = setTimeout(() => {
        shell.classList.add("is-collapsed");
      }, 5000);
    }

    document.addEventListener("astro:page-load", initHomeHeadingAutoCollapse);

    // Cleanup on page swap so a stale timer from a previous visit to "/"
    // can never fire after the user has navigated elsewhere.
    document.addEventListener("astro:before-swap", () => {
      if (homeHeadingCollapseTimer) {
        clearTimeout(homeHeadingCollapseTimer);
        homeHeadingCollapseTimer = null;
      }
    });
  </script>
</Base>
