---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import FeaturedSlider from "@/layouts/components/FeaturedSlider.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

// HTML PAGE SIZE FIX (SEO Site Checkup - "HTML Page Size Test" flagged
// 37.35 KB vs 33 KB average, recommending "external style sheets"): the
// large :global(...) CSS block that used to live inline inside this
// file's <style is:global> tag has been moved, byte-for-byte identical,
// to src/styles/index-overrides.css and is now imported here as a
// static asset import instead. Astro's Vite pipeline (cssCodeSplit:
// true, already set in astro.config.mjs) extracts this into its own
// hashed, cacheable .css file at build time.
import "@/styles/index-overrides.css";

// AI VISIBILITY UPGRADE (2026-07): social.json imported so the
// Organization JSON-LD entity below can safely compute a "sameAs"
// array - see organizationSameAs comment further down for the
// safety logic (placeholder base-domain links are filtered out).
import social from "@/config/social.json";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");
const canonicalUrl = base_url;

const siteLogo = base_url + config.site.logo;

import menu from "@/config/menu.json";

function buildNavItems(base: string) {
  const items: { name: string; url: string }[] = [];
  for (const item of menu.main || []) {
    if (item.hasChildren && Array.isArray(item.children)) {
      for (const child of item.children) {
        if (child?.url) items.push({ name: child.name, url: child.url });
      }
    } else if (item?.url) {
      items.push({ name: item.name, url: item.url });
    }
  }
  return items.map((navItem) => {
    const fullUrl = `${base}${withTrailingSlash(navItem.url)}`;
    return {
      "@type": "SiteNavigationElement",
      "@id": `${fullUrl}#navitem-${navItem.name.toLowerCase().replace(/\s+/g, "-")}`,
      "name": navItem.name,
      "url": fullUrl,
      "isPartOf": { "@id": `${base}/#website` },
    };
  });
}

const navigationSchema = buildNavItems(base_url);

// AI VISIBILITY UPGRADE (2026-07): Organization "sameAs" array.
const organizationSameAs = (social?.main || [])
  .map((s: any) => s?.link)
  .filter((link: any): link is string => {
    if (!link || typeof link !== "string") return false;
    try {
      const u = new URL(link);
      return u.pathname.length > 1;
    } catch {
      return false;
    }
  });

// 2026-08 SEO ALIGNMENT PASS - homepage title/H1/description sync.
//
// ROOT CAUSE (audit finding): the previous homeTitle mixed English
// keywords ("Wal Katha - Sinhala Wal Katha & Wela Katha") while
// homeH1 was Sinhala-only ("සිංහල වල් කතා"), and meta_description
// separately claimed a "PDF එකතුව" that this codebase does not
// actually provide (no PDF download feature exists anywhere in the
// content collections or components). This created three separate,
// non-reinforcing keyword signals instead of one consistent core
// phrase cluster, and a search-snippet promise ("PDF") that the
// landing page itself never fulfills.
//
// FIX: title, H1, and description now share the SAME core raw-search
// phrase cluster already proven in production by the AI alt-text
// workflow's SINGLISH_KEYWORD_CLUSTER
// (.github/workflows/generate-alt-text.yml: "sinhala wal katha",
// "aluth wal katha", "wal katha 2026", "wal katha story",
// "wala katha collection") - these are the literal raw terms real
// visitors type, not paraphrased/AI-sounding copy. Both Sinhala
// script and Singlish (Latin script) forms are present in the H1
// since search demand for this content type is split across both
// scripts. The unfulfilled "PDF" claim has been dropped from the
// description to remove the snippet/content mismatch.
const homeTitle = "Sinhala Wal Katha - Aluth Wala Katha & Wela Katha (2026)";
const homeDescription =
  "අලුත්ම Sinhala Wal Katha, Wala Katha සහ Wela Katha කතා 2026 වර්ෂයේ මෙතැනින් නොමිලේ කියවන්න. දිනපතා අලුත් Aluth Wal Katha කතා එකතු වේ.";
const homeH1 = "Sinhala Wal Katha - සිංහල අලුත්ම වල් කතා";

const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${base_url}/#website`,
      "url": base_url,
      "name": homeTitle,
      "alternateName": ["Wal Katha","Sinhala Wal Katha","Aluth Wal Katha","Wala Katha","Wela Katha","New Sinhala Wal Katha","Sinhala Wela Katha","Wal Katha New","Aluth Sinhala Wal Katha","සිංහල වල් කතා"],
      "description": homeDescription,
      "publisher": { "@id": `${base_url}/#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${base_url}/search/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${base_url}/#organization`,
      "name": homeTitle,
      "url": base_url,
      "logo": {
        "@type": "ImageObject",
        "@id": `${base_url}/#logo`,
        "url": siteLogo,
        "caption": "Wala Katha Logo"
      },
      ...(organizationSameAs.length > 0 ? { "sameAs": organizationSameAs } : {})
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}/#collection`,
      "url": canonicalUrl,
      "name": homeTitle,
      "description": homeDescription,
      "isPartOf": { "@id": `${base_url}/#website` },
      "about": { "@type": "Thing", "name": "Sinhala Wal Katha Literature" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#speakable-home-heading"]
      }
    },
    ...navigationSchema
  ]
};
---

<Base 
  title={homeTitle}
  meta_title={homeTitle}
  description={homeDescription}
  canonical={canonicalUrl}
  image={siteLogo}
>
  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />

  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={homeTitle} />
    <meta property="og:description" content={homeDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={siteLogo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={homeTitle} />
    <meta name="twitter:description" content={homeDescription} />
    <meta name="twitter:image" content={siteLogo} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  </Fragment>

  <!--
    FIXED (CRITICAL - Rich Results Test "No items detected"):
    Inner <main> tag removed to avoid nested main > main structure
    (Base.astro layout already renders <main id="main-content">).
    Replaced with a semantically correct <div>; CSS classes retained
    byte-for-byte so visual design is unaffected.
  -->
  <div class="section pt-4 pb-12 min-h-screen bg-[#050505] text-slate-200 antialiased">
    <div class="container">

      <!--
        Auto-Collapsing Homepage H1 (SEO-safe pattern, unchanged from
        prior implementation): the H1 text node and its
        id="speakable-home-heading" (referenced by the CollectionPage
        "speakable" schema above) remain fully present in the DOM at
        all times - display:none is never used. Only max-height/
        opacity/margin animate via CSS transition after a JS-added
        class, so crawlers reading the raw HTML/CSS see this content
        exactly as a real visitor does first.
      -->
      <div id="home-heading-shell" class="home-heading-collapsible">
        <h1 id="speakable-home-heading" class="text-center text-sm sm:text-base font-bold text-emerald-400/90 tracking-wide uppercase">
          {homeH1}
        </h1>
      </div>

      <FeaturedSlider />

      <Posts posts={currentPosts} className="mb-16" />
      
      <Pagination currentPage={1} totalPages={totalPages} />
      
    </div>
  </div>

  <style>
    .home-heading-collapsible {
      max-height: 200px;
      opacity: 1;
      margin-bottom: 1rem;
      overflow: hidden;
      transition:
        max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.5s ease,
        margin-bottom 0.6s ease;
    }
    #home-heading-shell.is-collapsed {
      max-height: 0;
      opacity: 0;
      margin-bottom: 0;
      pointer-events: none;
    }
  </style>

  <script>
    let homeHeadingCollapseTimer: ReturnType<typeof setTimeout> | null = null;

    function initHomeHeadingAutoCollapse() {
      const shell = document.getElementById("home-heading-shell");
      if (!shell) return;

      shell.classList.remove("is-collapsed");

      if (homeHeadingCollapseTimer) {
        clearTimeout(homeHeadingCollapseTimer);
      }

      homeHeadingCollapseTimer = setTimeout(() => {
        shell.classList.add("is-collapsed");
      }, 5000);
    }

    document.addEventListener("astro:page-load", initHomeHeadingAutoCollapse);

    document.addEventListener("astro:before-swap", () => {
      if (homeHeadingCollapseTimer) {
        clearTimeout(homeHeadingCollapseTimer);
        homeHeadingCollapseTimer = null;
      }
    });
  </script>
</Base>
