---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import FeaturedSlider from "@/layouts/components/FeaturedSlider.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");
const canonicalUrl = base_url;
const siteLogo = `${base_url}/images/logo.png`; 

// 🚀 ADVANCED INTEGRATED SCHEMA 2026 (100% Connected Graph & Penalty-Free)
const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${base_url}/#website`,
      "url": base_url,
      "name": "Wala Katha",
      "alternateName": [
        "Wala Katha Stories",
        "Wal Katha", 
        "සිංහල වල් කතා", 
        "Sinhala Wal Katha", 
        "Wela Katha", 
        "Sinhala Wela Katha",
        "WalKatha"
      ],
      "description": "Wala Katha - අලුත්ම සහ රසවත්මසිංහල වල් කතා (Sinhala Wal Katha) සහ වැල කතා (Wela Katha) දිනපතා කියවන්න ඇති එකම නිල වෙබ් අඩවිය.",
      "publisher": {
        "@type": "Organization",
        "@id": `${base_url}/#organization`,
        "name": "Wala Katha",
        "url": base_url,
        "logo": {
          "@type": "ImageObject",
          "@id": `${base_url}/#logo`,
          "url": siteLogo,
          "caption": "Wala Katha Logo"
        }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${base_url}/search?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}/#collection`,
      "url": canonicalUrl,
      "name": "Wala Katha - සිංහල වල් කතා එකතුව | Latest Sinhala Wal Katha Stories",
      "description": "Daily updated premium Sinhala wal katha, wala katha and wela stories collection.",
      "isPartOf": { "@id": `${base_url}/#website` },
      "about": {
        "@type": "Thing",
        "name": "Sinhala Wal Katha Literature"
      }
    }
  ]
};
---

<Base 
  title="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha & Wela Katha Stories"
  meta_title="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha & Wela Katha Stories"
  description="Wala Katha: නවතම සිංහල වල් කතා, වැල කතා, අලුත්ම කෙටි කතා සහ රසවත් සිංහල wal katha stories එකතුවක් දිනපතා කියවන්න. Best daily updated Sinhala wela katha collection."
  canonical={canonicalUrl}
  image={siteLogo}
>
  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />

  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha & Wela Katha Stories" />
    <meta property="og:description" content="Wala Katha: නවතම සිංහල වල් කතා, වැල කතා සහ රසවත් සිංහල wal katha stories එකතුවක් දිනපතා කියවන්න." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={siteLogo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha" />
    <meta name="twitter:description" content="Daily updated Sinhala wal katha and wela stories collection." />
    <meta name="twitter:image" content={siteLogo} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  </Fragment>

  <style is:global>
    html, body {
      background-color: #050505 !important;
      color: #f8fafc !important; 
      scrollbar-color: #10b981 #050505; 
    }
    
    :global(.post-card), :global(.card), :global(.bg-body), :global(.bg-white) {
      background-color: #0d0d0d !important;
      border: 1px solid #1a1a1a !important;
      border-radius: 14px !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    
    :global(.post-card:hover), :global(.card:hover) {
      background-color: #121212 !important;
      border-color: rgba(16, 185, 129, 0.4) !important;
      transform: translateY(-4px) !important;
      box-shadow: 0 10px 25px -10px rgba(16, 185, 129, 0.25) !important;
    }
    
    :global(.post-card-title), :global(.post-card h2), :global(.post-card h3), :global(.post-card h3 a), :global(.post-card a) {
      color: #ffffff !important;
      font-weight: 700 !important;
      transition: color 0.2s ease !important;
    }
    
    :global(.post-card h2 a:hover), :global(.post-card h3 a:hover), :global(.post-card a:hover) {
      color: #34d399 !important;
    }
    
    :global(.post-card p), :global(.text-muted), :global(.post-meta), :global(.meta-items) {
      color: #cbd5e1 !important;
    }

    :global(.featured-slider img), :global(.post-card img) {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
      border-radius: 10px !important;
    }
    
    :global(.pagination a) {
      background-color: #0d0d0d !important;
      border: 1px solid #262626 !important;
      color: #e5e5e5 !important;
    }
    :global(.pagination a:hover), :global(.pagination .active a) {
      background-color: #10b981 !important;
      color: #050505 !important;
      border-color: #10b981 !important;
    }

    :global(.featured-slider .slider-content) {
      background: linear-gradient(to top, rgba(5,5,5,0.95) 0%, rgba(5,5,5,0.4) 70%, transparent 100%) !important;
    }
    :global(.tag), :global(.category-badge) {
      background-color: rgba(16, 185, 129, 0.1) !important;
      color: #34d399 !important;
      border: 1px solid rgba(16, 185, 129, 0.2) !important;
    }
  </style>

  <main class="section pt-4 pb-12 min-h-screen bg-[#050505] text-slate-200 antialiased">
    <div class="container">
      
      {/* 🎯 APPROVED ACCESSIBILITY PATTERN (100% Invisible to Users, 100% Tracked by Google Bot) */}
      <div class="sr-only">
        <h1>Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha & Wela Katha Stories</h1>
        <p>නවතම සිංහල වල් කතා සහ වැල කතා දිනපතා කියවන්න ඇති එකම නිල අඩවිය. Daily Updated Premium Stories</p>
      </div>

      {/* Slider එක දැන් කිසිම බාධාවක් නැතිව ඉහළින්ම පෙනේ */}
      <FeaturedSlider posts={sortedPosts} />

      {/* Posts Grid */}
      <Posts posts={currentPosts} className="mb-16" />
      
      {/* Pagination */}
      <Pagination currentPage={1} totalPages={totalPages} />
      
    </div>
  </main>
</Base>
