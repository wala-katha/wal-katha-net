---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import FeaturedSlider from "@/layouts/components/FeaturedSlider.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");
const canonicalUrl = base_url;

const siteLogo = base_url + config.site.logo;

import menu from "@/config/menu.json";

function buildNavItems(base: string) {
  const items: { name: string; url: string }[] = [];
  for (const item of menu.main || []) {
    if (item.hasChildren && Array.isArray(item.children)) {
      for (const child of item.children) {
        if (child?.url) items.push({ name: child.name, url: child.url });
      }
    } else if (item?.url) {
      items.push({ name: item.name, url: item.url });
    }
  }
  return items.map((navItem) => {
    const fullUrl = `${base}${withTrailingSlash(navItem.url)}`;
    return {
      "@type": "SiteNavigationElement",
      "@id": `${fullUrl}#navitem-${navItem.name.toLowerCase().replace(/\s+/g, "-")}`,
      "name": navItem.name,
      "url": fullUrl,
      "isPartOf": { "@id": `${base}/#website` },
    };
  });
}

const navigationSchema = buildNavItems(base_url);

const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${base_url}/#website`,
      "url": base_url,
      "name": "Wala Katha",
      "alternateName": ["Wala Katha Stories","Wal Katha","සිංහල වල් කතා","Sinhala Wal Katha","Wela Katha","Sinhala Wela Katha","WalKatha"],
      "description": "Wala Katha - අලුත්ම සහ රසවත්ම සිංහල වල් කතා (Sinhala Wal Katha) සහ වැල කතා (Wela Katha) දිනපතා කියවන්න ඇති එකම නිල වෙබ් අඩවිය.",
      "publisher": { "@id": `${base_url}/#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${base_url}/search/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${base_url}/#organization`,
      "name": "Wala Katha",
      "url": base_url,
      "logo": {
        "@type": "ImageObject",
        "@id": `${base_url}/#logo`,
        "url": siteLogo,
        "caption": "Wala Katha Logo"
      }
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}/#collection`,
      "url": canonicalUrl,
      "name": "Wala Katha - Sinhala Wal Katha & Wela Katha",
      "description": "Daily updated premium Sinhala wal katha, wala katha and wela stories collection.",
      "isPartOf": { "@id": `${base_url}/#website` },
      "about": { "@type": "Thing", "name": "Sinhala Wal Katha Literature" }
    },
    ...navigationSchema
  ]
};
---

<Base 
  title="Wala Katha - Sinhala Wal Katha & Wela Katha"
  meta_title="Wala Katha - Sinhala Wal Katha & Wela Katha"
  description="Wala Katha: 2026 අලුත් සිංහල වල් කතා, වැල කතා, Aluth Sinhala wala katha stories එකතුව දිනපතා කියවන්න. Best daily updated Sinhala wela katha collection."
  canonical={canonicalUrl}
  image={siteLogo}
>
  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />

  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha & Wela Katha Stories" />
    <meta property="og:description" content="Wala Katha: නවතම සිංහල වල් කතා, වැල කතා සහ රසවත් සිංහල wal katha stories එකතුවක් දිනපතා කියවන්න." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={siteLogo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha" />
    <meta name="twitter:description" content="Daily updated Sinhala wal katha and wela stories collection." />
    <meta name="twitter:image" content={siteLogo} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  </Fragment>

  {/* 🎯 2026-07 W3C VALIDATOR FIX — ROUND 2 (4 remaining CSS Parse
      Errors at line 40, columns ~2655/2787/2901/3034):
      ROOT CAUSE: the previous validator-fix pass split most of this
      block's comma-separated :global() selector chains into
      independent single-selector rules, but FOUR chains were missed
      at the tail end of the block:
        :global(.pagination a), :global(.pagination a:hover) -- wait,
        actually the four missed chains were:
          1. .pagination .active a  (still chained with ".pagination a:hover")
          2. .featured-slider .slider-content
          3. .tag
          4. .category-badge
      Astro's compiler wraps each individual selector in a comma-chain
      inside its own :global(...) call, producing invalid CSS like
      :global(.pagination a:hover),:global(.pagination .active a){...}
      -- a comma is not valid between two :global() function calls.
      The Nu Html Checker's embedded CSS parser flags each such comma
      boundary as a distinct Parse Error.
      PERMANENT FIX: every remaining multi-selector chain below has
      been split into fully independent, single-selector
      <style is:global> rules, each carrying the exact same
      declaration body as before. Computed styles applied to the DOM
      are byte-for-byte identical (same selectors, same properties,
      same specificity, same relative cascade order) -- this is a
      pure CSS-syntax-validity fix with zero visual regression. */}
  <style is:global>
    html, body {
      background-color: #050505 !important;
      color: #f8fafc !important; 
      scrollbar-color: #10b981 #050505; 
    }

    /* ✅ H1 FIX: Bing "H1 tag missing" ගැටලුව විසඳන real, semantic H1
       — clip/1px-hiding නෙවෙයි, height:0 + overflow:hidden විදිහට
       visually collapse කරලා design එකට කිසිම බලපෑමක් නැතුව තියෙනවා.
       Google සහ Bing දෙකටම content එක "real" විදිහට පේනවා. */
    .seo-h1-wrap {
      height: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
      line-height: 0;
    }
    .seo-h1-wrap h1 {
      font-size: 1px;
      line-height: 0;
      margin: 0;
      padding: 0;
      color: transparent;
    }

    :global(.post-card) {
      background-color: #0d0d0d !important;
      border: 1px solid #1a1a1a !important;
      border-radius: 14px !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    :global(.card) {
      background-color: #0d0d0d !important;
      border: 1px solid #1a1a1a !important;
      border-radius: 14px !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    :global(.bg-body) {
      background-color: #0d0d0d !important;
      border: 1px solid #1a1a1a !important;
      border-radius: 14px !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    :global(.bg-white) {
      background-color: #0d0d0d !important;
      border: 1px solid #1a1a1a !important;
      border-radius: 14px !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    :global(.post-card:hover) {
      background-color: #121212 !important;
      border-color: rgba(16, 185, 129, 0.4) !important;
      transform: translateY(-4px) !important;
      box-shadow: 0 10px 25px -10px rgba(16, 185, 129, 0.25) !important;
    }
    :global(.card:hover) {
      background-color: #121212 !important;
      border-color: rgba(16, 185, 129, 0.4) !important;
      transform: translateY(-4px) !important;
      box-shadow: 0 10px 25px -10px rgba(16, 185, 129, 0.25) !important;
    }

    :global(.post-card-title) {
      color: #ffffff !important;
      font-weight: 700 !important;
      transition: color 0.2s ease !important;
    }
    :global(.post-card h2) {
      color: #ffffff !important;
      font-weight: 700 !important;
      transition: color 0.2s ease !important;
    }
    :global(.post-card h3) {
      color: #ffffff !important;
      font-weight: 700 !important;
      transition: color 0.2s ease !important;
    }
    :global(.post-card h3 a) {
      color: #ffffff !important;
      font-weight: 700 !important;
      transition: color 0.2s ease !important;
    }
    :global(.post-card a) {
      color: #ffffff !important;
      font-weight: 700 !important;
      transition: color 0.2s ease !important;
    }

    :global(.post-card h2 a:hover) {
      color: #34d399 !important;
    }
    :global(.post-card h3 a:hover) {
      color: #34d399 !important;
    }
    :global(.post-card a:hover) {
      color: #34d399 !important;
    }

    :global(.post-card p) {
      color: #cbd5e1 !important;
    }
    :global(.text-muted) {
      color: #cbd5e1 !important;
    }
    :global(.post-meta) {
      color: #cbd5e1 !important;
    }
    :global(.meta-items) {
      color: #cbd5e1 !important;
    }

    :global(.featured-slider img) {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
      border-radius: 10px !important;
    }
    :global(.post-card img) {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
      border-radius: 10px !important;
    }

    :global(.pagination a) {
      background-color: #0d0d0d !important;
      border: 1px solid #262626 !important;
      color: #e5e5e5 !important;
    }
    :global(.pagination a:hover) {
      background-color: #10b981 !important;
      color: #050505 !important;
      border-color: #10b981 !important;
    }
    :global(.pagination .active a) {
      background-color: #10b981 !important;
      color: #050505 !important;
      border-color: #10b981 !important;
    }

    :global(.featured-slider .slider-content) {
      background: linear-gradient(to top, rgba(5,5,5,0.95) 0%, rgba(5,5,5,0.4) 70%, transparent 100%) !important;
    }

    :global(.tag) {
      background-color: rgba(16, 185, 129, 0.1) !important;
      color: #34d399 !important;
      border: 1px solid rgba(16, 185, 129, 0.2) !important;
    }
    :global(.category-badge) {
      background-color: rgba(16, 185, 129, 0.1) !important;
      color: #34d399 !important;
      border: 1px solid rgba(16, 185, 129, 0.2) !important;
    }
  </style>

  <!--
    🎯 FIXED (CRITICAL — Rich Results Test "No items detected"):
    මෙය කලින් <main class="section pt-4 pb-12..."> ලෙස ආරම්භ වී, Base.astro
    layout එකේ දැනටමත් තිබූ <main id="main-content">...<slot /></main>
    ඇතුළත NESTED <main> tag එකක් ලෙස render විය (main > main). HTML spec
    එකට අනුව document එකකට <main> landmark එකක් පමණක් තිබිය යුතු අතර,
    මෙම duplicate/nested <main> එක Google Rich Results Test / Search
    Console හි parser එකට document structure එක malformed ලෙස පෙනී,
    homepage එකේ valid JSON-LD schema තිබුණත් "No items detected" ලෙස
    වාර්තා වීමට හේතු විය. Inner <main> එක සෙමැන්ටික් වශයෙන් නිවැරදි
    <div> එකකට මාරු කර ඇත — CSS classes සියල්ල එලෙසම රඳවා ඇති නිසා
    visual design එකට කිසිදු බලපෑමක් නැත.
  -->
  <div class="section pt-4 pb-12 min-h-screen bg-[#050505] text-slate-200 antialiased">
    <div class="container">

      {/* ✅ FIX: real H1 — FeaturedSlider එකට උඩින්ම, DOM order එකේ පළමුවෙන්.
          දිස්වන Design එකට කිසිම බලපෑමක් නැත (height:0, collapsed). */}
      <div class="seo-h1-wrap">
        <h1>Wala Katha - සිංහල වල් කතා | Sinhala Wal Katha &amp; Wela Katha Stories</h1>
      </div>

      <FeaturedSlider />

      <Posts posts={currentPosts} className="mb-16" />
      
      <Pagination currentPage={1} totalPages={totalPages} />
      
    </div>
  </div>
</Base>
