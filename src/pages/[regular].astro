---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");

  if (!pages || pages.length === 0) return [];

  const paths = pages.map((page) => ({
    params: {
      regular: page.id,
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;

if (!page || !page.data) {
  return Astro.redirect("/404");
}

const { title, meta_title, description, image, noindex } = page.data;
const { Content } = await render(page);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

const canonicalUrl = `${base_url}/${page.id}/`;

const webpageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title || "",
  "description": description || "",
  "url": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": config?.site?.title || "Wala Katha",
    "logo": {
      "@type": "ImageObject",
      "url": `${base_url}/images/logo.png`
    }
  }
};

const isCopyrightPolicyPage = page.id === "copyright-credit-policy";
const isParentalControlPage = page.id === "parental-control";

const faqPageSchema = isCopyrightPolicyPage
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "මගේ නිර්මාණයක් මගේ අවසරයකින් තොරව මෙහි පළකර ඇතිනම් මා කළ යුත්තේ කුමක්ද?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "කිසිදු කලබලයක් හෝ අපහසුතාවයක් ඇති කරගත යුතු නැත. කරුණාකර walakatha.net@gmail.com යන අපගේ නිල ඊමේල් ලිපිනයට අදාළ කතාවේ සබැඳිය (URL) සහ ඔබ එහි මුල් රචකයා බව සනාථ කළ හැකි කෙටි සාක්ෂි අප වෙත එවන්න. ඔබගේ අයිතිය තහවුරු වූ විගස අප ක්‍රියාත්මක වන්නෙමු."
          }
        },
        {
          "@type": "Question",
          "name": "කතාව මගේම කියා සනාථ කිරීමට මා විසින් ඉදිරිපත් කළ හැකි වෙනත් සාක්ෂි මොනවාද?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ඔබ එම නිර්මාණයේ මුල් අයිතිකරු බව තහවුරු කිරීමට පහත ඕනෑම සාක්ෂියක් අප වෙත ඉදිරිපත් කළ හැක: ඔබ මීට පෙර එම කතාව නිල වශයෙන් පළකළ බ්ලොග් අඩවියක හෝ Facebook සමූහයක/පිටුවක සබැඳියාවක්, ඔබ කතාව ලියූ මුල් Word/Notepad/Text ෆයිල් එකෙහි නිර්මාණය වූ දිනය සහ විස්තර පෙනෙන සේ ලබාගත් Screenshot එකක්, හෝ සමාජ මාධ්‍ය ජාලාවල ඔබ එම නමින්ම නිර්මාණ පළකරන බව පෙන්විය හැකි ඔබගේ නිල Profile එකෙහි සබැඳියාවක්."
          }
        },
        {
          "@type": "Question",
          "name": "ඔබගේ ඉල්ලීමක් ඉටු කිරීමට අප කොපමණ කාලයක් ලබා ගන්නවාද?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ඔබගේ ඊමේල් පණිවිඩය අප වෙත ලැබුණු සැනින් ක්‍රියාත්මක වන අපගේ කණ්ඩායම, ඔබගේ ඉල්ලීමේ ස්වභාවය අනුව අදාළ කතාව සයිට් එකෙන් සම්පූර්ණයෙන්ම ඉවත් කිරීම හෝ රචකයාගේ නම නිවැරදි කිරීම පැය 24ත් 48ත් අතර කාලයක් ඇතුළත අනිවාර්යයෙන්ම සිදු කරනු ලබයි."
          }
        },
        {
          "@type": "Question",
          "name": "අන්තර්ගතයන් ඉවත් කරන්නේ නැතුව මගේ නම සහ මගේ සයිට් එකේ ලින්ක් එක දාන්න පුළුවන්ද?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ඔව්, ඉතාමත් සතුටින් එය සිදු කර දිය හැක. ඔබට ඔබගේ නිර්මාණය අපගේ සයිට් එක හරහා තවත් දහස් ගණනක් පාඨකයන් වෙත ළඟා වීමට අවශ්‍ය නම්, මුල් රචකයා ලෙස ඔබගේ නම, Facebook Profile එක හෝ ඔබගේ වෙබ් අඩවි සබැඳියාව (Backlink) ඉතා කැපී පෙනෙන ලෙස ඇතුළත් කර දීමට අප කටයුතු සූදානම් කර දෙන්නෙමු."
          }
        },
        {
          "@type": "Question",
          "name": "මෙහි පළවන කතා වෙනත් වාණිජමය අරමුණු සඳහා පාවිච්චි කරනු ලබනවාද?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "නැත. අප වෙබ් අඩවියේ පළවන කිසිදු කතාවක් හෝ නවකතාවක් මුදලට විකිණීමක් හෝ වෙනත් බාහිර වාණිජමය ප්‍රකාශන (Commercial Publications) සඳහා කිසිසේත්ම පාවිච්චි කරනු නොලැබේ. මේවා තෙවන පාර්ශවයන්ගෙන් ආරක්ෂා කිරීමටද අප බැඳී සිටිමු."
          }
        }
      ]
    }
  : null;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonicalUrl}
  noindex={noindex}
  ageGateExempt={isParentalControlPage}
>
  <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />

  {faqPageSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  )}

  <section class="section">
    <div class="container">
      <h1 set:html={markdownify(title || "")} class="h2 page-heading" />
      <div class="content text-text dark:text-slate-200 prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>
  </section>
</Base>
