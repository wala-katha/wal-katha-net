---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

const metaTitle = `පිටුව සොයාගත නොහැකි විය - 404 Error | ${config?.site?.title || "Wala Katha"}`;
const metaDescription = "ඔබ සොයන පිටුව දැනට අප වෙබ් අඩවියේ නොමැත. කරුණාකර ප්‍රධාන පිටුව වෙත පිවිසෙන්න.";
---

<!--
  🎯 CRITICAL SEO BUG FIX (404 Page Indexability):
  මීට කලින් මෙතන "robots={robotsMeta}" කියලා prop එකක් Base.astro වෙත
  pass කරමින් තිබුණි. Base.astro හි Props interface එකේ "robots"
  කියලා prop එකක්ම exist වෙන්නේ නෑ — Base.astro පිළිගන්නේ "noindex"
  boolean prop එකක් විතරයි. ඒ නිසා robots={robotsMeta} silently
  ignore වී, Base.astro එකේ default logic එකෙන් (noindex undefined
  -> falsy) 404 page එකට "index,follow,max-image-preview:large..."
  කියන INDEXABLE robots meta tag එකම යවමින් තිබුණි — 404 page එකක්
  කවදාවත් Google index කරන්න ඕනේ නැති එකක්, මෙය Google Search Console
  එකේ "soft 404" හෝ thin-content indexing issue එකක් ඇති කරන්න
  පුළුවන් real bug එකක් විය.

  ✅ PERMANENT FIX: Correct prop name එකම (noindex={true}) පාවිච්චි
  කරයි — Base.astro එකේ දැනටමත් තිබූ working noindex logic එකම
  (‍`{noindex ? <meta name="robots" content="noindex,nofollow" /> : ...}`)
  දැන් 404 page එකට නිවැරදිව apply වේ. Base.astro component එකේ කිසිම
  වෙනසක් අවශ්‍ය නොවීය — මෙය caller-side (404.astro) prop-name mismatch
  bug එකක් විය.
-->
<Base 
  title={metaTitle} 
  description={metaDescription} 
  noindex={true}
>
  <section class="section bg-[#050505] text-white">
    <div class="container">
      {/* 🎯 FIXED: min-h-[65vh] දමා Footer එක මැදට ඒම වැළැක්වීම */}
      <div class="flex min-h-[65vh] items-center justify-center">
        <div class="text-center bg-[#0d0d0d] p-8 sm:p-12 rounded-2xl border border-[#1a1a1a] max-w-lg mx-auto shadow-xl">
          
          {/* 🎯 FIXED: රතු පාට වෙනුවට අපේ තීම් එකේ Emerald Green සහ Drop Shadow දැමීම */}
          <h1 class="text-5xl md:text-6xl font-black mb-4 text-emerald-400 drop-shadow-[0_0_15px_rgba(52,211,153,0.15)]">
            404
          </h1>
          
          <div class="content">
            <h2 class="text-xl md:text-2xl font-extrabold text-white mb-2">
              පිටුව සොයාගත නොහැකි විය
            </h2>
            <p class="text-slate-400 text-sm md:text-base font-medium mb-6">
              Page Not Found
            </p>
            
            {/* ⚡ SMART COUNTDOWN UI - තීම් එකට ගැළපෙන සේ සැකසීම */}
            <p class="text-xs sm:text-sm text-slate-400/80 bg-white/5 py-2 px-4 rounded-lg inline-block">
              තත්පර <span id="countdown" class="text-emerald-400 font-black text-base bg-emerald-500/10 px-2 py-0.5 rounded mx-1">10</span> කින් ඔබව ස්වයංක්‍රීයව මුල් පිටුවට රැගෙන යනු ඇත.
            </p>
          </div>
          
          {/* 🎯 FIXED: Button එක තද Emerald Green කර පට්ට ලුක් එකක් දීම */}
          <a href="/" class="inline-block bg-emerald-500 text-neutral-950 font-black text-sm px-8 py-3 rounded-full mt-8 hover:bg-emerald-400 transition-colors shadow-md">
            Back to Home (මුලට)
          </a>
          
        </div>
      </div>
    </div>
  </section>

  {/* ⚡ SMART REDIRECT SCRIPT (ASTRO TRANSITIONS COMPATIBLE) */}
  <script is:inline>
    function start404Countdown() {
      let secondsLeft = 10;
      const countdownElement = document.getElementById('countdown');
      if (!countdownElement) return;

      const interval = setInterval(() => {
        secondsLeft--;
        if (countdownElement) {
          countdownElement.textContent = secondsLeft;
        }

        if (secondsLeft <= 0) {
          clearInterval(interval);
          window.location.href = '/';
        }
      }, 1000);

      // පිටුවෙන් ඉවත් වෙද්දී Interval එක ක්ලියර් කිරීම (Memory Leak වැළැක්වීමට)
      document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
    }

    // සාමාන්‍ය ලෝඩ් එකට සහ Astro View Transitions දෙකටම වැඩ කරන සේ
    document.addEventListener('astro:page-load', start404Countdown);
    // View Transitions නැත්නම් ඩිරෙක්ට් රන් වීම සඳහා
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      start404Countdown();
    } else {
      document.addEventListener('DOMContentLoaded', start404Countdown);
    }
  </script>
</Base>
