---
import SearchBar from "@/layouts/helpers/SearchBar";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { BiSearchAlt } from "react-icons/bi";

// Retrieve all articles
const posts = await getSinglePage("posts");

// List of items to search in
const searchList = posts.map((item) => ({
  slug: item.id,
  data: item.data,
  content: item.body,
}));

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

// Cloudflare Pages serves directory-style URLs with a trailing slash, and
// this canonicalUrl is also embedded directly in the JSON-LD below, so the
// slash is added here to keep canonical and structured data in sync with
// zero redirects.
const canonicalUrl = `${base_url}/search/`;

// OG IMAGE FIX. This page previously used /images/logo.png for og:image.
// That file is 198 KB and, despite the .png extension, its bytes are JPEG
// (SOI marker 0xFFD8), so Base.astro's extension-based MIME detection
// declared image/png for JPEG data. On top of that, Base hardcodes
// og:image:width=1200/height=630 while the logo is 300x50. Using the
// purpose-built 1200x630 og-image.webp from config fixes the wrong MIME
// type, the false dimensions and the oversized payload in one change.
const ogImage = config.metadata.meta_image;
const siteLogo = `${base_url}${config.site.logo}`;
const siteTitle = config?.site?.title || "WalaKatha";

// Meta description held to the 120-155 character sweet spot while keeping
// every core keyword (Wala Katha, සිංහල වල් කතා, වැල කතා).
const pageDescription = "ඔබට අවශ්‍ය ඕනෑම සිංහල වල් කතාවක්, වැල කතාවක් නම භාවිත කරමින් ක්ෂණිකව සොයා ගන්න. Wala Katha හි සියලුම කතා එකම තැනකින් සොයාගන්න.";
const pageTitle = `වල් කතා සෙවීම | Search Sinhala Wal Katha & Wela Stories - ${siteTitle}`;

// The WebSite entity has exactly one authoritative full definition, on
// index.astro. Every other page references it by @id through isPartOf, so
// no duplicate WebSite object is declared here.
const searchPageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SearchResultsPage",
      "@id": `${canonicalUrl}#searchpage`,
      "url": canonicalUrl,
      "name": `වල් කතා සෙවීම | Search Sinhala Wal Katha - ${siteTitle}`,
      "description": pageDescription,
      "inLanguage": "si",
      "isPartOf": { "@id": `${base_url}/#website` },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "වල් කතා මුල් පිටුව",
            "item": `${base_url}/`
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "වල් කතා සෙවීම",
            "item": canonicalUrl
          }
        ]
      }
    }
  ]
};
---

{/* noindex: Google's own guidance is to keep internal search result pages
    out of the index - they are thin, infinitely variable and duplicate the
    listing pages, which drags on site-wide quality signals. Passing the
    prop lets Base.astro emit the single authoritative robots tag, instead
    of this file emitting a second, conflicting one. The page still renders
    and still works for visitors; only indexing changes. */}
<Base
  title={pageTitle}
  meta_title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  image={ogImage}
  noindex={true}
>

  {/* ── JSON-LD ── */}
  <script type="application/ld+json" set:html={JSON.stringify(searchPageSchema)} />

  {/* ── HEAD SLOT ──
       DUPLICATE META REMOVED: robots, og:type, og:locale, og:site_name,
       og:image:width, og:image:height and twitter:card are all emitted by
       Base.astro already for non-article pages, so re-declaring them here
       shipped two of each. The robots pair was the dangerous one, because
       this page now needs a single unambiguous noindex directive. Only
       og:image:alt / twitter:image:alt remain, since Base emits neither. */}
  <Fragment slot="head">
    <meta property="og:image:alt" content={`${siteTitle} Search`} />
    <meta name="twitter:image:alt" content={`${siteTitle} Search`} />
  </Fragment>

  {/* ── STYLES ── */}
  <style is:global>
    .search-hero-container {
      background: linear-gradient(135deg, #0d0d0d 0%, #080808 100%);
      border: 1px solid #1a1a1a;
      border-radius: 20px;
      padding: 2.5rem 2rem;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
      position: relative;
      overflow: hidden;
      margin-bottom: 2.5rem;
    }

    .search-hero-container::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(1, 173, 159, 0.05) 0%, transparent 70%);
      pointer-events: none;
    }

    .seo-visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Search results card grid overrides, scoped so the project's own CSS
       files stay untouched. */
    .search-hero-container + div, 
    main .container > div:last-child,
    [class*="search-result"], 
    .search-results-grid {
      display: grid !important;
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
      gap: 1.5rem !important;
    }
    @media (min-width: 768px) {
      .search-hero-container + div, main .container > div:last-child {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      }
    }

    /* Keep thumbnails uncropped inside the card frame. */
    main img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      background-color: #111111 !important;
      border-radius: 12px !important;
      transition: all 0.3s ease !important;
    }

    /* Anchor/div container around each thumbnail. */
    main .container a:has(img) {
      display: block !important;
      aspect-ratio: 16 / 10 !important;
      background-color: #111111 !important;
      overflow: hidden !important;
      border-radius: 12px !important;
      border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    main .container a:has(img):hover img {
      transform: scale(1.02) !important;
    }
  </style>

  {/* ── MAIN ── */}
  <main class="section pt-6 pb-12 min-h-screen bg-[#050505] antialiased">
    <div class="container max-w-4xl">

      {/* SEO H1 — bots only */}
      <div class="seo-visually-hidden">
        <h1>සිංහල වල් කතා සෙවුම් | Search Sinhala Wal Katha Stories</h1>
        <p>Wal Katha වේබ් අඩවියේ ඇති සියලුම වල් කතා සහ කෙටි කතා මෙතැනින් සොයා ගන්න.</p>
      </div>

      {/* HERO SEARCH BOX */}
      <div class="search-hero-container text-center">
        <div class="flex justify-center items-center mb-3 text-emerald-400">
          <BiSearchAlt className="h-8 w-8 mr-2 animate-pulse" />
          <span class="text-xs md:text-sm font-bold tracking-widest uppercase text-emerald-400/80">
            WalaKatha Instant Finder
          </span>
        </div>

        <h2 class="text-xl md:text-2xl font-black text-white mb-2">
          ඔබට අවශ්‍ය ඕනෑම වල් කතාවක් මෙතැනින් සොයන්න
        </h2>
        <p class="text-xs md:text-sm text-slate-400 mb-6 max-w-lg mx-auto">
          කතාවේ නම, ලේඛකයා හෝ ඔබට මතක ඕනෑම වචනයක් පහත පෙට්ටියේ Type කරන්න.
        </p>

        {/* SearchBar — client:load with state preservation */}
        <div class="text-left relative">
          <SearchBar client:load searchList={searchList} transition:persist="search-bar" />
        </div>
      </div>

    </div>
  </main>
</Base>
