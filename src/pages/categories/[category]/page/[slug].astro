---
import Posts from "@/components/Posts.astro";
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import Pagination from "@/layouts/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize } from "@/lib/utils/textConverter";

// 🎯 2026 CATEGORY PAGINATION (Page 2+): categories/[category].astro
// handles page 1 for every category (/categories/{category}/); this
// file generates every subsequent page
// (/categories/{category}/page/2/, /page/3/, etc.) as fully static
// routes at build time. Same nested-dynamic-route pattern as
// authors/page/[slug].astro, scoped per-category via getStaticPaths()
// looping over every category AND every page number > 1 it needs.
export async function getStaticPaths() {
  const categories = await getTaxonomy("posts", "categories");
  if (!categories || categories.length === 0) return [];

  const posts = await getSinglePage("posts");
  const paginationLimit = config?.settings?.pagination || 6;

  const paths: { params: { category: string; slug: string } }[] = [];

  for (const category of categories) {
    const filterByCategory = taxonomyFilter(posts || [], "categories", category);
    const totalPages = Math.ceil((filterByCategory?.length || 0) / paginationLimit);

    // Page 1 already exists at /categories/{category}/ (handled by the
    // sibling [category].astro file) — this file only ever generates
    // page 2 and beyond, so the loop starts at i = 2.
    if (totalPages >= 2) {
      for (let i = 2; i <= totalPages; i++) {
        paths.push({
          params: { category, slug: i.toString() },
        });
      }
    }
  }

  return paths;
}

const { category, slug } = Astro.params;

const posts = await getSinglePage("posts");
const filterByCategory = taxonomyFilter(posts || [], "categories", category);
const sortedPosts = sortByDate(filterByCategory);

const paginationLimit = config?.settings?.pagination || 6;
const totalPages = Math.ceil((sortedPosts?.length || 0) / paginationLimit);

let currentPage = slug ? Number(slug) : 2;
if (isNaN(currentPage) || currentPage < 2) {
  currentPage = 2;
}
if (currentPage > totalPages && totalPages > 0) {
  currentPage = totalPages;
}

const indexOfLastPost = currentPage * paginationLimit;
const indexOfFirstPost = indexOfLastPost - paginationLimit;
const currentPosts = sortedPosts && sortedPosts.length > 0 ? sortedPosts.slice(indexOfFirstPost, indexOfLastPost) : [];

const title = humanize(category || "");

// 📈 SEO — page-number-aware title/description (Ahrefs 110+ char rule
// followed, same convention as categories/[category].astro page 1)
const metaTitle = `${title} - ප්‍රවර්ගය (පිටුව ${currentPage}) | ${config?.site?.title || "Wala Katha"}`;
const postCount = sortedPosts?.length || 0;
const metaDescription = `${title} ප්‍රවර්ගය යටතේ ඇති සියලුම බ්ලොග් ලිපි, නවතම සිංහල වල් කතා සහ වැල කතා${postCount > 0 ? ` (ලිපි ${postCount}ක්)` : ""} වල ${currentPage} වන පිටුව මෙතැනින් නොමිලේ කියවා ගන්න.`;

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");
const categoryBaseUrl = `${base_url}/categories/${category}/`;
const categoriesIndexUrl = `${base_url}/categories/`;
const canonicalUrl = `${categoryBaseUrl}page/${currentPage}/`;

// ⚡ GOOGLE BOT PAGINATION HINTS — prev always points back (page 2 ->
// category root, page 3+ -> previous numbered page); next only when
// another page exists beyond the current one.
const prevUrl = currentPage === 2 ? categoryBaseUrl : `${categoryBaseUrl}page/${currentPage - 1}/`;
const nextUrl = currentPage < totalPages ? `${categoryBaseUrl}page/${currentPage + 1}/` : null;

// 🚀 BREADCRUMB SCHEMA — includes a 4th "Page N" item so the schema
// accurately reflects this being a sub-page, not the category root.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": base_url },
    { "@type": "ListItem", "position": 2, "name": "Categories", "item": categoriesIndexUrl },
    { "@type": "ListItem", "position": 3, "name": title, "item": categoryBaseUrl },
    { "@type": "ListItem", "position": 4, "name": `Page ${currentPage}`, "item": canonicalUrl }
  ]
};

// 🎯 ItemList Schema — same pattern as page 1, scoped to currentPosts only
const itemListSchema = currentPosts.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${title} - Wala Katha (Page ${currentPage})`,
  "numberOfItems": currentPosts.length,
  "itemListElement": currentPosts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `${base_url}/blog/${post.id}/`,
    "name": post.data.title
  }))
} : null;
---

<Base
  title={metaTitle}
  meta_title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {itemListSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  )}

  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
  </Fragment>

  <section class="section">
    <div class="container text-center">

      <div class="mb-12">
        <p class="text-text uppercase font-semibold tracking-wider text-sm mb-2">Category</p>
        <h1 class="page-heading h2">{title}</h1>
      </div>

      {currentPosts && currentPosts.length > 0 ? (
        <Posts posts={currentPosts} />
      ) : (
        <div class="py-12 text-center opacity-60">
          <p>මෙම ප්‍රවර්ගය යටතේ ලිපි කිසිවෙකු හමුනොවීය.</p>
        </div>
      )}

      {totalPages > 1 && (
        <div class="mt-12">
          <Pagination
            section={`categories/${category}`}
            currentPage={currentPage}
            totalPages={totalPages}
          />
        </div>
      )}

    </div>
  </section>
</Base>
