---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

export async function getStaticPaths() {
  const posts = await getSinglePage("posts");
  const safePosts = Array.isArray(posts) ? posts : [];
  const paginationLimit = config?.settings?.pagination || 8;
  const totalPages = Math.ceil(safePosts.length / paginationLimit);
  const paths = [];

  // <= so the final page is generated too.
  for (let i = 1; i <= totalPages; i++) {
    paths.push({
      params: {
        slug: i.toString(),
      },
    });
  }
  return paths;
}

const { slug } = Astro.params;
const posts = await getSinglePage("posts");
const safePosts = Array.isArray(posts) ? posts : [];
const sortedPosts = sortByDate(safePosts);

const paginationLimit = config?.settings?.pagination || 8;
const totalPages = Math.ceil(safePosts.length / paginationLimit);

let currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
if (currentPage < 1) currentPage = 1;
if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

const indexOfLastPost = currentPage * paginationLimit;
const indexOfFirstPost = indexOfLastPost - paginationLimit;
const currentPosts = sortedPosts && sortedPosts.length > 0 ? sortedPosts.slice(indexOfFirstPost, indexOfLastPost) : [];

// Single-line strings: a trailing newline inside the template leaked
// into <title> and <meta description> in the built HTML.
const metaTitle = `සිංහල වල් කතා එකතුව - Wala Katha Stories (පිටුව ${currentPage})`;
const metaDescription = `Wala Katha: නවතම සිංහල වල් කතා සහ වැල කතා එකතුවේ ${currentPage} වන පිටුව. දිනපතා අලුත් වන රසවත් walkatha කියවන්න.`;

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

// /page/1 duplicates the homepage, so it self-canonicalises to "/".
const isFirstPage = currentPage === 1;
const canonicalUrl = isFirstPage ? `${base_url}/` : `${base_url}/page/${currentPage}/`;

// Trailing slashes required: this site is trailingSlash "always", and a
// slashless rel=prev/next forces Googlebot through a 301 on every hop.
const prevUrl =
  currentPage === 2
    ? `${base_url}/`
    : currentPage > 2
      ? `${base_url}/page/${currentPage - 1}/`
      : null;
const nextUrl = currentPage < totalPages ? `${base_url}/page/${currentPage + 1}/` : null;
---

<Base
  title={metaTitle}
  meta_title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
>
  {/* robots is emitted once by Base.astro for every page - a second one
      here produced conflicting directives (the weaker copy dropped
      max-snippet:-1 and truncated SERP snippets). Only rel=prev/next
      belong in this slot. */}
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <section class="section pt-4 pb-12">
    <div class="container">
      {currentPosts && currentPosts.length > 0 ? (
        <Posts className="mb-16" posts={currentPosts} />
      ) : (
        <div class="py-12 text-center opacity-60">
          <p>ලිපි කිසිවෙකු හමුනොවීය.</p>
        </div>
      )}

      {totalPages > 1 && (
        <Pagination totalPages={totalPages} currentPage={currentPage} />
      )}
    </div>
  </section>
</Base>
