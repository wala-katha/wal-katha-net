---
import Authors from "@/components/Authors.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

export async function getStaticPaths() {
  const authors = await getSinglePage("authors");
  const paginationLimit = config?.settings?.pagination || 8;
  const totalPages = Math.ceil((authors?.length || 0) / paginationLimit);
  
  const paths = [];

  // 🎯 FIXED: බොරු Fallback පිටු හදන්නේ නැතිව සැබෑ පිටු පමණක් ජෙනරේට් කිරීම
  if (totalPages >= 2) {
    for (let i = 2; i <= totalPages; i++) {
      paths.push({
        params: { slug: i.toString() },
      });
    }
  }
  return paths;
}

const { slug } = Astro.params;
const authors = await getSinglePage("authors");
const sortedPosts = sortByDate(authors || []);

const paginationLimit = config?.settings?.pagination || 8;
const totalPages = Math.ceil((authors?.length || 0) / paginationLimit);

let currentPage = slug ? Number(slug) : 2;
if (isNaN(currentPage) || currentPage < 2) {
  currentPage = 2;
}
if (currentPage > totalPages && totalPages > 0) {
  currentPage = totalPages;
}

const indexOfLastPost = currentPage * paginationLimit;
const indexOfFirstPost = indexOfLastPost - paginationLimit;
const currentPosts = sortedPosts && sortedPosts.length > 0 ? sortedPosts.slice(indexOfFirstPost, indexOfLastPost) : [];

// 📈 SEO OPTIMIZATION FOR AUTHORS PAGINATION
const metaTitle = `අපේ ලේඛකයින් - Our Authors (පිටුව ${currentPage})`;
const metaDescription = `Wala Katha වෙබ් අඩවියේ ලිපි සහ කතා ලියන දක්ෂ කතෘවරුන්ගේ ලැයිස්තුවේ ${currentPage} වන පිටුව.`;

const base_url = (config?.site?.base_url || "").replace(/\/$/, ""); 
const canonicalUrl = `${base_url}/authors/page/${currentPage}`;

const prevUrl = currentPage === 2 ? `${base_url}/authors` : `${base_url}/authors/page/${currentPage - 1}`;
const nextUrl = currentPage < totalPages ? `${base_url}/authors/page/${currentPage + 1}` : null;
---

<Base 
  title={metaTitle} 
  meta_title={metaTitle}
  description={metaDescription} 
  canonical={canonicalUrl}
>
  {/* ⚡ GOOGLE BOT DIRECT CONNECTION */}
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
  </Fragment>

  {/* ⚡ 100% MATCHED ULTRA-DARK EMERALD UI THEME */}
  <section class="section bg-[#050505] py-12 min-h-screen text-slate-200 selection:bg-emerald-500/30 selection:text-emerald-400">
    <div class="container mx-auto px-4">
      
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-center mb-12 text-white">
        Our <span class="text-emerald-400 drop-shadow-[0_2px_8px_rgba(16,185,129,0.3)]">Authors</span>
      </h1>
      
      <div class="mb-12">
        {currentPosts && currentPosts.length > 0 ? (
          <Authors authors={currentPosts} />
        ) : (
          <div class="text-center py-12 bg-[#0d0d0d] border border-[#1a1a1a] rounded-2xl max-w-md mx-auto">
            <p class="text-slate-400 font-medium">කතෘවරුන් කිසිවෙකු හමුනොවීය.</p>
          </div>
        )}
      </div>
      
      {totalPages > 1 && (
        <div class="flex justify-center mt-12 bg-[#0d0d0d] py-4 rounded-xl border border-[#1a1a1a] max-w-md mx-auto">
          <Pagination
            section={"authors"}
            currentPage={currentPage}
            totalPages={totalPages}
          />
        </div>
      )}
      
    </div>
  </section>
</Base>
