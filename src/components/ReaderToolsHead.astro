---
// ReaderToolsHead.astro
// layout එකේ <head> ඇතුළත, අන්තිම tag එක විදිහට තියන්න.
// paint වීමට කලින් localStorage එකෙන් theme + typography apply කරනවා.
---

<script is:inline>
  (function () {
    try {
      var p = JSON.parse(localStorage.getItem('wk:reader:v1') || '{}');
      var r = document.documentElement;
      r.setAttribute('data-theme', p.theme || 'dark');
      r.setAttribute('data-rt-font', p.font || 'sans');
      r.setAttribute('data-rt-measure', p.measure || 'normal');
      r.setAttribute('data-rt-focus', p.focus ? 'on' : 'off');
      if (p.fontScale)  r.style.setProperty('--rt-font-scale', p.fontScale);
      if (p.lineHeight) r.style.setProperty('--rt-line-height', p.lineHeight);
      if (p.letter != null) r.style.setProperty('--rt-letter', p.letter + 'em');
      r.style.colorScheme = (p.theme === 'light') ? 'light' : 'dark';
    } catch (e) {}
  })();
</script>
