  /* AUTO-COLLAPSING BREADCRUMB - SEO-SAFE STYLES
     max-height + opacity transition එකක් පමණි - display:none කිසිවිටෙකත්
     යොදා නැත, එබැවින් content එක DOM/accessibility tree එකෙන් කිසිවිටෙකත්
     ඉවත් නොවේ (Googlebot/crawlers සම්පූර්ණ breadcrumb එකම දකී). */
  .breadcrumb-collapsible-content {
    max-height: 60px;
    opacity: 1;
    transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.35s ease,
                margin 0.45s ease;
  }
  #breadcrumb-shell.is-collapsed .breadcrumb-collapsible-content {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    margin: 0;
  }
  #breadcrumb-shell.is-collapsed #breadcrumb-toggle {
    display: inline-flex;
  }
  #breadcrumb-shell.is-collapsed #breadcrumb-arrow {
    transform: rotate(-90deg);
  }

  /* Collapsed-state toggle button - subtle pulse-glow animation
     to make it more noticeable/discoverable once breadcrumb auto-hides.
     Animation is gentle (opacity/shadow only, no layout-affecting
     transform), so it cannot cause any CLS or layout shift. */
  .breadcrumb-toggle-pulse {
    animation: breadcrumbTogglePulse 2.4s ease-in-out infinite;
  }
  @keyframes breadcrumbTogglePulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(1, 173, 159, 0.25);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(1, 173, 159, 0);
    }
  }

  /* 2026 POST-META CARD - shared "chip" language used by every item
