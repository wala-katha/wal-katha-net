---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/layouts/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { withTrailingSlash } from "@/lib/utils/urlHelper";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt, BiTime, BiChevronRight, BiHomeAlt2, BiMapPin } from "react-icons/bi";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags, updated } = post.data;

let smartSimilarPosts = posts.filter(
  (p) => p.id !== post.id && p.data.categories?.some((cat) => categories?.includes(cat))
);
if (!smartSimilarPosts.length) {
  smartSimilarPosts = posts.filter((p) => p.id !== post.id);
}
const finalSimilarPosts = smartSimilarPosts.slice(0, 6);

const WORKER_API = "https://comments.wala-katha.workers.dev/api/comments";
const LIKES_API = "https://comments.wala-katha.workers.dev/api/likes";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const postUrl = withTrailingSlash(`${siteUrl}/blog/${post.id}`);
const authorName = allAuthors.find((a) =>
  authors.map((au: string) => slugify(au)).includes(slugify(a.data.title))
)?.data.title ?? "Wala Katha";

const hasUpdatedDate = updated && date && new Date(updated).getTime() !== new Date(date).getTime();

function detectImageMimeType(url: string): string {
  const ext = url.split(".").pop()?.toLowerCase().split("?")[0] ?? "";
  switch (ext) {
    case "webp":
      return "image/webp";
    case "png":
      return "image/png";
    case "jpg":
    case "jpeg":
      return "image/jpeg";
    case "gif":
      return "image/gif";
    case "svg":
      return "image/svg+xml";
    default:
      return "image/webp";
  }
}
const postImageMimeType = image ? detectImageMimeType(`${siteUrl}${image}`) : undefined;

const breadcrumbItems = [
  { name: "\u0db8\u0dd6\u0dbd\u0dca \u0db4\u0dd2\u0da7\u0dd4\u0dc0", item: siteUrl },
  {
    name: categories?.[0] ? humanize(categories[0]) : "Posts",
    item: `${siteUrl}/categories/${slugify(categories?.[0] ?? "posts")}`,
  },
  { name: title, item: postUrl },
];

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": b.item,
  })),
});
---

<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description ?? title} />
<meta property="og:url" content={postUrl} />
{image && <meta property="og:image" content={`${siteUrl}${image}`} />}
{image && <meta property="og:image:alt" content={title} />}
{image && <meta property="og:image:width" content="1200" />}
{image && <meta property="og:image:height" content="630" />}
{image && postImageMimeType && <meta property="og:image:type" content={postImageMimeType} />}
<meta property="og:locale" content="si_LK" />
<meta property="og:site_name" content="Wala Katha" />
{date && <meta property="article:published_time" content={new Date(date).toISOString()} />}
{date && <meta property="article:modified_time" content={hasUpdatedDate ? new Date(updated).toISOString() : new Date(date).toISOString()} />}
<meta property="article:author" content={authorName} />
{categories?.map((c: string) => <meta property="article:section" content={humanize(c)} />)}
{tags?.map((t: string) => <meta property="article:tag" content={humanize(t)} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description ?? title} />
{image && <meta name="twitter:image" content={`${siteUrl}${image}`} />}
{image && <meta name="twitter:image:alt" content={title} />}
<meta name="twitter:site" content="@WalaKatha" />

<meta name="keywords" content={tags?.join(", ") ?? ""} />
<meta name="author" content={authorName} />
<meta name="language" content="Sinhala" />
<meta name="revisit-after" content="3 days" />

<script type="application/ld+json" set:html={breadcrumbSchema} />

<section class="section !pt-6 sm:!pt-8 bg-[#010203] relative">
  <div class="container">

    <div id="breadcrumb-wrapper" class="row justify-center mt-0 mb-3">
      <div class="md:col-10 flex justify-center sm:justify-start">
        <div id="breadcrumb-shell" class="relative min-h-[42px] flex items-center">

          <button
            id="breadcrumb-toggle"
            type="button"
            aria-label="\u0db4\u0dcf\u0dbb \u0db6\u0dc0\u0dcf\u0dad/\u0dc3\u0d9c\u0dc0\u0db1\u0dca\u0db1"
            aria-expanded="true"
            aria-controls="breadcrumb-content"
            class="hidden items-center gap-2 bg-white/[0.05] hover:bg-white/[0.1] border border-[#01AD9F]/30 hover:border-[#01AD9F]/60 text-[#01AD9F] hover:text-[#01c4b4] text-[13px] sm:text-sm font-bold px-4 py-2.5 rounded-full transition-colors duration-200 breadcrumb-toggle-pulse"
          >
            <BiMapPin className="h-4 w-4 flex-shrink-0 text-[#01AD9F]" aria-hidden="true" />
            <span>Path</span>
            <svg id="breadcrumb-arrow" class="h-3.5 w-3.5 text-[#01AD9F] transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <nav
            id="breadcrumb-content"
            aria-label="Breadcrumb"
            class="breadcrumb-collapsible-content overflow-hidden"
          >
            <ol class="list-none flex flex-wrap items-center gap-x-2 gap-y-1 m-0 p-0 text-[13px] sm:text-sm text-[#F8F8FF]/50 font-medium bg-white/[0.03] border border-white/[0.06] rounded-full px-4 py-2.5 w-fit max-w-full">
              {breadcrumbItems.map((crumb, i) => {
                const isLast = i === breadcrumbItems.length - 1;
                return (
                  <li class="list-none flex items-center gap-2 min-w-0 m-0 p-0">
                    {i > 0 && (
                      <BiChevronRight className="h-3.5 w-3.5 text-[#F8F8FF]/25 flex-shrink-0" aria-hidden="true" />
                    )}
                    {isLast ? (
                      <span
                        class="text-[#01AD9F] font-bold truncate max-w-[140px] sm:max-w-[280px]"
                        aria-current="page"
                      >
                        {crumb.name}
                      </span>
                    ) : (
                      <a
                        href={
                          i === 0
                            ? "/"
                            : withTrailingSlash(`/categories/${slugify(categories?.[0] ?? "posts")}`)
                        }
                        class="flex items-center gap-1.5 hover:text-emerald-400 transition-colors duration-200 truncate max-w-[100px] sm:max-w-none"
                      >
                        {i === 0 && <BiHomeAlt2 className="h-4 w-4 flex-shrink-0" aria-hidden="true" />}
                        <span class="truncate">{crumb.name}</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ol>
          </nav>

        </div>
      </div>
    </div>

    <article class="row justify-center">
      <div class="md:col-10 text-center">
        <h1 id="speakable-headline" set:html={markdownify(title)} class="h2 text-[#F8F8FF] font-black drop-shadow-md" />

        <p id="speakable-summary" class="speakable-summary sr-only">
          {description ?? title}
        </p>

        <div class="post-meta-card relative mt-6 inline-flex max-w-full flex-wrap items-center justify-center gap-2 rounded-2xl border border-white/[0.08] bg-white/[0.03] px-3 py-2.5 sm:px-4 sm:py-3 backdrop-blur-sm shadow-[0_10px_30px_-12px_rgba(0,0,0,0.7)] transition-colors duration-300">
          <span class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-[#01AD9F]/70 to-transparent" aria-hidden="true" />

          {allAuthors
            .filter((author) =>
              authors.map((a: string) => slugify(a)).includes(slugify(author.data.title))
            )
            .map((author) => (
              <a
                href={withTrailingSlash(`/authors/${slugify(author.id)}`)}
                class="post-meta-chip post-meta-chip-author group/author"
              >
                {author.data.image && (
                  <Image
                    src={author.data.image}
                    alt={author.data.title}
                    height={50}
                    width={50}
                    class="h-6 w-6 rounded-full object-cover ring-1 ring-white/15 transition-all duration-300 group-hover/author:ring-[#01AD9F]/60"
                  />
                )}
                <span class="font-bold text-[#F8F8FF] transition-colors duration-300 group-hover/author:text-[#01AD9F]">
                  {author.data.title}
                </span>
              </a>
            ))}

          <span class="post-meta-chip">
            <BiCalendarEdit className="h-4 w-4 text-[#01AD9F]" />
            {dateFormat(date)}
          </span>

          {hasUpdatedDate && (
            <span class="post-meta-chip post-meta-chip-updated">
              <BiCalendarEdit className="h-4 w-4 text-emerald-400" />
              <span class="font-normal text-[#F8F8FF]/60">Updated</span>
              {dateFormat(updated)}
            </span>
          )}

          <span class="post-meta-chip">
            <BiTime className="h-4 w-4 text-[#01AD9F]" />
            {readingTime(post.body ?? "").toString()}
          </span>

          <span class="post-meta-chip post-meta-chip-categories">
            <BiCategoryAlt className="h-4 w-4 text-[#01AD9F] flex-shrink-0" />
            <span class="flex flex-wrap items-center gap-1.5">
              {categories.map((category: string) => (
                <a
                  href={withTrailingSlash(`/categories/${slugify(category)}`)}
                  class="rounded-full bg-white/[0.06] px-2 py-0.5 text-[12.5px] font-bold text-[#F8F8FF]/85 transition-colors duration-200 hover:bg-[#01AD9F]/15 hover:text-[#01AD9F]"
                >
                  {humanize(category)}
                </a>
              ))}
            </span>
          </span>

          <span class="hidden h-5 w-px bg-white/10 sm:block" aria-hidden="true" />

          <button
            id="like-button"
            type="button"
            class="like-btn-wrap post-meta-chip post-meta-chip-like"
            aria-pressed="false"
            aria-label="\u0db8\u0dd9\u0db8 \u0d9a\u0dad\u0dcf\u0dc0\u0da7 \u0d9a\u0dcf\u0daf\u0db1\u0dd2\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc3\u0dbd\u0d9a\u0dd4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1"
            data-post-id={post.id}
          >
            <span class="like-icon-wrap">
              <span class="like-ripple" aria-hidden="true"></span>
              <span class="like-particles" aria-hidden="true"></span>
              <svg
                id="like-heart-icon"
                class="like-heart-svg h-4 w-4 text-[#F8F8FF]/60 transition-all duration-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                />
              </svg>
              <span class="like-plus-one" aria-hidden="true">+1</span>
            </span>
            <span id="like-count" class="like-count-num text-xs sm:text-sm font-bold text-[#F8F8FF]/70">--</span>
          </button>
        </div>
      </div>

      <div class="col-12 mt-8 mb-2">
        {image && (
          <Image
            src={image}
            height={1200}
            width={800}
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 896px"
            alt={title}
            class="rounded-lg w-full h-auto object-cover mx-auto max-w-4xl border border-white/10"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>

      <div class="md:col-10">
        <div class="content mb-16 text-left text-[#F8F8FF] custom-post-content">
          <Content />
        </div>

        <div class="flex flex-wrap items-center justify-between border-t border-white/10 pt-6">
          <ul class="mr-4 mb-4 space-x-3">
            {tags.map((tag: string) => (
              <li class="inline-block">
                <a
                  href={withTrailingSlash(`/tags/${slugify(tag)}`)}
                  class="block rounded-lg bg-[#FFCC00] border border-[#FFCC00] px-4 py-2 font-black text-[#010203] text-sm hover:bg-[#E6B800] transition duration-300"
                >
                  #{humanize(tag)}
                </a>
              </li>
            ))}
          </ul>
          <Share
            className="social-share mb-4 text-[#F8F8FF]"
            title={title}
            description={description}
            slug={post.id}
          />
        </div>
      </div>
    </article>
  </div>

  <button
    id="comment-floating-btn"
    class="fixed bottom-6 right-6 z-40 flex items-center gap-2 bg-[#01AD9F] text-[#010203] font-black px-5 py-3 rounded-full shadow-[0_4px_20px_rgba(1,173,159,0.4)] cursor-pointer select-none comment-float-btn"
    aria-label="Open Comments Section"
    aria-expanded="false"
    aria-controls="comment-popup-modal"
  >
    <span class="comment-btn-ring"></span>
    <svg class="w-5 h-5 fill-current relative z-10" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
    </svg>
    <span class="relative z-10">\u0d9a\u0db8\u0dd9\u0db1\u0dca\u0da7\u0dca\u0dc3\u0dca</span>
  </button>

  <div
    id="comment-popup-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#010203]/70 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="comment-modal-title"
    data-post-id={post.id}
    data-api-url={WORKER_API}
  >
    <div class="relative w-full max-w-2xl bg-[#0c0d10] border border-white/10 rounded-2xl shadow-[0_10px_50px_rgba(0,0,0,0.8)] flex flex-col max-h-[85vh]">
      <div class="flex items-center justify-between px-6 py-4 border-b border-white/[0.06]">
        <h3 id="comment-modal-title" class="text-lg font-black text-[#F8F8FF] flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#01AD9F] animate-pulse" aria-hidden="true"></span>
          \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc3\u0dc4 \u0d9a\u0db8\u0dd9\u0db1\u0dca\u0da7\u0dca\u0dc3\u0dca
        </h3>
        <button
          id="comment-close-btn"
          class="p-1.5 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.08] text-white/60 hover:text-red-400 transition-colors duration-200 cursor-pointer outline-none"
          aria-label="Close Comments"
        >
          <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div id="comments-wrapper-area" class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar">
        <div class="mb-4">
          <label for="cf-comment-text" class="block text-xs text-white/50 mb-2 font-semibold uppercase tracking-wider">
            \u0dbd\u0dd2\u0dba\u0db1\u0dca\u0db1
          </label>
          <div class="relative">
            <textarea
              id="cf-comment-text"
              class="w-full h-24 p-3 pr-10 bg-white/5 border border-white/10 rounded-xl text-[#F8F8FF] placeholder-white/30 focus:border-[#01AD9F] outline-none transition duration-200 resize-none text-sm"
              placeholder="\u0d9a\u0db8\u0dd9\u0db1\u0dca\u0da7\u0dca \u0dd0\u0d9a"
              maxlength="1000"
            ></textarea>
            <button
              id="cf-clear-btn"
              class="absolute top-2 right-2 p-1 rounded-lg text-white/20 hover:text-red-400 hover:bg-white/5 transition-colors duration-200 hidden"
              aria-label="Clear comment text"
              type="button"
            >
              <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="flex items-center justify-between mt-2">
            <span id="char-count" class="text-xs text-white/30">0 / 1000</span>
            <button
              id="cf-submit-comment"
              class="bg-[#01AD9F] text-[#010203] font-bold px-6 py-2 rounded-xl text-sm transition hover:bg-[#01c4b4] cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Submit Comment
            </button>
          </div>
        </div>

        <div class="comment-warning-notice rounded-xl px-4 py-3 mb-2" role="alert" aria-live="polite">
          <div class="warning-header">
            <span class="warning-badge" aria-hidden="true">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
              \u0dc0\u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0daf\u0dd0\u0dab\u0dd4\u0db8\u0dca\u0daf\u0dd3\u0db8
            </span>
          </div>
          <p class="warning-body text-[13px] leading-relaxed mt-2">
            <span id="warning-typewriter"></span><span id="warning-cursor" class="warning-cursor">|</span>
          </p>
        </div>

        <p id="cf-validation-msg" class="hidden text-xs font-semibold px-3 py-2 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 mb-2"></p>

        <div class="border-t border-white/5 pt-4">
          <p class="text-xs text-white/40 tracking-wider uppercase mb-3 font-semibold">Recent Comments</p>
          <div id="comments-list-hook" class="space-y-3" aria-live="polite" aria-label="Comments list">
            <div id="no-comments-msg" class="py-3 text-center">
              <p class="text-sm text-white/50 italic mb-3">\u0d9a\u0db8\u0dd9\u0db1\u0dca\u0da7\u0dca\u0dc3\u0dca \u0dc5\u0ddd\u0da9\u0dca \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3</p>
              <div class="loading-bars-wrap" aria-hidden="true">
                <span class="lbar"></span><span class="lbar"></span><span class="lbar"></span>
                <span class="lbar"></span><span class="lbar"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="comment-success-toast"
    class="fixed bottom-24 right-6 z-50 flex items-center gap-3 bg-[#01AD9F] text-[#010203] font-bold px-5 py-3 rounded-2xl shadow-[0_4px_24px_rgba(1,173,159,0.5)] translate-y-4 opacity-0 pointer-events-none transition-all duration-300"
    aria-live="polite"
  >
    <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
    </svg>
    <span>\u0dc3\u0dca\u0dad\u0dd6\u0dad\u0dd2\u0dba\u0dd2! \u0d94\u0db6\u0dda \u0d85\u0daf\u0dc4\u0dc3 \u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a\u0dc0 \u0daf\u0dd0\u0db8\u0dd4\u0db1\u0dcf \ud83d\ude4f</span>
  </div>
</section>

{finalSimilarPosts.length > 0 && (
  <section class="section pt-12 pb-16 bg-gradient-to-b from-[#010203] via-[#022c16] to-[#010203] border-t border-white/5">
    <div class="container">
      <h2 class="mb-8 font-black text-center h4 text-[#F8F8FF]">
        \u0d94\u0db6 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0dad\u0dc0\u0dad\u0dca \u0d9a\u0dad\u0dcf
      </h2>
      <div class="row similar-posts-3d-grid">
        <SimilarPosts posts={finalSimilarPosts} />
      </div>
    </div>
  </section>
)}

<style is:global>
  .custom-post-content p,
  .custom-post-content span,
  .custom-post-content li,
  .custom-post-content strong,
  .custom-post-content h1,
  .custom-post-content h2,
  .custom-post-content h3,
  .custom-post-content h4 {
    color: #F8F8FF !important;
  }
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 99px;
  }
  .comment-float-btn {
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    animation: cfloat 3s ease-in-out infinite;
  }
  .comment-float-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 8px 32px rgba(1,173,159,0.55);
  }
  .comment-float-btn:active { transform: scale(0.95); }
  @keyframes cfloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-6px); }
  }
  .comment-btn-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgba(1,173,159,0.35);
