    background: linear-gradient(to bottom, #f87171, #b91c1c);
    border-radius: 2px 0 0 2px;
  }
  .comment-warning-notice::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(239,68,68,0.3), transparent);
  }
  .warning-header { display: flex; align-items: center; gap: 8px; }
  .warning-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(239,68,68,0.12);
    border: 1px solid rgba(239,68,68,0.25);
    color: #f87171;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .warning-body { color: rgba(252,165,165,0.85); padding-left: 2px; }
  .warning-cursor {
