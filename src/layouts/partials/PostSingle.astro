  .lbar:nth-child(3) { animation-delay: 0.3s;  height: 26px; }
  .lbar:nth-child(4) { animation-delay: 0.45s; height: 18px; }
  .lbar:nth-child(5) { animation-delay: 0.6s;  height: 10px; }
  @keyframes lbarAnim {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50%       { transform: scaleY(1);   opacity: 1;   }
  }
  .similar-posts-3d-grid { perspective: 1200px; }
  .similar-posts-3d-grid article,
  .similar-posts-3d-grid .card,
  .similar-posts-3d-grid [class*="col-"] > a,
