---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/layouts/components/SimilarPosts.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { withTrailingSlash } from "@/lib/utils/urlHelper";
import { buildMetaKeywords } from "@/lib/utils/keywordExtractor";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt, BiTime, BiChevronRight, BiHomeAlt2, BiMapPin } from "react-icons/bi";

const allAuthors = await getSinglePage("authors");
const posts = await getSinglePage("posts");
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, authors, categories, image, image_alt, date, tags, updated } = post.data;

// Null-safe local copies. The template previously called
// categories.map(), tags.length and authors.map() directly, so a post
// published without any category/tag/author crashed the whole build.
const safeCategories: string[] = Array.isArray(categories) ? categories : [];
const safeTags: string[] = Array.isArray(tags) ? tags : [];
const safeAuthors: string[] = Array.isArray(authors) ? authors : [];

let smartSimilarPosts = posts.filter(
  (p) => p.id !== post.id && p.data.categories?.some((cat) => safeCategories.includes(cat))
);
if (!smartSimilarPosts.length) {
  smartSimilarPosts = posts.filter((p) => p.id !== post.id);
}
const finalSimilarPosts = smartSimilarPosts.slice(0, 6);

const WORKER_API = "https://comments.wala-katha.workers.dev/api/comments";

// NEW: Like feature API endpoint. This targets the SAME Cloudflare
// Worker origin that already powers the comment system above
// (comments.wala-katha.workers.dev), reusing a domain that is already
// whitelisted in public/_headers' Content-Security-Policy
// connect-src directive - no CSP changes required for this feature.
// IMPORTANT: this expects a "/api/likes" route to exist on that same
// Worker (GET ?postId=... -> { count }, POST { postId, action } ->
// { count }). That Worker's source code lives in a separate
// repo/service not included in this project's files, so the actual
// server-side storage/counting logic must be added there separately.
const LIKES_API = "https://comments.wala-katha.workers.dev/api/likes";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";

// Brand name comes from config so og:site_name cannot drift from the
// site title used everywhere else (it was hardcoded "Wala Katha"
// while config.json says "Sinhala Wal Katha" - a split brand signal).
const siteName = config?.site?.title || "Wal Katha";

// OG:URL / CANONICAL MISMATCH FIX (Ahrefs "Open graph URL not matching
// canonical URL"): postUrl previously had NO trailing slash while
// blog/[single].astro's canonicalUrl (passed into Base.astro) DOES have
// one - Cloudflare Pages serves this site's directory-style URLs with a
// trailing slash by default (see wrangler.jsonc / Base.astro comments),
// so the canonical URL is the source of truth. withTrailingSlash() is the
// same central helper already used site-wide (Posts.astro, Header.astro,
// Footer.astro, blog/[single].astro, etc.), so this keeps og:url and
// canonical byte-for-byte identical without introducing a second,
// divergent trailing-slash implementation.
const postUrl = withTrailingSlash(`${siteUrl}/blog/${post.id}`);
// NEW: dynamic, auto-generated OG image (build-time generated by
// src/pages/og/[slug].png.ts) - used for og:image/twitter:image below
// instead of the frontmatter thumbnail, so every article gets a
// proper social-share card even when the post has no manual image.
const ogImageUrl = `${siteUrl}/og/${post.id}.png`;
const authorName = allAuthors.find((a) =>
  safeAuthors.map((au: string) => slugify(au)).includes(slugify(a.data.title))
)?.data.title ?? "Wala Katha";

// 2026 "LAST UPDATED" LOGIC: content.config.ts එකට එකතු කරන ලද
// optional "updated" field එක පාවිච්චි කරලා, publish date එකට වඩා
// different modified date එකක් තියෙනවා නම් විතරක් "Updated" badge එක
// පෙන්වයි. "updated" field එක නැති posts (existing 4ම post ඇතුළුව) -
// මෙය silently false වී, publish date එක විතරක් පෙන්වයි, කිසිම build
// error එකක් හෝ UI glitch එකක් ඇති නොකරයි.
const hasUpdatedDate = updated && date && new Date(updated).getTime() !== new Date(date).getTime();

// NEW: auto-extracted body keywords, merged with frontmatter tags +
// global force keywords via keywordExtractor.ts's buildMetaKeywords().
// This feeds the <meta name="keywords"> tag below and also supplies
// extra article:tag entries (entity/topic signals for AI Overviews and
// knowledge-graph parsing) beyond the manually curated tags list.
const autoExtractedKeywords = buildMetaKeywords(safeTags, post.body);
const extractedOnlyKeywords = autoExtractedKeywords.filter(
  (k) => !safeTags.some((t: string) => t.toLowerCase() === k.toLowerCase())
);

// NOTE: the previous per-image MIME-type detection helper
// (detectImageMimeType/postImageMimeType) has been removed - og:image
// now always points at the build-time generated /og/{slug}.png file
// (see ogImageUrl above), so og:image:type is always the fixed literal
// "image/png" below instead of needing runtime detection.

// Frontmatter image paths can silently carry zero-width / bidi / nbsp
// characters pasted from editors (confirmed live on one post's image),
// which produce a broken URL inside the ImageObject schema below.
function sanitizeAssetUrl(rawPath: string): string | null {
  const cleaned = rawPath
    .replace(/[\u200B-\u200D\uFEFF]/g, "")
    .replace(/\u00A0/g, " ")
    .replace(/[\u200E\u200F\u202A-\u202E]/g, "")
    .trim();
  if (!cleaned) return null;
  if (/^https?:\/\//i.test(cleaned)) return cleaned;
  return `${siteUrl}${cleaned.startsWith("/") ? cleaned : `/${cleaned}`}`;
}
const schemaImageUrl = image ? sanitizeAssetUrl(image as string) : null;

// ==========================================================
// DYNAMIC BREADCRUMB TRAIL WITH INDEXING SIGNALS
//
// STRUCTURE: Home -> Category -> Post Title
//
// The previous version also carried a "Blog" node pointing at
// siteUrl - the exact same URL as the "Home" node. Two ListItems
// sharing one identical "item" URL is a redundant node under
// Google's BreadcrumbList guidelines: it surfaces as a warning in
// the Rich Results Test and muddies the crawler's view of the
// hierarchy. This site has no dedicated /blog/ archive route (the
// homepage IS the post listing), so the honest trail is simply
// Home -> Category -> Post.
//
// SINGLE SOURCE OF TRUTH: this same breadcrumbItems array drives
// BOTH the JSON-LD BreadcrumbList schema (breadcrumbSchema) AND the
// visible <nav> breadcrumb UI further down in the template - they
// can never desync, and adding/removing a level here automatically
// flows through both (the schema's itemListElement map and the UI's
// crumb map are both fully generic over array length).
//
// Category URL goes through withTrailingSlash() for consistency with
// this site's Cloudflare Pages trailing-slash convention, avoiding an
// unnecessary 308 redirect hop on the breadcrumb's category link.
// ==========================================================
const breadcrumbItems = [
  { name: "මුල් පිටුව", item: withTrailingSlash(siteUrl) },
  {
    name: safeCategories[0] ? humanize(safeCategories[0]) : "Posts",
    item: withTrailingSlash(`${siteUrl}/categories/${slugify(safeCategories[0] ?? "posts")}`),
  },
  { name: title, item: postUrl },
];

// BreadcrumbList Schema only - Article schema blog/[single].astro handles
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": b.item,
  })),
});

// NEW: ImageObject Schema - Google Image SEO structured data. Gives
// Google explicit, machine-readable metadata about the post's hero
// image (license, creator, caption) beyond just the OG-image tags
// PostSingle.astro/blog/[single].astro already render - this is
// additive and does not replace or conflict with the existing
// og:image/twitter:image meta tags or the NewsArticle schema's own
// "image" ImageObject field in blog/[single].astro.
const imageObjectSchema = schemaImageUrl
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ImageObject",
      "contentUrl": schemaImageUrl,
      "license": `${siteUrl}/copyright-credit-policy/`,
      "acquireLicensePage": `${siteUrl}/copyright-credit-policy/`,
      "creditText": siteName,
      "copyrightNotice": siteName,
      "creator": {
        "@type": "Organization",
        "name": siteName,
      },
      "caption": image_alt || title,
    })
  : null;
---

<!-- REMOVED: canonical, description, robots - Base.astro handles these (no duplicates) -->
<!-- REMOVED: og:image / og:image:secure_url / og:image:width / og:image:height /
     og:image:type / twitter:image - Base.astro emits all of these on EVERY page
     (they sit outside its !isArticle block), so keeping copies here shipped each
     article with two og:image tags, two og:image:width tags, and so on. Social
     crawlers pick inconsistently between duplicates. blog/[single].astro passes
     image={`/og/${post.id}.png`} into Base, so Base's copies already resolve to
     the exact same generated OG image this file used to point at. Only the
     *:alt variants stay below, since Base does not emit those. -->
<!-- KEPT: Article-specific OG/Twitter tags - Base.astro isArticle=true නිසා render නොකරයි -->

<!-- Open Graph - Article specific -->
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description ?? title} />
<meta property="og:url" content={postUrl} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content="si_LK" />
<meta property="og:site_name" content={siteName} />
{date && <meta property="article:published_time" content={new Date(date).toISOString()} />}
{date && <meta property="article:modified_time" content={hasUpdatedDate ? new Date(updated).toISOString() : new Date(date).toISOString()} />}
<meta property="article:author" content={authorName} />
{safeCategories.map((c: string) => <meta property="article:section" content={humanize(c)} />)}
{safeTags.map((t: string) => <meta property="article:tag" content={humanize(t)} />)}
{extractedOnlyKeywords.map((k: string) => <meta property="article:tag" content={humanize(k)} />)}

<!-- Twitter Card - Article specific -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description ?? title} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:site" content="@WalaKatha" />

<!-- Keywords & Author - article specific, Base.astro isArticle=true නිසා render නොකරයි -->
<!-- REMOVED: revisit-after (a 1990s tag no search engine has ever supported)
     and name="language" (non-standard; <html lang="si"> plus og:locale already
     carry the language signal correctly). -->
<meta name="keywords" content={autoExtractedKeywords.join(", ")} />
<meta name="author" content={authorName} />

<!-- BreadcrumbList Schema -->
<script type="application/ld+json" set:html={breadcrumbSchema} />

<!-- ImageObject Schema (Google Image SEO) -->
{imageObjectSchema && (
  <script type="application/ld+json" set:html={imageObjectSchema} />
)}

<section class="section !pt-6 sm:!pt-8 bg-[#010203] relative">
  <div class="container">

    {/* 2026 AUTO-COLLAPSING VISIBLE BREADCRUMB UI (v5 - DYNAMIC
        3-LEVEL TRAIL: Home -> Category -> Post Title):

        HREF LOGIC GENERALIZED: every non-last crumb's href reads
        directly from crumb.item (already a correct, absolute URL
        computed once in the breadcrumbItems array above) - this makes
        the UI fully generic over however many breadcrumb levels
        exist, so changing the trail depth never requires touching
        this render logic.

        SEO SAFETY: full breadcrumb <a> links සහ text සියල්ල DOM එකේ
        සම්පූර්ණයෙන්ම present වේ (display:none කිසිවිටෙකත් යොදා නැත) -
        visually collapse කරන්නේ max-height/opacity CSS transition එකකින්
        පමණි, එබැවින් Googlebot/crawlers වලට content එක සම්පූර්ණයෙන් පෙනී
        යාම සහතික වේ, JSON-LD schema සමග visible-match signal එකත් රැඳේ.

        CLS SAFETY: collapsed state එකේදීත් wrapper එකේ min-height එකක්
        reserve කර ඇති නිසා, collapse/expand animation එකෙන් ඉහළින්ම ඇති
        article title එක "jump" වීමක් (layout shift) සිදු නොවේ.

        NAVIGATION SAFETY: Astro View Transitions (ClientRouter) සක්‍රීය
        site එකක් නිසා DOMContentLoaded නොව, site-wide already-established
        pattern එකම (astro:page-load, Header.astro/PostSingle.astro comment
        system එකේම pattern එක) භාවිතා කර ඇත - SPA navigation කිහිපයකින්
        පසුවත් timer/toggle logic එක නිවැරදිව reset වී වැඩ කරයි.

        SELF-HEALING AUTO-COLLAPSE: expand කිරීමෙන් පසුවත්
        "scheduleAutoCollapse()" reusable function එක හරහා නැවත 5
        තත්පරයකින් auto-collapse වීම permanent ලෙස recurring වේ. */}
    <div id="breadcrumb-wrapper" class="row justify-center mt-0 mb-3">
      <div class="md:col-10 flex justify-center sm:justify-start">
        <div id="breadcrumb-shell" class="relative min-h-[42px] flex items-center">

          {/* COLLAPSED-STATE TOGGLE BUTTON - auto-collapse කළ පසු පමණක්
              visible වේ (JS එකෙන් "is-collapsed" class එක parent එකට
              add කරයි). No-JS fallback: JS disable නම් මෙය කිසිවිටෙකත්
              පෙනෙන්නේ නැත, full breadcrumb එකම සැමවිටම පෙනී පවතී.
              ICON COLOR FIX: BiMapPin icon සහ arrow SVG දෙකම දැන්
              "text-[#01AD9F]" (site theme emerald/green) වර්ණයෙන්
              - කලින් තිබූ "text-[#F8F8FF]/70" (dim white) වෙනුවට. */}
          <button
            id="breadcrumb-toggle"
            type="button"
            aria-label="පාර පෙන්වන්න/සඟවන්න"
            aria-expanded="true"
            aria-controls="breadcrumb-content"
            class="hidden items-center gap-2 bg-white/[0.05] hover:bg-white/[0.1] border border-[#01AD9F]/30 hover:border-[#01AD9F]/60 text-[#01AD9F] hover:text-[#01c4b4] text-[13px] sm:text-sm font-bold px-4 py-2.5 rounded-full transition-colors duration-200 breadcrumb-toggle-pulse"
          >
            <BiMapPin className="h-4 w-4 flex-shrink-0 text-[#01AD9F]" aria-hidden="true" />
            <span>Path</span>
            <svg id="breadcrumb-arrow" class="h-3.5 w-3.5 text-[#01AD9F] transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 011.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          {/* FULL BREADCRUMB NAV - always in DOM, always crawlable.
              breadcrumbItems array එකම (schema එකට use කරන) reuse කරන
              නිසා, schema එකයි UI එකයි කවදාවත් desync නොවෙන්න. */}
          <nav
            id="breadcrumb-content"
            aria-label="Breadcrumb"
            class="breadcrumb-collapsible-content overflow-hidden"
          >
            <ol class="list-none flex flex-wrap items-center gap-x-2 gap-y-1 m-0 p-0 text-[13px] sm:text-sm text-[#F8F8FF]/50 font-medium bg-white/[0.03] border border-white/[0.06] rounded-full px-4 py-2.5 w-fit max-w-full">
              {breadcrumbItems.map((crumb, i) => {
                const isLast = i === breadcrumbItems.length - 1;
                return (
                  <li class="list-none flex items-center gap-2 min-w-0 m-0 p-0">
                    {i > 0 && (
                      <BiChevronRight className="h-3.5 w-3.5 text-[#F8F8FF]/25 flex-shrink-0" aria-hidden="true" />
                    )}
                    {isLast ? (
                      <span
                        class="text-[#01AD9F] font-bold truncate max-w-[140px] sm:max-w-[280px]"
                        aria-current="page"
                      >
                        {crumb.name}
                      </span>
                    ) : (
                      <a
                        href={crumb.item}
                        class="flex items-center gap-1.5 hover:text-emerald-400 transition-colors duration-200 truncate max-w-[100px] sm:max-w-none"
                      >
                        {i === 0 && <BiHomeAlt2 className="h-4 w-4 flex-shrink-0" aria-hidden="true" />}
                        <span class="truncate">{crumb.name}</span>
                      </a>
                    )}
                  </li>
                );
              })}
            </ol>
          </nav>

        </div>
      </div>
    </div>

    <article class="row justify-center">
      <div class="md:col-10 text-center">
        {/* GOOGLE "SPEAKABLE" SCHEMA FIX: id="speakable-headline"
            එකතු කරන ලද්දේ, blog/[single].astro හි JSON-LD
            "speakable.cssSelector" array එක මෙම exact H1 element එකටම
            point කිරීමට. Design/CSS classes කිසිවක් වෙනස් වී නැත -
            id attribute එකක් පමණක් එකතු කර ඇත. */}
        <h1 id="speakable-headline" set:html={markdownify(title)} class="h2 text-[#F8F8FF] font-black drop-shadow-md" />

        {/* GOOGLE "SPEAKABLE" SCHEMA FIX: post description එක DOM
            එකේ crawlable/selectable content එකක් ලෙස තිබිය යුතු බැවින්
            (schema cssSelector එකකට point කළ හැක්කේ actual DOM එකේ
            පවතින content එකකට පමණි - meta tags වලට schema selector
            එකකින් point කළ නොහැක), site එකේ දැනටමත් ස්ථාපිත
            visually-hidden SEO content pattern එකම (index.astro's
            .seo-h1-wrap, search.astro's .seo-visually-hidden)
            අනුගමනය කරමින්, "sr-only" (Tailwind built-in utility)
            paragraph එකක් ලෙස description එක එකතු කර ඇත. මෙය visual
            design එකට කිසිදු බලපෑමක් ඇති නොකරයි (screen-reader/crawler
            ට පමණක් accessible), නමුත් Google Rich Results Test එකට
            "speakable" content එක DOM එකේ තහවුරු කරගැනීමට ඉඩ සලසයි. */}
        <p id="speakable-summary" class="speakable-summary sr-only">
          {description ?? title}
        </p>

        {/* 2026 POST-META CARD REDESIGN: the previous version was a plain
            flex-wrap <ul> with no visual grouping - author, date, updated
            badge, reading time, categories, and the like button all sat
            loose on the page with nothing tying them together. This
            replaces it with a single glass "meta card": one bordered,
            backdrop-blurred container holding every info chip, so the
            whole block reads as one cohesive unit instead of scattered
            text. Every chip shares one visual language (rounded-full
            pill, subtle bg, 4px icon) so the row stays calm even with six
            different pieces of information in it. Fully fluid/wrap-based
            (no fixed widths, no media-query breakpoints needed) so it
            reflows cleanly on any screen size automatically. All existing
            data logic (author filter, hasUpdatedDate condition, category
            map, like-button ids/classes the script below depends on) is
            unchanged - only the markup/styling around that data. */}
        <div class="post-meta-card relative mt-6 inline-flex max-w-full flex-wrap items-center justify-center gap-2 rounded-2xl border border-white/[0.08] bg-white/[0.03] px-3 py-2.5 sm:px-4 sm:py-3 backdrop-blur-sm shadow-[0_10px_30px_-12px_rgba(0,0,0,0.7)] transition-colors duration-300">
          {/* Signature hairline: a thin emerald gradient across the card's
              top edge - the one deliberate accent touch, tying the card
              back to the site's #01AD9F brand color without introducing a
              second competing hue. */}
          <span class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-[#01AD9F]/70 to-transparent" aria-hidden="true" />

          {allAuthors
            .filter((author) =>
              safeAuthors.map((a: string) => slugify(a)).includes(slugify(author.data.title))
            )
            .map((author) => (
              <a
                href={withTrailingSlash(`/authors/${slugify(author.id)}`)}
                class="post-meta-chip post-meta-chip-author group/author"
              >
                {author.data.image && (
                  <Image
                    src={author.data.image}
                    alt={author.data.title}
                    height={50}
                    width={50}
                    class="h-6 w-6 rounded-full object-cover ring-1 ring-white/15 transition-all duration-300 group-hover/author:ring-[#01AD9F]/60"
                  />
                )}
                <span class="font-bold text-[#F8F8FF] transition-colors duration-300 group-hover/author:text-[#01AD9F]">
                  {author.data.title}
                </span>
              </a>
            ))}

          <span class="post-meta-chip">
            <BiCalendarEdit className="h-4 w-4 text-[#01AD9F]" />
            {dateFormat(date)}
          </span>

          {/* 2026 "LAST UPDATED" UI BADGE: publish date එකට වඩා
              different "updated" date එකක් content.config.ts frontmatter
              එකේ තියෙනවා නම් විතරක් පෙන්වයි. Existing posts (updated
              field නැති) මේ chip එක render වෙන්නේම නෑ - card layout එකට
              කිසිම gap/spacing issue එකක් ඇති නොකරයි. */}
          {hasUpdatedDate && (
            <span class="post-meta-chip post-meta-chip-updated">
              <BiCalendarEdit className="h-4 w-4 text-emerald-400" />
              <span class="font-normal text-[#F8F8FF]/60">Updated</span>
              {dateFormat(updated)}
            </span>
          )}

          {/* 2026 READING TIME CHIP: same shared chip language as every
              other item in this card. */}
          <span class="post-meta-chip">
            <BiTime className="h-4 w-4 text-[#01AD9F]" />
            {readingTime(post.body ?? "").toString()}
          </span>

          {safeCategories.length > 0 && (
            <span class="post-meta-chip post-meta-chip-categories">
              <BiCategoryAlt className="h-4 w-4 text-[#01AD9F] flex-shrink-0" />
              <span class="flex flex-wrap items-center gap-1.5">
                {safeCategories.map((category: string) => (
                  <a
                    href={withTrailingSlash(`/categories/${slugify(category)}`)}
                    class="rounded-full bg-white/[0.06] px-2 py-0.5 text-[12.5px] font-bold text-[#F8F8FF]/85 transition-colors duration-200 hover:bg-[#01AD9F]/15 hover:text-[#01AD9F]"
                  >
                    {humanize(category)}
                  </a>
                ))}
              </span>
            </span>
          )}

          {/* Divider before the like action - visible only from sm+ so the
              card never wraps around an orphaned divider on narrow phones. */}
          <span class="hidden h-5 w-px bg-white/10 sm:block" aria-hidden="true" />

          {/* LIKE BUTTON WIDGET
              WHY: readers previously had no way to "like" a post. Rather
              than adding a fake AggregateRating/star schema (which is
              NOT eligible for Google rich-snippet stars on Article-type
              content, and risks a spammy-structured-data flag), this is
              a genuine, transparent interaction widget - a heart toggle
              plus a real count fetched from the same Cloudflare Worker
              origin that already powers the comment system
              (comments.wala-katha.workers.dev, already whitelisted in
              public/_headers' CSP connect-src). No schema.org rating
              claim is made anywhere on this page for this feature - it
              is purely a UI/engagement element.
              data-post-id carries post.id so the script below can target
              the correct like-count bucket per story. All ids/classes
              the like-button script depends on (#like-button,
              #like-heart-icon, #like-count, .like-btn-wrap,
              aria-pressed) are preserved exactly - only the visual
              chip styling around them changed. */}
          <button
            id="like-button"
            type="button"
            class="like-btn-wrap post-meta-chip post-meta-chip-like"
            aria-pressed="false"
            aria-label="මෙම කතාවට කැමතියි කියලා සලකුණු කරන්න"
            data-post-id={post.id}
          >
            {/* 2026 LIKE-BURST ANIMATION WRAPPER: like-icon-wrap is a
                small relatively-positioned box around ONLY the heart
                icon (not the whole chip), so the ripple/particle/+1
                effects below can be centered with simple 50%/50%
                positioning regardless of chip padding or count-digit
                width - none of this changes the button's flex layout,
                every added element is absolutely positioned and
                pointer-events:none so click targeting is untouched. */}
            <span class="like-icon-wrap">
              <span class="like-ripple" aria-hidden="true"></span>
              <span class="like-particles" aria-hidden="true"></span>
              <svg
                id="like-heart-icon"
                class="like-heart-svg h-4 w-4 text-[#F8F8FF]/60 transition-all duration-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                />
              </svg>
              <span class="like-plus-one" aria-hidden="true">+1</span>
            </span>
            <span id="like-count" class="like-count-num text-xs sm:text-sm font-bold text-[#F8F8FF]/70">--</span>
          </button>
        </div>
      </div>

      <div class="col-12 mt-8 mb-2">
        {image && (
          <Image
            src={image}
            height={500}
            width={1000}
            alt={image_alt || title}
            title={title}
            class="rounded-lg w-full h-auto object-cover mx-auto max-w-4xl border border-white/10"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>

      <div class="md:col-10">
        <div class="content mb-16 text-left text-[#F8F8FF] custom-post-content">
          <Content />
        </div>

        {/* 2026 TAGS + SHARE FOOTER REDESIGN:
            WHY: the previous layout put tags in a plain <ul class="mr-4
            mb-4 space-x-3"> (not a flex container) with <li
            class="inline-block"> children. Because "space-x-3" only
            works reliably on flex/grid parents, and inline-block list
            items pick up the raw HTML whitespace between them as extra,
            inconsistent gaps, the pills wrapped unevenly and stayed
            pinned to the left instead of reading as one tidy group -
            exactly the messy left-aligned look reported.

            FIX: the whole footer is now a single centered flex column.
            The tags <ul> itself is "flex flex-wrap justify-center
            gap-2.5" - flex+gap gives perfectly even, predictable spacing
            between every pill on every row, regardless of how many wrap
            to a second or third line, and justify-center keeps each
            wrapped row centered instead of left-hugging. The Share icons
            row sits centered underneath on its own line. This is a pure
            layout change - the pill styling (colors, padding, hover
            state), the Share component props, and every link/href are
            byte-identical to before, so nothing else about the page
            changes. */}
        <div class="border-t border-white/10 pt-6">
          <div class="flex flex-col items-center gap-6">
            {safeTags.length > 0 && (
              <ul class="flex flex-wrap justify-center gap-2.5">
                {safeTags.map((tag: string) => (
                  <li>
                    <a
                      href={withTrailingSlash(`/tags/${slugify(tag)}`)}
                      class="inline-block rounded-lg bg-[#FFCC00] border border-[#FFCC00] px-4 py-2 font-black text-[#010203] text-sm hover:bg-[#E6B800] transition duration-300"
                    >
                      #{humanize(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <Share
              className="social-share text-[#F8F8FF]"
              title={title}
              description={description}
              slug={post.id}
            />
          </div>
        </div>
      </div>
    </article>
  </div>

  <button
    id="comment-floating-btn"
    class="fixed bottom-6 right-6 z-40 flex items-center gap-2 bg-[#01AD9F] text-[#010203] font-black px-5 py-3 rounded-full shadow-[0_4px_20px_rgba(1,173,159,0.4)] cursor-pointer select-none comment-float-btn"
    aria-label="Open Comments Section"
    aria-expanded="false"
    aria-controls="comment-popup-modal"
  >
    <span class="comment-btn-ring"></span>
    <svg class="w-5 h-5 fill-current relative z-10" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
    </svg>
    <span class="relative z-10">කමෙන්ට්ස්</span>
  </button>

  <div
    id="comment-popup-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#010203]/70 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="comment-modal-title"
    data-post-id={post.id}
    data-api-url={WORKER_API}
  >
    <div class="relative w-full max-w-2xl bg-[#0c0d10] border border-white/10 rounded-2xl shadow-[0_10px_50px_rgba(0,0,0,0.8)] flex flex-col max-h-[85vh]">
      <div class="flex items-center justify-between px-6 py-4 border-b border-white/[0.06]">
        <h3 id="comment-modal-title" class="text-lg font-black text-[#F8F8FF] flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#01AD9F] animate-pulse" aria-hidden="true"></span>
          අදහස් සහ කමෙන්ට්ස්
        </h3>
        <button
          id="comment-close-btn"
          class="p-1.5 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.08] text-white/60 hover:text-red-400 transition-colors duration-200 cursor-pointer outline-none"
          aria-label="Close Comments"
        >
          <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div id="comments-wrapper-area" class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar">
        <div class="mb-4">
          <label for="cf-comment-text" class="block text-xs text-white/50 mb-2 font-semibold uppercase tracking-wider">
            ඔබේ අදහස ලියන්න
          </label>
          <div class="relative">
            <textarea
              id="cf-comment-text"
              class="w-full h-24 p-3 pr-10 bg-white/5 border border-white/10 rounded-xl text-[#F8F8FF] placeholder-white/30 focus:border-[#01AD9F] outline-none transition duration-200 resize-none text-sm"
              placeholder="ඔබේ කමෙන්ට් එක මෙතන ටයිප් කරන්න..."
              maxlength="1000"
            ></textarea>
            <button
              id="cf-clear-btn"
              class="absolute top-2 right-2 p-1 rounded-lg text-white/20 hover:text-red-400 hover:bg-white/5 transition-colors duration-200 hidden"
              aria-label="Clear comment text"
              type="button"
            >
              <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="flex items-center justify-between mt-2">
            <span id="char-count" class="text-xs text-white/30">0 / 1000</span>
            <button
              id="cf-submit-comment"
              class="bg-[#01AD9F] text-[#010203] font-bold px-6 py-2 rounded-xl text-sm transition hover:bg-[#01c4b4] cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Submit Comment
            </button>
          </div>
        </div>

        <div class="comment-warning-notice rounded-xl px-4 py-3 mb-2" role="alert" aria-live="polite">
          <div class="warning-header">
            <span class="warning-badge" aria-hidden="true">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
              වැදගත් දැනුම්දීම
            </span>
          </div>
          <p class="warning-body text-[13px] leading-relaxed mt-2">
            <span id="warning-typewriter"></span><span id="warning-cursor" class="warning-cursor">|</span>
          </p>
        </div>

        <p id="cf-validation-msg" class="hidden text-xs font-semibold px-3 py-2 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 mb-2"></p>

        <div class="border-t border-white/5 pt-4">
          <p class="text-xs text-white/40 tracking-wider uppercase mb-3 font-semibold">Recent Comments</p>
          <div id="comments-list-hook" class="space-y-3" aria-live="polite" aria-label="Comments list">
            <div id="no-comments-msg" class="py-3 text-center">
              <p class="text-sm text-white/50 italic mb-3">කමෙන්ට්ස් ලෝඩ් වෙමින් පවතී...</p>
              <div class="loading-bars-wrap" aria-hidden="true">
                <span class="lbar"></span><span class="lbar"></span><span class="lbar"></span>
                <span class="lbar"></span><span class="lbar"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="comment-success-toast"
    class="fixed bottom-24 right-6 z-50 flex items-center gap-3 bg-[#01AD9F] text-[#010203] font-bold px-5 py-3 rounded-2xl shadow-[0_4px_24px_rgba(1,173,159,0.5)] translate-y-4 opacity-0 pointer-events-none transition-all duration-300"
    aria-live="polite"
  >
    <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
    </svg>
    <span>ස්තූතියි! ඔබේ අදහස සාර්ථකව දැමුණා 🙏</span>
  </div>
</section>

{finalSimilarPosts.length > 0 && (
  <section class="section pt-12 pb-16 bg-gradient-to-b from-[#010203] via-[#022c16] to-[#010203] border-t border-white/5">
    <div class="container">
      <h2 class="mb-8 font-black text-center h4 text-[#F8F8FF]">
        ඔබ කැමති විය හැකි තවත් කතා
      </h2>
      <div class="row similar-posts-3d-grid">
        <SimilarPosts posts={finalSimilarPosts} />
      </div>
    </div>
  </section>
)}

<style is:global>
  .custom-post-content p,
  .custom-post-content span,
  .custom-post-content li,
  .custom-post-content strong,
  .custom-post-content h1,
  .custom-post-content h2,
  .custom-post-content h3,
  .custom-post-content h4 {
    color: #F8F8FF !important;
  }
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.1);
    border-radius: 99px;
  }
  .comment-float-btn {
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    animation: cfloat 3s ease-in-out infinite;
  }
  .comment-float-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 8px 32px rgba(1,173,159,0.55);
  }
  .comment-float-btn:active { transform: scale(0.95); }
  @keyframes cfloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-6px); }
  }
  .comment-btn-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgba(1,173,159,0.35);
    animation: cring 2s ease-out infinite;
    z-index: 0;
  }
  @keyframes cring {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .comment-warning-notice {
    background: linear-gradient(135deg, rgba(30,6,6,0.95) 0%, rgba(20,4,4,0.98) 100%);
    border: 1px solid rgba(239,68,68,0.25);
