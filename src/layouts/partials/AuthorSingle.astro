---
import Social from "@/components/Social.astro";
import { render } from "astro:content";

const { author } = Astro.props;
const { title, image, social } = author.data;
const { Content } = await render(author);

// NOTE: the duplicate JSON-LD ProfilePage schema block that used to live
// here was removed on purpose. authors/[single].astro is the single source
// of truth for that schema; emitting it from both places produced two
// ProfilePage nodes and a Rich Results Test error.
---

<section class="section py-16 select-none">
  <div class="container">
    <div class="max-w-3xl mx-auto border border-white/[0.04] bg-white/[0.01] p-8 sm:p-12 rounded-3xl backdrop-blur-sm text-center shadow-2xl">
      {
        image && (
          <div class="mb-6 relative inline-block">
            <div class="absolute inset-0 rounded-full bg-[#01AD9F]/20 blur-md transform scale-105"></div>
            {/*
              Plain <img>, not Astro's <Image />. The avatar is a
              public/images/authors/*.webp string path; Astro's <Image />
              requires an imported ImageMetadata object and renders a broken
              placeholder when given a public-folder string.
            */}
            <img
              src={image}
              class="relative mx-auto rounded-full border-2 border-[#01AD9F] object-cover shadow-xl transition duration-300 hover:scale-105"
              height="130"
              width="130"
              alt={`${title} - author avatar`}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }

      <h1 class="h3 mb-4 text-[#F8F8FF] font-black">{title}</h1>

      {
        social && (
          <div class="mb-6 flex justify-center">
            <Social source={social} className="social-icons" />
          </div>
        )
      }

      <hr class="my-8 border-white/[0.06]" />

      <div class="content text-left text-[#F8F8FF]/80 leading-relaxed">
        <Content />
      </div>
    </div>
  </div>
</section>
