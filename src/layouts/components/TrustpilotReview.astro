---
// WATCH SINHALA MOVIES PROMO CARD (footer widget)
//
// 2026-08 - IFRAME PERMANENTLY ABANDONED: teraboxpage.com refuses to
// be embedded in any cross-origin <iframe> (its own X-Frame-Options/
// CSP policy - identical limitation already documented for the
// earlier Trustpilot iframe attempt). The popup opens the movie
// collection as a normal new-tab link instead.
//
// 2026-08 SCROLL-LOCK: iOS-safe position:fixed body scroll-lock,
// implemented with a REFERENCE COUNTER so two stacked popups (the
// movie popup + the "What is TeraBox?" info popup opened from inside
// it) never prematurely unlock the background while the other popup
// is still open.
//
// 2026-08 NEW: "TeraBox කියන්නේ මොකක්ද?" info popup - a second modal,
// stacked above the movie popup (higher z-index), explaining that
// TeraBox is a Google-Drive-like cloud storage app, that signing up
// gives 1024GB (1TB) free storage, and that the movie collection can
// be saved into that free storage with one click for lifetime access.
//
// LINKS:
//   - Movie collection (opened directly in a new tab):
//     https://www.teraboxpage.com/myknow/sinhalawalvideo
//   - TeraBox official app (Google Play):
//     https://play.google.com/store/apps/details?id=com.dubox.drive
import { BiFilm, BiPlayCircle, BiDownload, BiLinkExternal, BiInfoCircle, BiCloud, BiCheckCircle } from "react-icons/bi";

const movieCollectionUrl = "https://www.teraboxpage.com/myknow/sinhalawalvideo";
const teraboxAppPlayStoreUrl = "https://play.google.com/store/apps/details?id=com.dubox.drive";
---

<section class="trustpilot-review-section" aria-label="Sinhala Movies Free">
  <div class="trustpilot-review-card">
    <span class="tp-card-glow" aria-hidden="true"></span>

    <div class="tp-icon-badge" aria-hidden="true">
      <BiFilm className="tp-icon-badge-svg" />
    </div>

    <h2 class="tp-heading">සිංහල චිත්‍රපට නොමිලේ නරඹන්න</h2>
    <p class="tp-subtext">
      අපි එකතු කරගත් සියලුම සිංහල චිත්‍රපට එකම තැනකින්, එකම Link එකකින්
      නරඹන්න පුළුවන් - කිසිම ගානක් නැතුව. පහත බටනය ක්ලික් කර දැන්ම නරඹන්න පටන් ගන්න!
    </p>

    <button
      id="movies-open-modal-btn"
      type="button"
      class="tp-review-now-btn"
    >
      <BiPlayCircle className="tp-review-now-icon" aria-hidden="true" />
      <span>දැන් නරඹන්න (Watch Now)</span>
    </button>
  </div>
</section>

<div
  id="movies-watch-modal"
  class="tp-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="movies-modal-title"
>
  <div class="tp-modal-card">
    <div class="tp-modal-header">
      <h3 id="movies-modal-title" class="tp-modal-title">
        <span class="tp-modal-dot" aria-hidden="true"></span>
        සිංහල චිත්‍රපට එකතුව
      </h3>
      <div class="tp-modal-header-actions">
        <button
          id="movies-modal-close-btn"
          type="button"
          class="tp-modal-close-btn"
          aria-label="Close"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="tp-modal-close-label">වහන්න</span>
        </button>
      </div>
    </div>

    <div class="tp-movie-notice" role="note">
      <span class="tp-movie-notice-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
          <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
        </svg>
      </span>
      <span class="tp-movie-notice-text">
        මෙහි ඇති චිත්‍රපට නැරඹීම සඳහා ඔබගේ දුරකථනයේ <strong>TeraBox Official App</strong> එක
        Install කරගෙන තිබිය යුතුය. Install කර නොමැති නම් පහත Download බටනය ක්ලික් කර App එක ලබාගන්න.
      </span>
      
        href={teraboxAppPlayStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tp-movie-download-btn"
      >
        <BiDownload className="tp-movie-download-icon" aria-hidden="true" />
        <span>TeraBox App Download</span>
      </a>
    </div>

    <div class="tp-modal-body">
      <div class="tp-cta-icon-badge" aria-hidden="true">
        <BiFilm className="tp-cta-icon-svg" />
      </div>
      <h4 class="tp-cta-heading">චිත්‍රපට එකතුව බලන්න සූදානම්ද?</h4>
      <p class="tp-cta-subtext">
        පහත බටනය ක්ලික් කළ විට, සිංහල චිත්‍රපට එකතුව අලුත් Tab එකකින්
        විවෘත වේ. TeraBox App එකෙන් ඔබට සියලුම චිත්‍රපට කෙලින්ම නරඹන්න පුළුවන්.
      </p>
      
        id="movies-open-link-btn"
        href={movieCollectionUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tp-cta-btn"
      >
        <BiLinkExternal className="tp-cta-btn-icon" aria-hidden="true" />
        <span>චිත්‍රපට එකතුව Open කරන්න</span>
      </a>
      <p class="tp-cta-url-hint">{movieCollectionUrl}</p>

      <button
        id="terabox-info-btn"
        type="button"
        class="tp-info-link-btn"
      >
        <BiInfoCircle className="tp-info-link-icon" aria-hidden="true" />
        <span>TeraBox කියන්නේ මොකක්ද?</span>
      </button>
    </div>
  </div>
</div>

<div
  id="terabox-info-modal"
  class="tp-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="terabox-info-title"
>
  <div class="tp-modal-card">
    <div class="tp-modal-header">
      <h3 id="terabox-info-title" class="tp-modal-title">
        <span class="tp-modal-dot" aria-hidden="true"></span>
        TeraBox කියන්නේ මොකක්ද?
      </h3>
      <div class="tp-modal-header-actions">
        <button
          id="terabox-info-close-btn"
          type="button"
          class="tp-modal-close-btn"
          aria-label="Close"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="tp-modal-close-label">වහන්න</span>
        </button>
      </div>
    </div>

    <div class="tp-modal-body tp-info-modal-body">
      <div class="tp-cta-icon-badge" aria-hidden="true">
        <BiCloud className="tp-cta-icon-svg" />
      </div>

      <p class="tp-info-paragraph">
        <strong>TeraBox</strong> කියන්නේ <strong>Google Drive</strong> වගේම ක්ලවුඩ් ස්ටෝරේජ්
        (Cloud Storage) ඇප් එකක්. ඔබට වීඩියෝ, ෆොටෝ, MP3 සින්දු, ඕනෑම ෆයිල් එකක් සහ
        තවත් බොහෝ දේවල් අන්තර්ජාලයේ ආරක්ෂිතව ගබඩා කරගන්න පුළුවන් අඩවියක්.
      </p>

      <ul class="tp-info-feature-list">
        <li>
          <BiCheckCircle className="tp-info-feature-icon" aria-hidden="true" />
          <span>
            App එක Download කරලා Sign Up උනාම, ඔබට <strong>1024 GB (1 TB)</strong>
            මෙමරි ස්පේස් එකක් සම්පූර්ණයෙන්ම නොමිලේ ලැබෙනවා.
          </span>
        </li>
        <li>
          <BiCheckCircle className="tp-info-feature-icon" aria-hidden="true" />
          <span>
            මේ නරඹන චිත්‍රපටිය බටනයක් Click කිරීමෙන් කෙලින්ම ඔබේ TeraBox ගිණුමට
            <strong>Save</strong> කරගන්න පුළුවන් - ඔබට ලැබෙන නොමිලේ Storage එක
            පිරෙනකම් ඕනෑ තරම් movies save කරගන්න පුළුවන්.
          </span>
        </li>
        <li>
          <BiCheckCircle className="tp-info-feature-icon" aria-hidden="true" />
          <span>
            Save කරගත්තහම ඒවා ඔබේ ගිණුමේ <strong>ජීවිත කාලයටම</strong> ආරක්ෂිතව
            තියෙනවා - ඔබට ඕනෑම වෙලාවක, ඕනෑම තැනක ඉඳන් නැවත බලාගන්න පුළුවන්.
          </span>
        </li>
        <li>
          <BiCheckCircle className="tp-info-feature-icon" aria-hidden="true" />
          <span>
            Site එකේ Link එකක් වෙනස් වුනත් හෝ file එකක් ඉවත් වුනත්, ඔබ Save
            කරගත්ත Copy එක ඔබේම ගිණුමේ ආරක්ෂිතව රැඳී තියෙනවා.
          </span>
        </li>
      </ul>

      <div class="tp-info-actions">
        
          href={teraboxAppPlayStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="tp-cta-btn tp-info-download-btn"
        >
          <BiDownload className="tp-cta-btn-icon" aria-hidden="true" />
          <span>TeraBox App එක Download කරන්න</span>
        </a>
        <button
          id="terabox-info-got-it-btn"
          type="button"
          class="tp-info-link-btn"
        >
          තේරුණා, හරි (Got it)
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .trustpilot-review-section {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .trustpilot-review-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(1, 173, 159, 0.18);
    background: linear-gradient(180deg, rgba(1, 173, 159, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .trustpilot-review-card:hover {
    border-color: rgba(1, 173, 159, 0.4);
    transform: translateY(-2px);
  }

  .tp-card-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(1, 173, 159, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .tp-icon-badge {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.85rem auto;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.35);
    box-shadow: 0 0 18px rgba(1, 173, 159, 0.25);
  }
  .tp-icon-badge-svg {
    color: #01ad9f;
    font-size: 1.5rem;
    filter: drop-shadow(0 0 6px rgba(1, 173, 159, 0.45));
  }

  .tp-heading {
    position: relative;
    z-index: 1;
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.5rem 0;
  }

  .tp-subtext {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  .tp-review-now-btn {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
    box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5);
  }
  .tp-review-now-btn:hover {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  .tp-review-now-btn:active {
    transform: translateY(0);
  }
  .tp-review-now-icon {
    font-size: 1.1rem;
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn span {
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg) translateX(0%);
    animation: tpShineSweep 3.2s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes tpShineSweep {
    0% { transform: skewX(-20deg) translateX(0%); }
    45% { transform: skewX(-20deg) translateX(475%); }
    100% { transform: skewX(-20deg) translateX(475%); }
  }

  :global(#trustpilot-thanks-toast) {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 16px);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(90vw, 380px);
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #f8f8ff;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    padding: 12px 20px;
    border-radius: 999px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(#trustpilot-thanks-toast.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global(#trustpilot-thanks-toast .tpt-star) {
    color: #01ad9f;
    font-size: 16px;
    flex-shrink: 0;
  }
  :global(#trustpilot-thanks-toast .tpt-text) {
    flex: 1;
  }

  /* Modal-related styles are :global() because both modals are moved
     to document.body at runtime (see teleportModal() in the script
     below) to escape Footer.astro's backdrop-blur containing-block
     bug - once moved they are no longer descendants of this
     component's own scoped root. */
  :global(.tp-modal-overlay) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }
  :global(.tp-modal-overlay.hidden) {
    display: none;
  }
  :global(.tp-modal-overlay.is-open) {
    opacity: 1;
    pointer-events: auto;
  }

  /* The "What is TeraBox?" info popup stacks ABOVE the movie popup
     (which stays open in the background behind it) - a strictly
     higher z-index guarantees it always renders on top whenever both
     happen to be open at once. */
  :global(#terabox-info-modal.tp-modal-overlay) {
    z-index: 100000;
  }

  :global(.tp-modal-card) {
    width: 100%;
    max-width: 42rem;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    background: #0c0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  @supports (height: 100dvh) {
    :global(.tp-modal-card) {
      max-height: 85dvh;
    }
  }

  :global(.tp-modal-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  :global(.tp-modal-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0;
  }

  :global(.tp-modal-dot) {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #01ad9f;
    flex-shrink: 0;
  }

  :global(.tp-modal-header-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.tp-modal-close-btn) {
