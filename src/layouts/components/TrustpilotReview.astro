---
// TRUSTPILOT REVIEW COLLECTOR - theme-matched card + in-site modal.
// The official Trustpilot TrustBox widget code (data-locale,
// data-template-id, data-businessunit-id, data-style-height/width,
// data-token) below is kept byte-for-byte identical to what
// Trustpilot itself provides - do not modify those attributes.
//
// 2026-08 FIX ROUND: two confirmed bugs from live testing.
// 1) The modal iframe stayed blank because the open-modal logic used
//    `if (iframe && !iframe.src)` to decide whether to set the real
//    Trustpilot URL. Per the HTML spec, reading `.src` off an
//    `<iframe src="">` returns the resolved current-page URL (a
//    truthy string), never an empty string - so that condition was
//    always false and the real URL was never assigned. Fixed by using
//    a dedicated `data-loaded` flag instead of trusting `.src`.
// 2) The modal close button relied only on an icon component that did
//    not reliably render. Replaced with a plain inline SVG plus a
//    visible "close" text label, so the button always has a clear,
//    working way to dismiss the modal even if icon rendering fails.
//
// Also added: a loading spinner while the iframe loads, an 8-second
// timeout fallback link (Trustpilot page in a new tab) in case the
// iframe genuinely cannot load, a small animated shine-sweep line on
// the Review Now button, and a dvh-based viewport height fix for
// mobile browsers whose address bar resizes the visible viewport.
//
// 2026-08 SECOND FIX ROUND (root cause: CSS containing-block bug):
// This component renders inside Footer.astro, and the <footer>
// element there carries a `backdrop-blur-xl` class (backdrop-filter).
// Per the CSS spec, an ancestor with `filter` or `backdrop-filter`
// creates a new containing block for any descendant that uses
// `position: fixed` - so this modal's `position: fixed` overlay was
// actually being positioned relative to the footer box, not the real
// viewport. Combined with the footer's own overflow clipping, this
// caused three visible symptoms: the popup rendering as a small
// clipped box instead of a true fullscreen overlay, the close button
// becoming unreachable, and the modal body being unable to scroll
// far enough to reach the submit button.
//
// Fix: on open, the modal's root element is moved (once) directly
// under `document.body` via plain DOM `appendChild` - the same effect
// a React portal gives, without needing React here. This makes the
// modal a true top-level fixed overlay again, with zero change to
// Footer.astro's own visual design (backdrop-blur stays exactly as
// it was). The move happens once per page load and is idempotent -
// re-opening the modal on the same page does not move it again.
//
// 2026-08 THIRD FIX ROUND (PageSpeed - critical network dependency
// chain + inefficient cache lifetime, both flagged against
// widget.trustpilot.com's main.js/bootstrap.min.js files):
// ROOT CAUSE: the Trustpilot bootstrap script was previously loaded
// unconditionally the moment the page finished loading, via
// initTrustpilotWidget() running on every astro:page-load event. This
// script sits below the fold inside Footer.astro, so fetching it
// eagerly on every single page view added it to the initial critical
// request chain for no real benefit - most visitors never scroll far
// enough to see the small inline star rating widget it renders.
// This site does not control widget.trustpilot.com's own
// Cache-Control headers (that part of the PageSpeed finding is a
// third-party limitation, not fixable from this codebase), but it
// does control WHEN the script is requested.
// FIX: the bootstrap script now loads lazily via IntersectionObserver,
// only once the review card scrolls within 300px of the viewport.
// This removes the script entirely from the initial page-load network
// chain for the common case, while the modal (open on click) is
// unaffected since it uses the embedded review-form iframe directly
// and never depended on the bootstrap script.
import { BiStar } from "react-icons/bi";
const reviewDomain = "walakatha.net";
const embeddedReviewFormUrl = `https://www.trustpilot.com/evaluate/embed/${reviewDomain}`;
---

<section class="trustpilot-review-section" aria-label="Trustpilot Reviews">
  <div class="trustpilot-review-card">
    <span class="tp-card-glow" aria-hidden="true"></span>

    <div class="tp-stars" aria-hidden="true">
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
    </div>

    <h2 class="tp-heading">ඔබත් අපිව අගය කරන්නද?</h2>
    <p class="tp-subtext">
      Wala Katha ගැන ඔබේ අත්දැකීම තත්පර කිහිපයකින් Trustpilot හි බෙදාගන්න -
      එය අපිට තව හොඳ කරන්නත්, තව දහස් ගණන් පාඨකයන්ට අපිව හඳුනා ගන්නත් ලොකු උදව්වක්!
    </p>

    <button
      id="trustpilot-open-modal-btn"
      type="button"
      class="tp-review-now-btn"
    >
      <BiStar className="tp-review-now-icon" aria-hidden="true" />
      <span>Review එකක් දෙන්න (Review Now)</span>
    </button>

    <div
      id="trustpilot-widget-container"
      class="trustpilot-widget"
      data-locale="en-US"
      data-template-id="56278e9abfbbba0bdcd568bc"
      data-businessunit-id="6a718943c72aab296e860f07"
      data-style-height="52px"
      data-style-width="100%"
      data-token="b99ae46b-0b83-4431-9614-313deb05b559"
    >
      <a href="https://www.trustpilot.com/review/walakatha.net" target="_blank" rel="noopener">
        Trustpilot
      </a>
    </div>
  </div>
</section>

<div
  id="trustpilot-review-modal"
  class="tp-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="trustpilot-modal-title"
>
  <div class="tp-modal-card">
    <div class="tp-modal-header">
      <h3 id="trustpilot-modal-title" class="tp-modal-title">
        <span class="tp-modal-dot" aria-hidden="true"></span>
        ඔබේ Review එක Trustpilot හි දාන්න
      </h3>
      <button
        id="trustpilot-modal-close-btn"
        type="button"
        class="tp-modal-close-btn"
        aria-label="Close review form"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
        <span class="tp-modal-close-label">වහන්න</span>
      </button>
    </div>
    <div class="tp-modal-body">
      <div id="trustpilot-modal-loading" class="tp-modal-loading">
        <span class="tp-spinner" aria-hidden="true"></span>
        <p class="tp-loading-text">Review පෝරමය පූරණය වෙමින්...</p>
      </div>
      <div id="trustpilot-modal-fallback" class="tp-modal-fallback hidden">
        <p>මෙය පූරණය වීමට වැඩි කාලයක් ගතවෙයි.</p>
        <a
          href={embeddedReviewFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="tp-fallback-link"
        >
          Trustpilot වෙබ් අඩවියටම කෙලින්ම යන්න
        </a>
      </div>
      <iframe
        id="trustpilot-modal-iframe"
        src=""
        data-src={embeddedReviewFormUrl}
        data-loaded="false"
        title="Trustpilot Review Form"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .trustpilot-review-section {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .trustpilot-review-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(1, 173, 159, 0.18);
    background: linear-gradient(180deg, rgba(1, 173, 159, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .trustpilot-review-card:hover {
    border-color: rgba(1, 173, 159, 0.4);
    transform: translateY(-2px);
  }

  .tp-card-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(1, 173, 159, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .tp-stars {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }
  .tp-star {
    color: #01ad9f;
    font-size: 1.15rem;
    filter: drop-shadow(0 0 6px rgba(1, 173, 159, 0.45));
  }

  .tp-heading {
    position: relative;
    z-index: 1;
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.5rem 0;
  }

  .tp-subtext {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Review Now button - now with an animated shine-sweep line so it
     draws attention. overflow:hidden clips the sweep element inside
     the button's own rounded shape. */
  .tp-review-now-btn {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    margin-bottom: 1.25rem;
    transition: background-color 0.25s ease, transform 0.25s ease;
    box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5);
  }
  .tp-review-now-btn:hover {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  .tp-review-now-btn:active {
    transform: translateY(0);
  }
  .tp-review-now-icon {
    font-size: 1rem;
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn span {
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg);
    animation: tpShineSweep 3.2s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes tpShineSweep {
    0% { left: -60%; }
    45% { left: 130%; }
    100% { left: 130%; }
  }

  .trustpilot-widget {
    position: relative;
    z-index: 1;
  }

  :global(#trustpilot-thanks-toast) {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 16px);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(90vw, 380px);
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #f8f8ff;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    padding: 12px 20px;
    border-radius: 999px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(#trustpilot-thanks-toast.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global(#trustpilot-thanks-toast .tpt-star) {
    color: #01ad9f;
    font-size: 16px;
    flex-shrink: 0;
  }
  :global(#trustpilot-thanks-toast .tpt-text) {
    flex: 1;
  }

  /* 2026-08: modal-related styles below are written as :global()
     because, once the modal is moved to document.body at runtime
     (see the script's teleportModalToBody function), it is no
     longer a descendant of this component's own scoped root, so
     Astro's default scoped CSS would no longer match it. Using
     :global() here keeps the exact same visual styling working
     correctly both before and after the DOM move - zero visual
     change, this is purely a selector-scoping fix required by the
     teleport approach. */
  :global(.tp-modal-overlay) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  :global(.tp-modal-overlay.hidden) {
    display: none;
  }
  :global(.tp-modal-overlay.is-open) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.tp-modal-card) {
    width: 100%;
    max-width: 42rem;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    background: #0c0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  @supports (height: 100dvh) {
    :global(.tp-modal-card) {
      max-height: 85dvh;
    }
  }

  :global(.tp-modal-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  :global(.tp-modal-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0;
  }

  :global(.tp-modal-dot) {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #01ad9f;
    flex-shrink: 0;
  }

  :global(.tp-modal-close-btn) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(248, 248, 255, 0.75);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }
  :global(.tp-modal-close-btn:hover) {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
    border-color: rgba(248, 113, 113, 0.35);
  }
  :global(.tp-modal-close-label) {
    font-size: 0.75rem;
    font-weight: 700;
  }

  :global(.tp-modal-body) {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #ffffff;
  }

  :global(.tp-modal-body iframe) {
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: none;
    display: block;
    position: relative;
    z-index: 1;
  }
  @supports (height: 100dvh) {
    :global(.tp-modal-body iframe) {
      height: 70dvh;
    }
  }

  :global(.tp-modal-loading) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: #ffffff;
    z-index: 2;
  }
  :global(.tp-spinner) {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 3px solid rgba(1, 173, 159, 0.15);
    border-top-color: #01ad9f;
    animation: tpSpin 0.8s linear infinite;
  }
  @keyframes tpSpin {
    to { transform: rotate(360deg); }
  }
  :global(.tp-loading-text) {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #333333;
  }

  :global(.tp-modal-fallback) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: #ffffff;
    z-index: 2;
    padding: 1.5rem;
    text-align: center;
  }
  :global(.tp-modal-fallback.hidden) {
    display: none;
  }
  :global(.tp-modal-fallback p) {
    margin: 0;
    font-size: 0.85rem;
    color: #333333;
    font-weight: 600;
  }
  :global(.tp-fallback-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #01ad9f;
    color: #010203;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .trustpilot-review-card {
      transition: none;
    }
    :global(#trustpilot-thanks-toast) {
      transition: none;
    }
    :global(.tp-modal-overlay) {
      transition: none;
    }
    .tp-review-now-btn::after {
      animation: none;
      display: none;
    }
    :global(.tp-spinner) {
      animation: none;
      border-top-color: rgba(1, 173, 159, 0.4);
    }
  }
</style>

<script>
  const TRUSTPILOT_SCRIPT_SRC = "https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js";
  const THANKS_STORAGE_KEY = "wk-trustpilot-clicked-at";
  const THANKS_MIN_AWAY_MS = 2500;
  const MODAL_MIN_OPEN_MS = 8000;
  const MODAL_LOAD_TIMEOUT_MS = 8000;
  const WIDGET_LAZY_ROOT_MARGIN = "300px 0px";

  function ensureTrustpilotScriptLoaded(onReady: () => void) {
    const w = window as any;
    if (w.Trustpilot) {
      onReady();
      return;
    }
    const existing = document.querySelector(`script[src="${TRUSTPILOT_SCRIPT_SRC}"]`);
    if (existing) {
      existing.addEventListener("load", onReady, { once: true });
      return;
    }
    const script = document.createElement("script");
    script.src = TRUSTPILOT_SCRIPT_SRC;
    script.async = true;
    script.addEventListener("load", onReady, { once: true });
    document.head.appendChild(script);
  }

  function showTrustpilotThanksToast() {
    let toast = document.getElementById("trustpilot-thanks-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "trustpilot-thanks-toast";
      toast.setAttribute("role", "status");
      toast.setAttribute("aria-live", "polite");

      const star = document.createElement("span");
      star.className = "tpt-star";
      star.setAttribute("aria-hidden", "true");
      star.textContent = "*";

      const text = document.createElement("span");
      text.className = "tpt-text";
      text.textContent = "ඔබගේ අගයන කාලයට ගොඩක් ස්තූතියි!";

      toast.appendChild(star);
      toast.appendChild(text);
      document.body.appendChild(toast);
    }

    toast.classList.add("show");
    clearTimeout((toast as any)._hideTimer);
    (toast as any)._hideTimer = setTimeout(() => {
      toast?.classList.remove("show");
    }, 4000);
  }

  // NEW (PageSpeed - Network dependency tree + cache lifetime fix):
  // module-scoped observer reference so it can be disconnected on
  // every astro:before-swap, same cleanup convention already used
  // elsewhere in this codebase (Header.astro's outsideClickHandler,
  // PostSingle.astro's timers) to avoid a stale observer referencing
  // a detached DOM node after a client-side navigation.
  let trustpilotWidgetObserver: IntersectionObserver | null = null;

  function initTrustpilotWidget() {
    const container = document.getElementById("trustpilot-widget-container");
    if (!container) return;

    function loadWidgetScript() {
      ensureTrustpilotScriptLoaded(() => {
        const w = window as any;
        if (w.Trustpilot && typeof w.Trustpilot.loadFromElement === "function") {
          w.Trustpilot.loadFromElement(container, true);
        }
      });
    }

    // Disconnect any observer left over from a previous page (View
    // Transitions navigation) before creating a new one for the
    // current page's container element.
    if (trustpilotWidgetObserver) {
      trustpilotWidgetObserver.disconnect();
      trustpilotWidgetObserver = null;
    }

    // LAZY LOAD: the bootstrap script is only requested once this
    // card scrolls within 300px of the viewport, instead of on every
    // page load regardless of scroll position. This removes the
    // script from the initial critical network dependency chain for
    // the common case where a visitor never scrolls to the footer.
    if (typeof IntersectionObserver === "function") {
      trustpilotWidgetObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              loadWidgetScript();
              observer.disconnect();
            }
          }
        },
        { rootMargin: WIDGET_LAZY_ROOT_MARGIN }
      );
      trustpilotWidgetObserver.observe(container);
    } else {
      // Older browsers without IntersectionObserver support - fall
      // back to the previous eager-load behavior so the widget still
      // renders correctly.
      loadWidgetScript();
    }

    container.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (target && target.closest && target.closest("a")) {
        try {
          sessionStorage.setItem(THANKS_STORAGE_KEY, String(Date.now()));
        } catch {
          // Storage unavailable in some private-browsing modes - non-fatal.
        }
      }
    });
  }

  function checkReturnFromTrustpilot() {
    if (document.visibilityState !== "visible") return;

    let clickedAt: string | null;
    try {
      clickedAt = sessionStorage.getItem(THANKS_STORAGE_KEY);
    } catch {
      clickedAt = null;
    }
    if (!clickedAt) return;

    const elapsed = Date.now() - Number(clickedAt);
    try {
      sessionStorage.removeItem(THANKS_STORAGE_KEY);
    } catch {
      // Non-fatal.
    }

    if (elapsed > THANKS_MIN_AWAY_MS) {
      showTrustpilotThanksToast();
    }
  }

  let modalOpenedAt = 0;
  let modalLoadTimeoutId: ReturnType<typeof setTimeout> | null = null;

  function getModalLoadingEl() {
    return document.getElementById("trustpilot-modal-loading");
  }
  function getModalFallbackEl() {
    return document.getElementById("trustpilot-modal-fallback");
  }

  function resetModalLoadingUi() {
    const loading = getModalLoadingEl();
    const fallback = getModalFallbackEl();
    if (loading) loading.style.display = "flex";
    if (fallback) fallback.classList.add("hidden");
  }

  function hideModalLoadingUi() {
    const loading = getModalLoadingEl();
    if (loading) loading.style.display = "none";
  }

  function showModalFallbackUi() {
    const loading = getModalLoadingEl();
    const fallback = getModalFallbackEl();
    if (loading) loading.style.display = "none";
    if (fallback) fallback.classList.remove("hidden");
  }

  function clearModalLoadTimeout() {
    if (modalLoadTimeoutId) {
      clearTimeout(modalLoadTimeoutId);
      modalLoadTimeoutId = null;
    }
  }

  // ROOT-CAUSE FIX: Footer.astro's <footer> element uses
  // backdrop-blur-xl (backdrop-filter), which per the CSS spec makes
  // it a new containing block for any descendant using
  // `position: fixed`. Since this modal originally lived inside
  // Footer.astro's render tree, its "fixed" overlay was being
  // positioned relative to the footer box instead of the real
  // viewport - causing the popup to render clipped/small, the close
  // button to become unreachable, and the body to be unable to
  // scroll far enough to reach the submit button.
  //
  // Fix: move the modal's root element to be a direct child of
  // document.body at runtime. This is idempotent - if it has already
  // been moved (checked via a data attribute), it is not moved again.
  // No visual/behavioral change to Footer.astro itself is needed.
  function teleportModalToBody() {
    const overlay = document.getElementById("trustpilot-review-modal");
    if (!overlay) return;
    if (overlay.parentElement === document.body) return;
    document.body.appendChild(overlay);
  }

  function openTrustpilotModal() {
    teleportModalToBody();

    const overlay = document.getElementById("trustpilot-review-modal");
    const iframe = document.getElementById("trustpilot-modal-iframe") as HTMLIFrameElement | null;
    if (!overlay) return;

    resetModalLoadingUi();

    // Use a dedicated data-loaded flag instead of checking iframe.src,
    // since reading .src off an <iframe src=""> always resolves to a
    // truthy current-page URL string, never an empty value.
    if (iframe && iframe.dataset.loaded !== "true") {
      const dataSrc = iframe.getAttribute("data-src");
      if (dataSrc) {
        iframe.src = dataSrc;
      }
    } else if (iframe && iframe.dataset.loaded === "true") {
      hideModalLoadingUi();
    }

    overlay.classList.remove("hidden");
    overlay.style.display = "flex";
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    modalOpenedAt = Date.now();
    document.body.style.overflow = "hidden";

    clearModalLoadTimeout();
    if (iframe && iframe.dataset.loaded !== "true") {
      modalLoadTimeoutId = setTimeout(() => {
        if (iframe.dataset.loaded !== "true") {
          showModalFallbackUi();
        }
      }, MODAL_LOAD_TIMEOUT_MS);
    }
  }

  function closeTrustpilotModal() {
    const overlay = document.getElementById("trustpilot-review-modal");
    if (!overlay) return;

    overlay.classList.remove("is-open");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.style.display = "none";
    }, 300);
    document.body.style.overflow = "";

    clearModalLoadTimeout();

    if (modalOpenedAt && Date.now() - modalOpenedAt > MODAL_MIN_OPEN_MS) {
      showTrustpilotThanksToast();
    }
    modalOpenedAt = 0;
  }

  function handleIframeLoaded() {
    const iframe = document.getElementById("trustpilot-modal-iframe") as HTMLIFrameElement | null;
    if (iframe) iframe.dataset.loaded = "true";
    clearModalLoadTimeout();
    hideModalLoadingUi();
  }

  function initTrustpilotModal() {
    // Move the modal out of Footer.astro's filtered/clipped subtree
    // as early as possible on every page load, not only on first
    // open - this guarantees the overlay is always a direct child of
    // <body> before any user interaction happens.
    teleportModalToBody();

    const openBtn = document.getElementById("trustpilot-open-modal-btn");
    const closeBtn = document.getElementById("trustpilot-modal-close-btn");
    const overlay = document.getElementById("trustpilot-review-modal");
    const iframe = document.getElementById("trustpilot-modal-iframe") as HTMLIFrameElement | null;
    if (!openBtn || !closeBtn || !overlay) return;

    const freshOpenBtn = openBtn.cloneNode(true) as HTMLButtonElement;
    openBtn.parentNode?.replaceChild(freshOpenBtn, openBtn);
    freshOpenBtn.addEventListener("click", openTrustpilotModal);

    const freshCloseBtn = closeBtn.cloneNode(true) as HTMLButtonElement;
    closeBtn.parentNode?.replaceChild(freshCloseBtn, closeBtn);
    freshCloseBtn.addEventListener("click", closeTrustpilotModal);

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeTrustpilotModal();
    });

    if (iframe) {
      iframe.addEventListener("load", handleIframeLoaded);
    }
  }

  document.addEventListener("astro:page-load", initTrustpilotWidget);
  document.addEventListener("astro:page-load", initTrustpilotModal);

  // NEW: disconnect the lazy-load observer when navigating away via
  // View Transitions, so it never keeps watching a detached container
  // element from a previous page.
  document.addEventListener("astro:before-swap", () => {
    if (trustpilotWidgetObserver) {
      trustpilotWidgetObserver.disconnect();
      trustpilotWidgetObserver = null;
    }
  });

  if (!(window as any).__wkTrustpilotEscapeBound) {
    (window as any).__wkTrustpilotEscapeBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const overlay = document.getElementById("trustpilot-review-modal");
      if (overlay && overlay.classList.contains("is-open")) {
        closeTrustpilotModal();
      }
    });
  }

  if (!(window as any).__wkTrustpilotVisibilityBound) {
    (window as any).__wkTrustpilotVisibilityBound = true;
    document.addEventListener("visibilitychange", checkReturnFromTrustpilot);
  }
</script>
