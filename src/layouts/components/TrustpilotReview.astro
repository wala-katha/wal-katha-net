---
// WATCH SINHALA MOVIES PROMO CARD (footer widget)
//
// 2026-08 FIX (Iframe embed permanently abandoned - root cause):
// teraboxpage.com sends its own X-Frame-Options / CSP frame-ancestors
// header that refuses to be rendered inside ANY cross-origin <iframe>,
// regardless of what CSP frame-src we allow on our own origin. This is
// identical to the Trustpilot iframe problem already solved elsewhere
// in this codebase - see the history note below. There is no
// workaround for this: the site being embedded controls that policy,
// not us. The permanent fix is a direct link opened in a new tab
// instead of an iframe embed.
//
// HISTORY: this component used to be a Trustpilot review-collector
// card, later repurposed to a movie-collection promo that tried to
// load teraboxpage.com inside a popup-modal <iframe>. That iframe
// approach is now removed entirely and replaced with a lightweight
// "open in new tab" call-to-action inside the same popup-modal shell
// (same card/glow/star styling, same robustness fixes retained).
//
// 2026-08 SCROLL-LOCK FIX: previously the modal locked background
// scroll via `document.body.style.overflow = "hidden"`, which does
// not reliably block touch-drag scrolling on iOS Safari / many mobile
// browsers. Replaced with an iOS-safe position:fixed scroll-lock
// (save scroll position, pin body, restore position on close).
//
// LINKS:
//   - Movie collection (opened directly in a new tab):
//     https://www.teraboxpage.com/myknow/sinhalawalvideo
//   - TeraBox official app (Google Play):
//     https://play.google.com/store/apps/details?id=com.dubox.drive
import { BiFilm, BiPlayCircle, BiDownload, BiLinkExternal } from "react-icons/bi";

const movieCollectionUrl = "https://www.teraboxpage.com/myknow/sinhalawalvideo";
const teraboxAppPlayStoreUrl = "https://play.google.com/store/apps/details?id=com.dubox.drive";
---

<section class="trustpilot-review-section" aria-label="Sinhala Movies Free">
  <div class="trustpilot-review-card">
    <span class="tp-card-glow" aria-hidden="true"></span>

    <div class="tp-icon-badge" aria-hidden="true">
      <BiFilm className="tp-icon-badge-svg" />
    </div>

    <h2 class="tp-heading">සිංහල චිත්‍රපට නොමිලේ නරඹන්න</h2>
    <p class="tp-subtext">
      අපි එකතු කරගත් සියලුම සිංහල චිත්‍රපට එකම තැනකින්, එකම Link එකකින්
      නරඹන්න පුළුවන් - කිසිම ගානක් නැතුව. පහත බටනය ක්ලික් කර දැන්ම නරඹන්න පටන් ගන්න!
    </p>

    <button
      id="movies-open-modal-btn"
      type="button"
      class="tp-review-now-btn"
    >
      <BiPlayCircle className="tp-review-now-icon" aria-hidden="true" />
      <span>දැන් නරඹන්න (Watch Now)</span>
    </button>
  </div>
</section>

<div
  id="movies-watch-modal"
  class="tp-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="movies-modal-title"
>
  <div class="tp-modal-card">
    <div class="tp-modal-header">
      <h3 id="movies-modal-title" class="tp-modal-title">
        <span class="tp-modal-dot" aria-hidden="true"></span>
        සිංහල චිත්‍රපට එකතුව
      </h3>
      <div class="tp-modal-header-actions">
        <button
          id="movies-modal-close-btn"
          type="button"
          class="tp-modal-close-btn"
          aria-label="Close"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="tp-modal-close-label">වහන්න</span>
        </button>
      </div>
    </div>

    <div class="tp-movie-notice" role="note">
      <span class="tp-movie-notice-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
          <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
        </svg>
      </span>
      <span class="tp-movie-notice-text">
        මෙහි ඇති චිත්‍රපට නැරඹීම සඳහා ඔබගේ දුරකථනයේ <strong>TeraBox Official App</strong> එක
        Install කරගෙන තිබිය යුතුය. Install කර නොමැති නම් පහත Download බටනය ක්ලික් කර App එක ලබාගන්න.
      </span>
      
        href={teraboxAppPlayStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tp-movie-download-btn"
      >
        <BiDownload className="tp-movie-download-icon" aria-hidden="true" />
        <span>TeraBox App Download</span>
      </a>
    </div>

    <div class="tp-modal-body">
      <div class="tp-cta-icon-badge" aria-hidden="true">
        <BiFilm className="tp-cta-icon-svg" />
      </div>
      <h4 class="tp-cta-heading">චිත්‍රපට එකතුව බලන්න සූදානම්ද?</h4>
      <p class="tp-cta-subtext">
        පහත බටනය ක්ලික් කළ විට, සිංහල චිත්‍රපට එකතුව අලුත් Tab එකකින්
        විවෘත වේ. TeraBox App එකෙන් ඔබට සියලුම චිත්‍රපට කෙලින්ම නරඹන්න පුළුවන්.
      </p>
      
        id="movies-open-link-btn"
        href={movieCollectionUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tp-cta-btn"
      >
        <BiLinkExternal className="tp-cta-btn-icon" aria-hidden="true" />
        <span>චිත්‍රපට එකතුව Open කරන්න</span>
      </a>
      <p class="tp-cta-url-hint">{movieCollectionUrl}</p>
    </div>
  </div>
</div>

<style>
  .trustpilot-review-section {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .trustpilot-review-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(1, 173, 159, 0.18);
    background: linear-gradient(180deg, rgba(1, 173, 159, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .trustpilot-review-card:hover {
    border-color: rgba(1, 173, 159, 0.4);
    transform: translateY(-2px);
  }

  .tp-card-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(1, 173, 159, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .tp-icon-badge {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.85rem auto;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.35);
    box-shadow: 0 0 18px rgba(1, 173, 159, 0.25);
  }
  .tp-icon-badge-svg {
    color: #01ad9f;
    font-size: 1.5rem;
    filter: drop-shadow(0 0 6px rgba(1, 173, 159, 0.45));
  }

  .tp-heading {
    position: relative;
    z-index: 1;
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.5rem 0;
  }

  .tp-subtext {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  .tp-review-now-btn {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
    box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5);
  }
  .tp-review-now-btn:hover {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  .tp-review-now-btn:active {
    transform: translateY(0);
  }
  .tp-review-now-icon {
    font-size: 1.1rem;
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn span {
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg) translateX(0%);
    animation: tpShineSweep 3.2s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes tpShineSweep {
    0% { transform: skewX(-20deg) translateX(0%); }
    45% { transform: skewX(-20deg) translateX(475%); }
    100% { transform: skewX(-20deg) translateX(475%); }
  }

  :global(#trustpilot-thanks-toast) {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 16px);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(90vw, 380px);
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #f8f8ff;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    padding: 12px 20px;
    border-radius: 999px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(#trustpilot-thanks-toast.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global(#trustpilot-thanks-toast .tpt-star) {
    color: #01ad9f;
    font-size: 16px;
    flex-shrink: 0;
  }
  :global(#trustpilot-thanks-toast .tpt-text) {
    flex: 1;
  }

  /* Modal-related styles are :global() because the modal is moved to
     document.body at runtime (see teleportModalToBody in the script
     below) to escape Footer.astro's backdrop-blur containing-block
     bug - once moved it is no longer a descendant of this
     component's own scoped root. */
  :global(.tp-modal-overlay) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }
  :global(.tp-modal-overlay.hidden) {
    display: none;
  }
  :global(.tp-modal-overlay.is-open) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.tp-modal-card) {
    width: 100%;
    max-width: 42rem;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    background: #0c0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  @supports (height: 100dvh) {
    :global(.tp-modal-card) {
      max-height: 85dvh;
    }
  }

  :global(.tp-modal-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  :global(.tp-modal-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0;
  }

  :global(.tp-modal-dot) {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #01ad9f;
    flex-shrink: 0;
  }

  :global(.tp-modal-header-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.tp-modal-close-btn) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(248, 248, 255, 0.75);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }
  :global(.tp-modal-close-btn:hover) {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
    border-color: rgba(248, 113, 113, 0.35);
  }
  :global(.tp-modal-close-label) {
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Notice banner - TeraBox app requirement + download button. */
  :global(.tp-movie-notice) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    background: rgba(245, 158, 11, 0.08);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
    flex-shrink: 0;
  }
  :global(.tp-movie-notice-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    flex-shrink: 0;
  }
  :global(.tp-movie-notice-text) {
    flex: 1 1 14rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgba(248, 248, 255, 0.85);
  }
  :global(.tp-movie-notice-text strong) {
    color: #fbbf24;
  }
  :global(.tp-movie-download-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #fbbf24;
    color: #010203;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  :global(.tp-movie-download-btn:hover) {
    background: #fcd34d;
    transform: translateY(-1px);
  }
  :global(.tp-movie-download-icon) {
    font-size: 0.95rem;
  }

  /* 2026-08: modal body is now a self-contained "open in new tab" CTA
     card (no iframe), matching the site's own dark theme instead of a
     jarring white embedded page. overscroll-behavior:contain +
     touch-action:pan-y stop any drag gesture inside the card from
     ever chaining/bubbling into the locked background page. */
  :global(.tp-modal-body) {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    touch-action: pan-y;
    background: #0c0d10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.75rem;
    gap: 0.5rem;
  }

  :global(.tp-cta-icon-badge) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.5rem;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.1);
    border: 1px solid rgba(1, 173, 159, 0.3);
    box-shadow: 0 0 24px rgba(1, 173, 159, 0.2);
  }
  :global(.tp-cta-icon-svg) {
    color: #01ad9f;
    font-size: 1.9rem;
    filter: drop-shadow(0 0 6px rgba(1, 173, 159, 0.45));
  }

  :global(.tp-cta-heading) {
    font-size: 1.1rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.4rem 0;
  }

  :global(.tp-cta-subtext) {
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.4rem 0;
    max-width: 26rem;
  }

  :global(.tp-cta-btn) {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 28px -8px rgba(1, 173, 159, 0.55);
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  :global(.tp-cta-btn:hover) {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  :global(.tp-cta-btn:active) {
    transform: translateY(0);
  }
  :global(.tp-cta-btn-icon) {
    font-size: 1.15rem;
  }

  :global(.tp-cta-url-hint) {
    margin: 1rem 0 0 0;
    font-size: 0.7rem;
    color: rgba(248, 248, 255, 0.35);
    word-break: break-all;
    max-width: 24rem;
  }

  @media (max-width: 480px) {
    :global(.tp-movie-notice) {
      flex-direction: column;
      align-items: flex-start;
    }
    :global(.tp-movie-download-btn) {
      width: 100%;
      justify-content: center;
    }
    :global(.tp-cta-btn) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trustpilot-review-card {
      transition: none;
    }
    :global(#trustpilot-thanks-toast) {
      transition: none;
    }
    :global(.tp-modal-overlay) {
      transition: none;
    }
    .tp-review-now-btn::after {
      animation: none;
      display: none;
    }
  }
</style>

<script>
  function showMoviesThanksToast() {
    let toast = document.getElementById("trustpilot-thanks-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "trustpilot-thanks-toast";
      toast.setAttribute("role", "status");
      toast.setAttribute("aria-live", "polite");

      const star = document.createElement("span");
      star.className = "tpt-star";
      star.setAttribute("aria-hidden", "true");
      star.textContent = "*";

      const text = document.createElement("span");
      text.className = "tpt-text";
      text.textContent = "යැව්වා! 🎬 TeraBox App එකෙන් චිත්‍රපටිය නරඹන්න.";

      toast.appendChild(star);
      toast.appendChild(text);
      document.body.appendChild(toast);
    }

    toast.classList.add("show");
    clearTimeout((toast as any)._hideTimer);
    (toast as any)._hideTimer = setTimeout(() => {
      toast?.classList.remove("show");
    }, 4000);
  }

  // 2026-08 iOS-SAFE SCROLL LOCK: plain `overflow:hidden` on body does
  // not reliably block touch-drag scrolling on iOS Safari / many
  // mobile WebViews. This pins the body with position:fixed at its
  // current scroll offset (visually identical, but genuinely
  // unscrollable), then restores the exact scroll position on unlock.
  let savedScrollY = 0;
  let isScrollLocked = false;

  function lockBodyScroll() {
    if (isScrollLocked) return;
    savedScrollY = window.scrollY || window.pageYOffset || 0;
    const body = document.body;
    body.style.position = "fixed";
    body.style.top = `-${savedScrollY}px`;
    body.style.left = "0";
    body.style.right = "0";
    body.style.width = "100%";
    isScrollLocked = true;
  }

  function unlockBodyScroll() {
    if (!isScrollLocked) return;
    const body = document.body;
    body.style.position = "";
    body.style.top = "";
    body.style.left = "";
    body.style.right = "";
    body.style.width = "";
    isScrollLocked = false;
    window.scrollTo(0, savedScrollY);
  }

  // ROOT-CAUSE FIX (kept from the original Trustpilot component):
  // Footer.astro's <footer> uses backdrop-blur-xl (backdrop-filter),
  // which per the CSS spec makes it a new containing block for any
  // descendant using position:fixed. Moving the modal to be a direct
  // child of document.body at runtime restores it as a true
  // viewport-fixed overlay. Idempotent - safe to call on every open.
  function teleportModalToBody() {
    const overlay = document.getElementById("movies-watch-modal");
    if (!overlay) return;
    if (overlay.parentElement === document.body) return;
    document.body.appendChild(overlay);
  }

  function openMoviesModal() {
    teleportModalToBody();

    const overlay = document.getElementById("movies-watch-modal");
    if (!overlay) return;

    overlay.classList.remove("hidden");
    overlay.style.display = "flex";
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    lockBodyScroll();
  }

  function closeMoviesModal() {
    const overlay = document.getElementById("movies-watch-modal");
    if (!overlay) return;

    overlay.classList.remove("is-open");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.style.display = "none";
    }, 300);
    unlockBodyScroll();
  }

  function initMoviesModal() {
    teleportModalToBody();

    const openBtn = document.getElementById("movies-open-modal-btn");
    const closeBtn = document.getElementById("movies-modal-close-btn");
    const overlay = document.getElementById("movies-watch-modal");
    const openLinkBtn = document.getElementById("movies-open-link-btn");
    if (!openBtn || !closeBtn || !overlay) return;

    const freshOpenBtn = openBtn.cloneNode(true) as HTMLButtonElement;
    openBtn.parentNode?.replaceChild(freshOpenBtn, openBtn);
    freshOpenBtn.addEventListener("click", openMoviesModal);

    const freshCloseBtn = closeBtn.cloneNode(true) as HTMLButtonElement;
    closeBtn.parentNode?.replaceChild(freshCloseBtn, closeBtn);
    freshCloseBtn.addEventListener("click", closeMoviesModal);

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeMoviesModal();
    });

    if (openLinkBtn) {
      const freshOpenLinkBtn = openLinkBtn.cloneNode(true) as HTMLAnchorElement;
      openLinkBtn.parentNode?.replaceChild(freshOpenLinkBtn, openLinkBtn);
      // Real <a target="_blank"> already opens the link natively - this
      // listener only adds the "thanks" confirmation toast on top of
      // that default browser behavior, it never blocks/preventDefaults.
      freshOpenLinkBtn.addEventListener("click", () => {
        setTimeout(showMoviesThanksToast, 400);
      });
    }
  }

  document.addEventListener("astro:page-load", initMoviesModal);

  if (!(window as any).__wkMoviesEscapeBound) {
    (window as any).__wkMoviesEscapeBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const overlay = document.getElementById("movies-watch-modal");
      if (overlay && overlay.classList.contains("is-open")) {
        closeMoviesModal();
      }
    });
  }
</script>
