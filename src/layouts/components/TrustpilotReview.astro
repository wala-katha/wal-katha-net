</style>

<script>
  function showMoviesThanksToast() {
    let toast = document.getElementById("trustpilot-thanks-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "trustpilot-thanks-toast";
      toast.setAttribute("role", "status");
      toast.setAttribute("aria-live", "polite");

      const star = document.createElement("span");
      star.className = "tpt-star";
      star.setAttribute("aria-hidden", "true");
      star.textContent = "*";

      const text = document.createElement("span");
      text.className = "tpt-text";
      text.textContent = "යැව්වා! 🎬 TeraBox App එකෙන් චිත්‍රපටිය නරඹන්න.";

      toast.appendChild(star);
      toast.appendChild(text);
      document.body.appendChild(toast);
    }

    toast.classList.add("show");
    clearTimeout((toast as any)._hideTimer);
    (toast as any)._hideTimer = setTimeout(() => {
      toast?.classList.remove("show");
    }, 4000);
  }

  // 2026-08 iOS-SAFE, REFERENCE-COUNTED SCROLL LOCK: plain
  // `overflow:hidden` on body does not reliably block touch-drag
  // scrolling on iOS Safari / many mobile WebViews, so this pins the
  // body with position:fixed at its current scroll offset instead.
  // A reference counter (scrollLockCount) is required because TWO
  // modals can be open at once (movie popup + info popup stacked on
  // top of it) - without counting, closing the SECOND modal while the
  // FIRST is still open would incorrectly unlock the background.
  let savedScrollY = 0;
  let scrollLockCount = 0;

  function lockBodyScroll() {
    if (scrollLockCount === 0) {
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      const body = document.body;
      body.style.position = "fixed";
      body.style.top = `-${savedScrollY}px`;
      body.style.left = "0";
      body.style.right = "0";
      body.style.width = "100%";
    }
    scrollLockCount++;
  }

  function unlockBodyScroll() {
    scrollLockCount = Math.max(0, scrollLockCount - 1);
    if (scrollLockCount === 0) {
      const body = document.body;
      body.style.position = "";
      body.style.top = "";
      body.style.left = "";
      body.style.right = "";
      body.style.width = "";
      window.scrollTo(0, savedScrollY);
    }
  }

  // ROOT-CAUSE FIX (kept from the original Trustpilot component):
  // Footer.astro's <footer> uses backdrop-blur-xl (backdrop-filter),
  // which per the CSS spec makes it a new containing block for any
  // descendant using position:fixed. Moving each modal to be a direct
  // child of document.body at runtime restores it as a true
  // viewport-fixed overlay. Idempotent - safe to call on every open.
  function teleportModalToBody(id: string) {
    const overlay = document.getElementById(id);
    if (!overlay) return;
    if (overlay.parentElement === document.body) return;
    document.body.appendChild(overlay);
  }

  // Stack of currently-open modal ids, most-recently-opened last, so
  // the Escape key always closes only the topmost (visually frontmost)
  // popup instead of closing both at once.
  const openModalStack: string[] = [];

  function openModalById(id: string) {
    teleportModalToBody(id);
    const overlay = document.getElementById(id);
    if (!overlay) return;

    overlay.classList.remove("hidden");
    overlay.style.display = "flex";
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    lockBodyScroll();
    openModalStack.push(id);
  }

  function closeModalById(id: string) {
    const overlay = document.getElementById(id);
    if (!overlay) return;

    overlay.classList.remove("is-open");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.style.display = "none";
    }, 300);
    unlockBodyScroll();

    const idx = openModalStack.lastIndexOf(id);
    if (idx !== -1) openModalStack.splice(idx, 1);
  }

  function openMoviesModal() {
    openModalById("movies-watch-modal");
  }
  function closeMoviesModal() {
    closeModalById("movies-watch-modal");
  }
  function openTeraboxInfoModal() {
    openModalById("terabox-info-modal");
  }
  function closeTeraboxInfoModal() {
    closeModalById("terabox-info-modal");
  }

  function initMoviesModal() {
    teleportModalToBody("movies-watch-modal");
    teleportModalToBody("terabox-info-modal");

    const openBtn = document.getElementById("movies-open-modal-btn");
    const closeBtn = document.getElementById("movies-modal-close-btn");
    const overlay = document.getElementById("movies-watch-modal");
    const openLinkBtn = document.getElementById("movies-open-link-btn");
    const infoBtn = document.getElementById("terabox-info-btn");
    const infoCloseBtn = document.getElementById("terabox-info-close-btn");
    const infoOverlay = document.getElementById("terabox-info-modal");
    const infoGotItBtn = document.getElementById("terabox-info-got-it-btn");

    if (!openBtn || !closeBtn || !overlay) return;

    const freshOpenBtn = openBtn.cloneNode(true) as HTMLButtonElement;
    openBtn.parentNode?.replaceChild(freshOpenBtn, openBtn);
    freshOpenBtn.addEventListener("click", openMoviesModal);

    const freshCloseBtn = closeBtn.cloneNode(true) as HTMLButtonElement;
    closeBtn.parentNode?.replaceChild(freshCloseBtn, closeBtn);
    freshCloseBtn.addEventListener("click", closeMoviesModal);

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeMoviesModal();
    });

    if (openLinkBtn) {
      const freshOpenLinkBtn = openLinkBtn.cloneNode(true) as HTMLAnchorElement;
      openLinkBtn.parentNode?.replaceChild(freshOpenLinkBtn, openLinkBtn);
      // Real <a target="_blank"> already opens the link natively - this
      // listener only adds the "thanks" confirmation toast on top of
      // that default browser behavior, it never blocks/preventDefaults.
      freshOpenLinkBtn.addEventListener("click", () => {
        setTimeout(showMoviesThanksToast, 400);
      });
    }

    if (infoBtn) {
      const freshInfoBtn = infoBtn.cloneNode(true) as HTMLButtonElement;
      infoBtn.parentNode?.replaceChild(freshInfoBtn, infoBtn);
      freshInfoBtn.addEventListener("click", openTeraboxInfoModal);
    }

    if (infoCloseBtn) {
      const freshInfoCloseBtn = infoCloseBtn.cloneNode(true) as HTMLButtonElement;
      infoCloseBtn.parentNode?.replaceChild(freshInfoCloseBtn, infoCloseBtn);
      freshInfoCloseBtn.addEventListener("click", closeTeraboxInfoModal);
    }

    if (infoGotItBtn) {
      const freshInfoGotItBtn = infoGotItBtn.cloneNode(true) as HTMLButtonElement;
      infoGotItBtn.parentNode?.replaceChild(freshInfoGotItBtn, infoGotItBtn);
      freshInfoGotItBtn.addEventListener("click", closeTeraboxInfoModal);
    }

    if (infoOverlay) {
      infoOverlay.addEventListener("click", (e) => {
        if (e.target === infoOverlay) closeTeraboxInfoModal();
      });
    }
  }

  document.addEventListener("astro:page-load", initMoviesModal);

  if (!(window as any).__wkMoviesEscapeBound) {
    (window as any).__wkMoviesEscapeBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (openModalStack.length === 0) return;
      // Close only the topmost (most recently opened) popup so a
      // single Escape press never closes both stacked popups at once.
      const topModalId = openModalStack[openModalStack.length - 1];
      closeModalById(topModalId);
    });
  }
</script>
