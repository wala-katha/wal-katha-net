---
// SINHALA MOVIES POPUP CARD - replaces the old Trustpilot review
// collector. Renders in Footer.astro exactly like before (same
// component name/path, so Footer.astro needs zero changes).
//
// FLOW:
//  1. Footer shows a card with a "watch free Sinhala movies" button.
//  2. Clicking it opens a modal (teleported to document.body, same
//     technique the old Trustpilot modal used - required because
//     Footer.astro's <footer> has backdrop-blur-xl, which creates a
//     new CSS containing block for any descendant position:fixed
//     element, clipping/breaking a "fixed" overlay if left inside it).
//  3. Modal shows a notice to install the Terabox app first (with a
//     button straight to the Play Store listing), and a second button
//     that opens the actual movies collection link on teraboxpage.com
//     in a new tab.
import { BiMoviePlay } from "react-icons/bi";
const MOVIES_URL = "https://www.teraboxpage.com/myknow/sinhalamovies";
const TERABOX_APP_URL = "https://play.google.com/store/apps/details?id=com.dubox.drive";
---

<section class="movies-promo-section" aria-label="Free Sinhala Movies">
  <div class="movies-promo-card">
    <span class="mp-card-glow" aria-hidden="true"></span>

    <div class="mp-icon-wrap" aria-hidden="true">
      <BiMoviePlay className="mp-icon" />
    </div>

    <h2 class="mp-heading">සිංහල චිත්‍රපට නොමිලේ බලන්න</h2>
    <p class="mp-subtext">
      අලුත්ම සහ ජනප්‍රියම සිංහල චිත්‍රපට එකතුවක් සම්පූර්ණයෙන්ම නොමිලේ නරඹන්න.
      පහත බටනය ක්ලික් කර, විනාඩියකින් නැරඹීම ආරම්භ කරන්න.
    </p>

    <button
      id="movies-open-modal-btn"
      type="button"
      class="mp-watch-btn"
    >
      <BiMoviePlay className="mp-watch-icon" aria-hidden="true" />
      <span>සිංහල චිත්‍රපට නොමිලේ බලන්න</span>
    </button>
  </div>
</section>

<div
  id="movies-modal"
  class="mp-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="movies-modal-title"
>
  <div class="mp-modal-card">
    <div class="mp-modal-header">
      <h3 id="movies-modal-title" class="mp-modal-title">
        <span class="mp-modal-dot" aria-hidden="true"></span>
        සිංහල චිත්‍රපට නරඹන්න
      </h3>
      <button
        id="movies-modal-close-btn"
        type="button"
        class="mp-modal-close-btn"
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
        <span class="mp-modal-close-label">වහන්න</span>
      </button>
    </div>

    <div class="mp-modal-body">
      <div class="mp-notice-box">
        <svg class="mp-notice-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
          <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
        </svg>
        <p class="mp-notice-text">
          ඔබගේ දුරකථනයේ <strong>Terabox</strong> app එක Install කර නොමැති නම්, චිත්‍රපට නැරඹීමට පෙර එය අනිවාර්යයෙන්ම Download කරගත යුතුය.
        </p>
      </div>

      
        href={TERABOX_APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mp-action-btn mp-action-secondary"
      >
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
          <path d="M7 10l5 5 5-5"></path>
          <path d="M12 15V3"></path>
        </svg>
        <span>Terabox App Download කරන්න</span>
      </a>

      
        href={MOVIES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mp-action-btn mp-action-primary"
      >
        <BiMoviePlay className="mp-action-icon" aria-hidden="true" />
        <span>චිත්‍රපට වෙත යන්න</span>
      </a>
    </div>
  </div>
</div>

<style>
  .movies-promo-section {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .movies-promo-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(1, 173, 159, 0.18);
    background: linear-gradient(180deg, rgba(1, 173, 159, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .movies-promo-card:hover {
    border-color: rgba(1, 173, 159, 0.4);
    transform: translateY(-2px);
  }

  .mp-card-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(1, 173, 159, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .mp-icon-wrap {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.35);
    margin-bottom: 0.85rem;
    box-shadow: 0 0 18px rgba(1, 173, 159, 0.25);
  }
  .mp-icon {
    color: #01ad9f;
    font-size: 1.6rem;
  }

  .mp-heading {
    position: relative;
    z-index: 1;
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.5rem 0;
  }

  .mp-subtext {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  .mp-watch-btn {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
    box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5);
  }
  .mp-watch-btn:hover {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  .mp-watch-btn:active {
    transform: translateY(0);
  }
  .mp-watch-icon {
    font-size: 1.05rem;
  }

  :global(.mp-modal-overlay) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  :global(.mp-modal-overlay.hidden) {
    display: none;
  }
  :global(.mp-modal-overlay.is-open) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.mp-modal-card) {
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    background: #0c0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }

  :global(.mp-modal-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  :global(.mp-modal-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0;
  }

  :global(.mp-modal-dot) {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #01ad9f;
    flex-shrink: 0;
  }

  :global(.mp-modal-close-btn) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(248, 248, 255, 0.75);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }
  :global(.mp-modal-close-btn:hover) {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
    border-color: rgba(248, 113, 113, 0.35);
  }
  :global(.mp-modal-close-label) {
    font-size: 0.75rem;
    font-weight: 700;
  }

  :global(.mp-modal-body) {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  :global(.mp-notice-box) {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 0.85rem;
    padding: 0.85rem 1rem;
  }
  :global(.mp-notice-icon) {
    color: #fbbf24;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  :global(.mp-notice-text) {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.85);
  }
  :global(.mp-notice-text strong) {
    color: #fbbf24;
  }

  :global(.mp-action-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.8rem 1.1rem;
    border-radius: 0.85rem;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  :global(.mp-action-btn:active) {
    transform: scale(0.98);
  }

  :global(.mp-action-secondary) {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f8f8ff;
  }
  :global(.mp-action-secondary:hover) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  :global(.mp-action-primary) {
    background: #01ad9f;
    border: 1px solid #01ad9f;
    color: #010203;
    box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5);
  }
  :global(.mp-action-primary:hover) {
    background: #01c4b4;
    border-color: #01c4b4;
  }
  :global(.mp-action-icon) {
    font-size: 1.05rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .movies-promo-card {
      transition: none;
    }
    :global(.mp-modal-overlay) {
      transition: none;
    }
  }
</style>

<script>
  // Same "teleport modal to document.body" fix the old Trustpilot
  // component used: Footer.astro's <footer> uses backdrop-blur-xl,
  // which creates a new CSS containing block for any descendant
  // position:fixed element - without this move, the modal overlay
  // would render clipped/small instead of a true fullscreen popup.
  function teleportModalToBody() {
    const overlay = document.getElementById("movies-modal");
    if (!overlay) return;
    if (overlay.parentElement === document.body) return;
    document.body.appendChild(overlay);
  }

  function openMoviesModal() {
    teleportModalToBody();
    const overlay = document.getElementById("movies-modal");
    if (!overlay) return;
    overlay.classList.remove("hidden");
    overlay.style.display = "flex";
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    document.body.style.overflow = "hidden";
  }

  function closeMoviesModal() {
    const overlay = document.getElementById("movies-modal");
    if (!overlay) return;
    overlay.classList.remove("is-open");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.style.display = "none";
    }, 300);
    document.body.style.overflow = "";
  }

  function initMoviesModal() {
    teleportModalToBody();

    const openBtn = document.getElementById("movies-open-modal-btn");
    const closeBtn = document.getElementById("movies-modal-close-btn");
    const overlay = document.getElementById("movies-modal");
    if (!openBtn || !closeBtn || !overlay) return;

    const freshOpenBtn = openBtn.cloneNode(true) as HTMLButtonElement;
    openBtn.parentNode?.replaceChild(freshOpenBtn, openBtn);
    freshOpenBtn.addEventListener("click", openMoviesModal);

    const freshCloseBtn = closeBtn.cloneNode(true) as HTMLButtonElement;
    closeBtn.parentNode?.replaceChild(freshCloseBtn, closeBtn);
    freshCloseBtn.addEventListener("click", closeMoviesModal);

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeMoviesModal();
    });
  }

  document.addEventListener("astro:page-load", initMoviesModal);

  if (!(window as any).__wkMoviesEscapeBound) {
    (window as any).__wkMoviesEscapeBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const overlay = document.getElementById("movies-modal");
      if (overlay && overlay.classList.contains("is-open")) {
        closeMoviesModal();
      }
    });
  }
</script>
