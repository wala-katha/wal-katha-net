---
// TRUSTPILOT REVIEW COLLECTOR - theme-matched card, direct-link version.
// The official Trustpilot TrustBox widget code (data-locale,
// data-template-id, data-businessunit-id, data-style-height/width,
// data-token) below is kept byte-for-byte identical to what
// Trustpilot itself provides - do not modify those attributes.
//
// 2026-08 ROOT-CAUSE FIX (replaces the earlier in-site iframe modal
// approach entirely):
// The previous version of this component opened Trustpilot's review
// form inside a same-page iframe modal. Trustpilot's own Cloudflare
// bot-check challenge intentionally refuses to verify when it detects
// it is running inside a cross-origin iframe (window !== window.top),
// as an anti-clickjacking security measure. This is Trustpilot's own
// infrastructure decision and cannot be bypassed from this codebase -
// adding allow="storage-access" only grants cookie access, it does not
// change the iframe-detection logic itself, so the challenge stayed
// stuck on "Verifying your connection... Unable to verify" no matter
// what permissions were granted to the iframe.
//
// FIX: the "Review Now" action is now a plain anchor tag that opens
// Trustpilot's real review page in a new tab (target="_blank"). This
// is not an embedded/iframe context, so Trustpilot's verification
// works normally every time. The small TrustBox star-rating badge
// below (the official third-party widget script) is unaffected by
// this change and continues to render exactly as before.
//
// The "thanks for reviewing" toast still fires - it now triggers off
// the same click-then-return pattern already used for the TrustBox
// widget's own link (store a timestamp in sessionStorage on click,
// then check elapsed time when the tab regains visibility).
//
// ANIMATION FIX: the previous shine-sweep animation on the "Review
// Now" button did not render correctly. It has been removed entirely
// and replaced with a plain pulse-ring animation (expanding/fading
// box-shadow), the same proven, compositor-friendly pattern already
// used elsewhere on this site for the breadcrumb toggle button in
// src/layouts/partials/PostSingle.astro (.breadcrumb-toggle-pulse /
// breadcrumbTogglePulse keyframes) - reusing an already-confirmed
// working animation instead of inventing a new one.
import { BiStar } from "react-icons/bi";
const reviewDomain = "walakatha.net";
const reviewWriteUrl = `https://www.trustpilot.com/evaluate/${reviewDomain}`;
---

<section class="trustpilot-review-section" aria-label="Trustpilot Reviews">
  <div class="trustpilot-review-card">
    <span class="tp-card-glow" aria-hidden="true"></span>

    <div class="tp-stars" aria-hidden="true">
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
      <BiStar className="tp-star" />
    </div>

    <h2 class="tp-heading">ඔබත් අපිව අගය කරන්නද?</h2>
    <p class="tp-subtext">
      Wala Katha ගැන ඔබේ අත්දැකීම තත්පර කිහිපයකින් Trustpilot හි බෙදාගන්න -
      එය අපිට තව හොඳ කරන්නත්, තව දහස් ගණන් පාඨකයන්ට අපිව හඳුනා ගන්නත් ලොකු උදව්වක්!
    </p>

    <a
      id="trustpilot-review-now-link"
      href={reviewWriteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="tp-review-now-btn"
    >
      <BiStar className="tp-review-now-icon" aria-hidden="true" />
      <span>Review එකක් දෙන්න (Review Now)</span>
    </a>

    <div
      id="trustpilot-widget-container"
      class="trustpilot-widget"
      data-locale="en-US"
      data-template-id="56278e9abfbbba0bdcd568bc"
      data-businessunit-id="6a718943c72aab296e860f07"
      data-style-height="52px"
      data-style-width="100%"
      data-token="b99ae46b-0b83-4431-9614-313deb05b559"
    >
      <a href="https://www.trustpilot.com/review/walakatha.net" target="_blank" rel="noopener">
        Trustpilot
      </a>
    </div>
  </div>
</section>

<style>
  .trustpilot-review-section {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .trustpilot-review-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(1, 173, 159, 0.18);
    background: linear-gradient(180deg, rgba(1, 173, 159, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .trustpilot-review-card:hover {
    border-color: rgba(1, 173, 159, 0.4);
    transform: translateY(-2px);
  }

  .tp-card-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(1, 173, 159, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .tp-stars {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }
  .tp-star {
    color: #01ad9f;
    font-size: 1.15rem;
    filter: drop-shadow(0 0 6px rgba(1, 173, 159, 0.45));
  }

  .tp-heading {
    position: relative;
    z-index: 1;
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.5rem 0;
  }

  .tp-subtext {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Review Now link - now a plain outbound link (target="_blank") to
     the real Trustpilot review page, no iframe involved. The pulse
     ring below is the same proven animation pattern already used by
     .breadcrumb-toggle-pulse in PostSingle.astro - a simple
     expanding/fading box-shadow, GPU/compositor friendly, no
     layout-affecting properties animated. */
  .tp-review-now-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: background-color 0.25s ease, transform 0.25s ease;
    animation: tpReviewPulse 2.4s ease-in-out infinite;
  }
  .tp-review-now-btn:hover {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  .tp-review-now-btn:active {
    transform: translateY(0);
  }
  .tp-review-now-icon {
    font-size: 1rem;
  }

  @keyframes tpReviewPulse {
    0%, 100% {
      box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5), 0 0 0 0 rgba(1, 173, 159, 0.35);
    }
    50% {
      box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5), 0 0 0 8px rgba(1, 173, 159, 0);
    }
  }

  .trustpilot-widget {
    position: relative;
    z-index: 1;
  }

  :global(#trustpilot-thanks-toast) {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 16px);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(90vw, 380px);
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #f8f8ff;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    padding: 12px 20px;
    border-radius: 999px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(#trustpilot-thanks-toast.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global(#trustpilot-thanks-toast .tpt-star) {
    color: #01ad9f;
    font-size: 16px;
    flex-shrink: 0;
  }
  :global(#trustpilot-thanks-toast .tpt-text) {
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .trustpilot-review-card {
      transition: none;
    }
    :global(#trustpilot-thanks-toast) {
      transition: none;
    }
    .tp-review-now-btn {
      animation: none;
    }
  }
</style>

<script>
  const TRUSTPILOT_SCRIPT_SRC = "https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js";
  const THANKS_STORAGE_KEY = "wk-trustpilot-clicked-at";
  const THANKS_MIN_AWAY_MS = 2500;
  const WIDGET_LAZY_ROOT_MARGIN = "300px 0px";

  function ensureTrustpilotScriptLoaded(onReady: () => void) {
    const w = window as any;
    if (w.Trustpilot) {
      onReady();
      return;
    }
    const existing = document.querySelector(`script[src="${TRUSTPILOT_SCRIPT_SRC}"]`);
    if (existing) {
      existing.addEventListener("load", onReady, { once: true });
      return;
    }
    const script = document.createElement("script");
    script.src = TRUSTPILOT_SCRIPT_SRC;
    script.async = true;
    script.addEventListener("load", onReady, { once: true });
    document.head.appendChild(script);
  }

  function showTrustpilotThanksToast() {
    let toast = document.getElementById("trustpilot-thanks-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "trustpilot-thanks-toast";
      toast.setAttribute("role", "status");
      toast.setAttribute("aria-live", "polite");

      const star = document.createElement("span");
      star.className = "tpt-star";
      star.setAttribute("aria-hidden", "true");
      star.textContent = "*";

      const text = document.createElement("span");
      text.className = "tpt-text";
      text.textContent = "ඔබගේ අගයන කාලයට ගොඩක් ස්තූතියි!";

      toast.appendChild(star);
      toast.appendChild(text);
      document.body.appendChild(toast);
    }

    toast.classList.add("show");
    clearTimeout((toast as any)._hideTimer);
    (toast as any)._hideTimer = setTimeout(() => {
      toast?.classList.remove("show");
    }, 4000);
  }

  function markTrustpilotClicked() {
    try {
      sessionStorage.setItem(THANKS_STORAGE_KEY, String(Date.now()));
    } catch {
      // Storage unavailable in some private-browsing modes - non-fatal.
    }
  }

  // Lazy-load the TrustBox bootstrap script only once the small
  // widget card scrolls near the viewport, so it does not sit in the
  // critical initial-page-load network chain on every page view.
  let trustpilotWidgetObserver: IntersectionObserver | null = null;

  function initTrustpilotWidget() {
    const container = document.getElementById("trustpilot-widget-container");
    if (!container) return;

    function loadWidgetScript() {
      ensureTrustpilotScriptLoaded(() => {
        const w = window as any;
        if (w.Trustpilot && typeof w.Trustpilot.loadFromElement === "function") {
          w.Trustpilot.loadFromElement(container, true);
        }
      });
    }

    if (trustpilotWidgetObserver) {
      trustpilotWidgetObserver.disconnect();
      trustpilotWidgetObserver = null;
    }

    if (typeof IntersectionObserver === "function") {
      trustpilotWidgetObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              loadWidgetScript();
              observer.disconnect();
            }
          }
        },
        { rootMargin: WIDGET_LAZY_ROOT_MARGIN }
      );
      trustpilotWidgetObserver.observe(container);
    } else {
      loadWidgetScript();
    }

    container.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (target && target.closest && target.closest("a")) {
        markTrustpilotClicked();
      }
    });
  }

  function initTrustpilotReviewLink() {
    const link = document.getElementById("trustpilot-review-now-link");
    if (!link) return;

    const freshLink = link.cloneNode(true) as HTMLAnchorElement;
    link.parentNode?.replaceChild(freshLink, link);
    freshLink.addEventListener("click", markTrustpilotClicked);
  }

  function checkReturnFromTrustpilot() {
    if (document.visibilityState !== "visible") return;

    let clickedAt: string | null;
    try {
      clickedAt = sessionStorage.getItem(THANKS_STORAGE_KEY);
    } catch {
      clickedAt = null;
    }
    if (!clickedAt) return;

    const elapsed = Date.now() - Number(clickedAt);
    try {
      sessionStorage.removeItem(THANKS_STORAGE_KEY);
    } catch {
      // Non-fatal.
    }

    if (elapsed > THANKS_MIN_AWAY_MS) {
      showTrustpilotThanksToast();
    }
  }

  document.addEventListener("astro:page-load", initTrustpilotWidget);
  document.addEventListener("astro:page-load", initTrustpilotReviewLink);

  document.addEventListener("astro:before-swap", () => {
    if (trustpilotWidgetObserver) {
      trustpilotWidgetObserver.disconnect();
      trustpilotWidgetObserver = null;
    }
  });

  if (!(window as any).__wkTrustpilotVisibilityBound) {
    (window as any).__wkTrustpilotVisibilityBound = true;
    document.addEventListener("visibilitychange", checkReturnFromTrustpilot);
  }
</script>
