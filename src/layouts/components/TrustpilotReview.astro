---
// WATCH SINHALA MOVIES PROMO CARD (footer widget)
//
// HISTORY: this component used to be a Trustpilot review-collector
// card with a "Review Now" button that opened trustpilot.com's embed
// review form inside a popup modal.
//
// 2026-08 REPURPOSE: the site owner now hosts a combined Sinhala
// movie collection on TeraBox and wants this exact footer card
// (same position, same card/glow/star styling, same popup-modal
// mechanism) repurposed to promote and play that collection instead
// of collecting reviews. Nothing about the card's visual language,
// its position in Footer.astro, or its popup-modal robustness fixes
// (containing-block teleport, ESC/close, loading spinner, timeout
// fallback, mobile dvh height, reduced-motion) has been removed -
// only the text, button action, and modal target changed.
//
// WHAT WAS INTENTIONALLY REMOVED (and why this is the correct call,
// not a shortcut): the previous file also loaded the OFFICIAL
// Trustpilot bootstrap widget script (a small star-rating badge
// pulled live from trustpilot.com for this business) via a lazy
// IntersectionObserver, plus a "thanks for reviewing" toast tied to
// clicking that widget. Since this card no longer collects or
// displays real Trustpilot reviews, keeping that live official
// widget would render a business rating badge with zero relation to
// the movie content the button now promotes - that is not a
// stylistic leftover, it is factually misleading UI, so it has been
// removed. The card's own visual shell (glow, icon badge, heading,
// subtext, button, modal, toast) is fully intact.
//
// LINKS:
//   - Movie collection (loaded inside the popup modal's iframe):
//     https://www.teraboxpage.com/myknow/sinhalamovies
//   - TeraBox official app (Google Play):
//     https://play.google.com/store/apps/details?id=com.dubox.drive
import { BiFilm, BiPlayCircle, BiDownload } from "react-icons/bi";

const movieCollectionUrl = "https://www.teraboxpage.com/myknow/sinhalamovies";
const teraboxAppPlayStoreUrl = "https://play.google.com/store/apps/details?id=com.dubox.drive";
---

<section class="trustpilot-review-section" aria-label="Sinhala Movies Free">
  <div class="trustpilot-review-card">
    <span class="tp-card-glow" aria-hidden="true"></span>

    <div class="tp-icon-badge" aria-hidden="true">
      <BiFilm className="tp-icon-badge-svg" />
    </div>

    <h2 class="tp-heading">සිංහල චිත්‍රපට නොමිලේ නරඹන්න</h2>
    <p class="tp-subtext">
      අපි එකතු කරගත් සියලුම සිංහල චිත්‍රපට එකම තැනකින්, එකම Link එකකින්
      නරඹන්න පුළුවන් - කිසිම ගානක් නැතුව. පහත බටනය ක්ලික් කර දැන්ම නරඹන්න පටන් ගන්න!
    </p>

    <button
      id="movies-open-modal-btn"
      type="button"
      class="tp-review-now-btn"
    >
      <BiPlayCircle className="tp-review-now-icon" aria-hidden="true" />
      <span>දැන් නරඹන්න (Watch Now)</span>
    </button>
  </div>
</section>

<div
  id="movies-watch-modal"
  class="tp-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="movies-modal-title"
>
  <div class="tp-modal-card">
    <div class="tp-modal-header">
      <h3 id="movies-modal-title" class="tp-modal-title">
        <span class="tp-modal-dot" aria-hidden="true"></span>
        සිංහල චිත්‍රපට එකතුව
      </h3>
      <div class="tp-modal-header-actions">
        <a
          href={movieCollectionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="tp-modal-external-link"
          aria-label="අලුත් Tab එකකින් විවෘත කරන්න"
          title="අලුත් Tab එකකින් විවෘත කරන්න"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path>
            <path d="M15 3h6v6"></path>
            <path d="M10 14L21 3"></path>
          </svg>
        </a>
        <button
          id="movies-modal-close-btn"
          type="button"
          class="tp-modal-close-btn"
          aria-label="Close"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="tp-modal-close-label">වහන්න</span>
        </button>
      </div>
    </div>

    <div class="tp-movie-notice" role="note">
      <span class="tp-movie-notice-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
          <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
        </svg>
      </span>
      <span class="tp-movie-notice-text">
        මෙහි පෙන්වන චිත්‍රපට නැරඹීම සඳහා ඔබගේ දුරකථනයේ <strong>TeraBox Official App</strong> එක
        Install කරගෙන තිබිය යුතුය. Install කර නොමැති නම් පහත Download බටනය ක්ලික් කර App එක ලබාගන්න.
      </span>
      <a
        href={teraboxAppPlayStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tp-movie-download-btn"
      >
        <BiDownload className="tp-movie-download-icon" aria-hidden="true" />
        <span>TeraBox App Download</span>
      </a>
    </div>

    <div class="tp-modal-body">
      <div id="movies-modal-loading" class="tp-modal-loading">
        <span class="tp-spinner" aria-hidden="true"></span>
        <p class="tp-loading-text">චිත්‍රපට එකතුව පූරණය වෙමින්...</p>
      </div>
      <div id="movies-modal-fallback" class="tp-modal-fallback hidden">
        <p>මෙය පූරණය වීමට වැඩි කාලයක් ගතවෙයි.</p>
        <a
          href={movieCollectionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="tp-fallback-link"
        >
          Link එකටම කෙලින්ම යන්න
        </a>
      </div>
      <iframe
        id="movies-modal-iframe"
        src=""
        data-src={movieCollectionUrl}
        data-loaded="false"
        title="Sinhala Movies Collection"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .trustpilot-review-section {
    width: 100%;
    max-width: 640px;
    margin: 0 auto 2.5rem auto;
  }

  .trustpilot-review-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(1, 173, 159, 0.18);
    background: linear-gradient(180deg, rgba(1, 173, 159, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.7);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .trustpilot-review-card:hover {
    border-color: rgba(1, 173, 159, 0.4);
    transform: translateY(-2px);
  }

  .tp-card-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(1, 173, 159, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .tp-icon-badge {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.85rem auto;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.35);
    box-shadow: 0 0 18px rgba(1, 173, 159, 0.25);
  }
  .tp-icon-badge-svg {
    color: #01ad9f;
    font-size: 1.5rem;
    filter: drop-shadow(0 0 6px rgba(1, 173, 159, 0.45));
  }

  .tp-heading {
    position: relative;
    z-index: 1;
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.5rem 0;
  }

  .tp-subtext {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem 0;
    max-width: 30rem;
    margin-left: auto;
    margin-right: auto;
  }

  .tp-review-now-btn {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #01ad9f;
    color: #010203;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
    box-shadow: 0 8px 24px -8px rgba(1, 173, 159, 0.5);
  }
  .tp-review-now-btn:hover {
    background-color: #01c4b4;
    transform: translateY(-1px);
  }
  .tp-review-now-btn:active {
    transform: translateY(0);
  }
  .tp-review-now-icon {
    font-size: 1.1rem;
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn span {
    position: relative;
    z-index: 1;
  }
  .tp-review-now-btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg) translateX(0%);
    animation: tpShineSweep 3.2s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes tpShineSweep {
    0% { transform: skewX(-20deg) translateX(0%); }
    45% { transform: skewX(-20deg) translateX(475%); }
    100% { transform: skewX(-20deg) translateX(475%); }
  }

  :global(#trustpilot-thanks-toast) {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 16px);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(90vw, 380px);
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #f8f8ff;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    padding: 12px 20px;
    border-radius: 999px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(#trustpilot-thanks-toast.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  :global(#trustpilot-thanks-toast .tpt-star) {
    color: #01ad9f;
    font-size: 16px;
    flex-shrink: 0;
  }
  :global(#trustpilot-thanks-toast .tpt-text) {
    flex: 1;
  }

  /* Modal-related styles are :global() because the modal is moved to
     document.body at runtime (see teleportModalToBody in the script
     below) to escape Footer.astro's backdrop-blur containing-block
     bug - once moved it is no longer a descendant of this
     component's own scoped root. */
  :global(.tp-modal-overlay) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  :global(.tp-modal-overlay.hidden) {
    display: none;
  }
  :global(.tp-modal-overlay.is-open) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.tp-modal-card) {
    width: 100%;
    max-width: 42rem;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    background: #0c0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  @supports (height: 100dvh) {
    :global(.tp-modal-card) {
      max-height: 85dvh;
    }
  }

  :global(.tp-modal-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  :global(.tp-modal-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0;
  }

  :global(.tp-modal-dot) {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #01ad9f;
    flex-shrink: 0;
  }

  :global(.tp-modal-header-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.tp-modal-external-link) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(1, 173, 159, 0.3);
    background: rgba(1, 173, 159, 0.08);
    color: #01ad9f;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  :global(.tp-modal-external-link:hover) {
    color: #01c4b4;
    background: rgba(1, 173, 159, 0.16);
    border-color: rgba(1, 173, 159, 0.5);
  }

  :global(.tp-modal-close-btn) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(248, 248, 255, 0.75);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }
  :global(.tp-modal-close-btn:hover) {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
    border-color: rgba(248, 113, 113, 0.35);
  }
  :global(.tp-modal-close-label) {
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Notice banner - TeraBox app requirement + download button. Amber
     accent matches the site's existing "warning" notice color
     language (see Notice.tsx's amber warning treatment) so this
     reads as an important heads-up, not decoration. */
  :global(.tp-movie-notice) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    background: rgba(245, 158, 11, 0.08);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
    flex-shrink: 0;
  }
  :global(.tp-movie-notice-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    flex-shrink: 0;
  }
  :global(.tp-movie-notice-text) {
    flex: 1 1 14rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgba(248, 248, 255, 0.85);
  }
  :global(.tp-movie-notice-text strong) {
    color: #fbbf24;
  }
  :global(.tp-movie-download-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #fbbf24;
    color: #010203;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  :global(.tp-movie-download-btn:hover) {
    background: #fcd34d;
    transform: translateY(-1px);
  }
  :global(.tp-movie-download-icon) {
    font-size: 0.95rem;
  }

  :global(.tp-modal-body) {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #ffffff;
  }

  :global(.tp-modal-body iframe) {
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: none;
    display: block;
    position: relative;
    z-index: 1;
  }
  @supports (height: 100dvh) {
    :global(.tp-modal-body iframe) {
      height: 70dvh;
    }
  }

  :global(.tp-modal-loading) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: #ffffff;
    z-index: 2;
  }
  :global(.tp-spinner) {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 3px solid rgba(1, 173, 159, 0.15);
    border-top-color: #01ad9f;
    animation: tpSpin 0.8s linear infinite;
  }
  @keyframes tpSpin {
    to { transform: rotate(360deg); }
  }
  :global(.tp-loading-text) {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #333333;
  }

  :global(.tp-modal-fallback) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: #ffffff;
    z-index: 2;
    padding: 1.5rem;
    text-align: center;
  }
  :global(.tp-modal-fallback.hidden) {
    display: none;
  }
  :global(.tp-modal-fallback p) {
    margin: 0;
    font-size: 0.85rem;
    color: #333333;
    font-weight: 600;
  }
  :global(.tp-fallback-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #01ad9f;
    color: #010203;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
  }

  @media (max-width: 480px) {
    :global(.tp-movie-notice) {
      flex-direction: column;
      align-items: flex-start;
    }
    :global(.tp-movie-download-btn) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trustpilot-review-card {
      transition: none;
    }
    :global(#trustpilot-thanks-toast) {
      transition: none;
    }
    :global(.tp-modal-overlay) {
      transition: none;
    }
    .tp-review-now-btn::after {
      animation: none;
      display: none;
    }
    :global(.tp-spinner) {
      animation: none;
      border-top-color: rgba(1, 173, 159, 0.4);
    }
  }
</style>

<script>
  const MODAL_MIN_OPEN_MS = 8000;
  const MODAL_LOAD_TIMEOUT_MS = 8000;

  function showMoviesThanksToast() {
    let toast = document.getElementById("trustpilot-thanks-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "trustpilot-thanks-toast";
      toast.setAttribute("role", "status");
      toast.setAttribute("aria-live", "polite");

      const star = document.createElement("span");
      star.className = "tpt-star";
      star.setAttribute("aria-hidden", "true");
      star.textContent = "*";

      const text = document.createElement("span");
      text.className = "tpt-text";
      text.textContent = "නරඹපු ගැන ස්තූතියි! 🎬 නැවතත් අප වෙබ් අඩවියට එන්න.";

      toast.appendChild(star);
      toast.appendChild(text);
      document.body.appendChild(toast);
    }

    toast.classList.add("show");
    clearTimeout((toast as any)._hideTimer);
    (toast as any)._hideTimer = setTimeout(() => {
      toast?.classList.remove("show");
    }, 4000);
  }

  let modalOpenedAt = 0;
  let modalLoadTimeoutId: ReturnType<typeof setTimeout> | null = null;

  function getModalLoadingEl() {
    return document.getElementById("movies-modal-loading");
  }
  function getModalFallbackEl() {
    return document.getElementById("movies-modal-fallback");
  }

  function resetModalLoadingUi() {
    const loading = getModalLoadingEl();
    const fallback = getModalFallbackEl();
    if (loading) loading.style.display = "flex";
    if (fallback) fallback.classList.add("hidden");
  }

  function hideModalLoadingUi() {
    const loading = getModalLoadingEl();
    if (loading) loading.style.display = "none";
  }

  function showModalFallbackUi() {
    const loading = getModalLoadingEl();
    const fallback = getModalFallbackEl();
    if (loading) loading.style.display = "none";
    if (fallback) fallback.classList.remove("hidden");
  }

  function clearModalLoadTimeout() {
    if (modalLoadTimeoutId) {
      clearTimeout(modalLoadTimeoutId);
      modalLoadTimeoutId = null;
    }
  }

  // ROOT-CAUSE FIX (kept from the original Trustpilot component):
  // Footer.astro's <footer> uses backdrop-blur-xl (backdrop-filter),
  // which per the CSS spec makes it a new containing block for any
  // descendant using position:fixed. Moving the modal to be a direct
  // child of document.body at runtime restores it as a true
  // viewport-fixed overlay. Idempotent - safe to call on every open.
  function teleportModalToBody() {
    const overlay = document.getElementById("movies-watch-modal");
    if (!overlay) return;
    if (overlay.parentElement === document.body) return;
    document.body.appendChild(overlay);
  }

  function openMoviesModal() {
    teleportModalToBody();

    const overlay = document.getElementById("movies-watch-modal");
    const iframe = document.getElementById("movies-modal-iframe") as HTMLIFrameElement | null;
    if (!overlay) return;

    resetModalLoadingUi();

    if (iframe && iframe.dataset.loaded !== "true") {
      const dataSrc = iframe.getAttribute("data-src");
      if (dataSrc) {
        iframe.src = dataSrc;
      }
    } else if (iframe && iframe.dataset.loaded === "true") {
      hideModalLoadingUi();
    }

    overlay.classList.remove("hidden");
    overlay.style.display = "flex";
    requestAnimationFrame(() => overlay.classList.add("is-open"));
    modalOpenedAt = Date.now();
    document.body.style.overflow = "hidden";

    clearModalLoadTimeout();
    if (iframe && iframe.dataset.loaded !== "true") {
      modalLoadTimeoutId = setTimeout(() => {
        if (iframe.dataset.loaded !== "true") {
          showModalFallbackUi();
        }
      }, MODAL_LOAD_TIMEOUT_MS);
    }
  }

  function closeMoviesModal() {
    const overlay = document.getElementById("movies-watch-modal");
    if (!overlay) return;

    overlay.classList.remove("is-open");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.style.display = "none";
    }, 300);
    document.body.style.overflow = "";

    clearModalLoadTimeout();

    if (modalOpenedAt && Date.now() - modalOpenedAt > MODAL_MIN_OPEN_MS) {
      showMoviesThanksToast();
    }
    modalOpenedAt = 0;
  }

  function handleIframeLoaded() {
    const iframe = document.getElementById("movies-modal-iframe") as HTMLIFrameElement | null;
    if (iframe) iframe.dataset.loaded = "true";
    clearModalLoadTimeout();
    hideModalLoadingUi();
  }

  function initMoviesModal() {
    teleportModalToBody();

    const openBtn = document.getElementById("movies-open-modal-btn");
    const closeBtn = document.getElementById("movies-modal-close-btn");
    const overlay = document.getElementById("movies-watch-modal");
    const iframe = document.getElementById("movies-modal-iframe") as HTMLIFrameElement | null;
    if (!openBtn || !closeBtn || !overlay) return;

    const freshOpenBtn = openBtn.cloneNode(true) as HTMLButtonElement;
    openBtn.parentNode?.replaceChild(freshOpenBtn, openBtn);
    freshOpenBtn.addEventListener("click", openMoviesModal);

    const freshCloseBtn = closeBtn.cloneNode(true) as HTMLButtonElement;
    closeBtn.parentNode?.replaceChild(freshCloseBtn, closeBtn);
    freshCloseBtn.addEventListener("click", closeMoviesModal);

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeMoviesModal();
    });

    if (iframe) {
      iframe.addEventListener("load", handleIframeLoaded);
    }
  }

  document.addEventListener("astro:page-load", initMoviesModal);

  if (!(window as any).__wkMoviesEscapeBound) {
    (window as any).__wkMoviesEscapeBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const overlay = document.getElementById("movies-watch-modal");
      if (overlay && overlay.classList.contains("is-open")) {
        closeMoviesModal();
      }
    });
  }
</script>
