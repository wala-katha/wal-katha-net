---
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { withTrailingSlash } from "@/lib/utils/urlHelper";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt, BiChevronDown, BiChevronUp, BiTime } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
};
const { posts } = Astro.props;
---

{/* PREMIUM ULTRA-DARK INNER WRAPPER */}
<div class="w-full py-6 transition-all duration-300 bg-[#050505]" id="similar-posts-wrapper">

  {/* RESPONSIVE BOOTSTRAP GRID SYSTEM */}
  <div class="row gy-4 gx-2 sm:gx-4 justify-center" id="similar-posts-grid">
    {
      posts.map((post, index) => {
        // NO-REFRESH RESPONSIVE LOGIC:
        // index < 4 -> mobile ekata auto peneva. index < 6 -> desktop ekata auto peneva.
        let initialClass = "hidden";
        if (index < 4) {
          initialClass = "flex";
        } else if (index < 6) {
          initialClass = "hidden md:flex";
        }

        const isAboveFold = index < 2;
        const imgLoading = isAboveFold ? "eager" : "lazy";
        const imgDecoding = isAboveFold ? "sync" : "async";
        const imgFetchPriority = isAboveFold ? "high" : "auto";

        return (
          <div
            class={`col-6 md:col-4 flex-col justify-between group mb-2 text-center bg-[#0d0d0d] p-2 sm:p-3 rounded-xl border border-[#1a1a1a] similar-post-card transition-all duration-300 ${initialClass}`}
            data-index={index}
          >
            {post.data.image && (
              <a
                href={withTrailingSlash(`/blog/${post.id}`)}
                class="rounded-lg block overflow-hidden group relative bg-[#161616] mx-auto w-full aspect-[3/4]"
              >
                <Image
                  class="w-full h-full object-contain rounded-lg border border-white/5 group-hover:border-emerald-500/40 transition-all duration-300 relative z-0"
                  src={post.data.image}
                  alt={post.data.image_alt || post.data.title}
                  width={500}
                  height={666}
                  loading={imgLoading}
                  decoding={imgDecoding}
                  fetchpriority={imgFetchPriority}
                />
              </a>
            )}

            {/* INFO ROW - similar-card-meta-row hook class added so
                src/styles/small-screen-fixes.css can stack this row
                (kept centered) ONLY on <=380px screens - no change
                on 380px+ screens. */}
            <ul class="similar-card-meta-row mt-2 mb-1 flex flex-wrap items-center text-slate-300 text-[11px] sm:text-xs justify-center gap-x-2 gap-y-1">
              <li class="flex items-center flex-wrap">
                <BiCategoryAlt className="mr-0.5 h-3 w-3 sm:h-[14px] sm:w-[14px] text-emerald-400" />
                <ul>
                  {post.data.categories.slice(0, 1).map((category: string) => (
                    <li class="inline-block">
                      <a
                        href={withTrailingSlash(`/categories/${slugify(category)}`)}
                        class="hover:text-emerald-400 font-bold text-[10px] sm:text-xs bg-white/5 px-1.5 py-0.5 rounded text-slate-200"
                      >
                        {humanize(category)}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
              <li class="flex items-center flex-wrap font-medium text-[10px] sm:text-xs text-slate-400">
                <BiCalendarEdit className="mr-0.5 h-3 w-3 sm:h-4 sm:w-4 text-emerald-400/80" />
                {dateFormat(post.data.date!)}
              </li>
            </ul>

            {/* 2026-08 CONTRAST FIX (PageSpeed Insights "Background and
                foreground colours do not have a sufficient contrast
                ratio" - same root cause and same fix as Posts.astro's
                reading-time chip: this card's background is #0d0d0d, and
                the previous text-slate-500 (#64748b) color only reached
                roughly 4.2:1 contrast at this chip's small font size,
                just under the 4.5:1 WCAG AA minimum for normal text.
                Changed to text-slate-300 (#cbd5e1), which yields well
                over 10:1 contrast on this same background - a
                color-value-only change, no layout/spacing/icon changes. */}
            <p class="mb-1 flex items-center justify-center text-[10px] sm:text-xs text-slate-300 font-medium">
              <BiTime className="mr-1 h-3 w-3 sm:h-3.5 sm:w-3.5 text-emerald-500/70 flex-shrink-0" />
              {readingTime(post.body ?? "").toString()}
            </p>

            {/* POST TITLE */}
            <h3 class="mb-1 line-clamp-2 leading-tight text-center mx-auto w-full">
              <a
                href={withTrailingSlash(`/blog/${post.id}`)}
                class="block hover:text-emerald-400 transition duration-200 text-xs sm:text-base font-extrabold text-white text-center"
              >
                {post.data.title}
              </a>
            </h3>
          </div>
        );
      })
    }
  </div>

  {/* DYNAMIC BUTTONS CONTROLLER */}
  <div id="similar-btn-container" class="mt-10 flex flex-wrap justify-center items-center gap-4 w-full hidden">

    <button
      id="btn-similar-less"
      type="button"
      class="text-xs sm:text-sm bg-[#111111] border border-white/5 text-slate-400 font-bold px-8 py-3.5 rounded-full shadow-md hover:bg-red-500/10 hover:text-red-400 transition-all flex items-center gap-1.5 cursor-pointer hidden"
    >
      <BiChevronUp className="h-5 w-5" />
      <span>Back (මුලට)</span>
    </button>

    <button
      id="btn-similar-more"
      type="button"
      class="text-xs sm:text-sm bg-emerald-500 text-neutral-950 font-extrabold px-9 py-3.5 rounded-full shadow-md hover:bg-emerald-400 transition-all flex items-center gap-1.5 cursor-pointer"
    >
      <span>Load More කතා</span>
      <BiChevronDown className="h-5 w-5 font-black" />
    </button>

  </div>
</div>

<script>
  function initSimilarPostsPagination() {
    const wrapper = document.getElementById('similar-posts-wrapper');
    if (!wrapper) return;

    const cards = wrapper.querySelectorAll('.similar-post-card');
    const btnMore = document.getElementById('btn-similar-more');
    const btnLess = document.getElementById('btn-similar-less');
    const btnContainer = document.getElementById('similar-btn-container');

    if (cards.length === 0) return;

    const getInitialLimit = () => window.innerWidth < 768 ? 4 : 6;
    const getStepLimit = () => window.innerWidth < 768 ? 2 : 3;

    let currentVisibleCount = getInitialLimit();

    if (btnContainer && cards.length > currentVisibleCount) {
      btnContainer.classList.remove('hidden');
    }

    function updateVisibility() {
      const initialLimit = getInitialLimit();

      cards.forEach((card, index) => {
        const htmlCard = card as HTMLElement;
        if (index < currentVisibleCount) {
          htmlCard.classList.remove('hidden');
          htmlCard.classList.add('flex');
          setTimeout(() => {
            htmlCard.style.opacity = '1';
            htmlCard.style.transform = 'translateY(0)';
          }, 50);
        } else {
          htmlCard.classList.add('hidden');
          htmlCard.classList.remove('flex');
        }
      });

      if (btnMore) {
        if (currentVisibleCount >= cards.length) {
          btnMore.classList.add('hidden');
        } else {
          btnMore.classList.remove('hidden');
        }
      }

      if (btnLess) {
        if (currentVisibleCount > initialLimit) {
          btnLess.classList.remove('hidden');
        } else {
          btnLess.classList.add('hidden');
        }
      }
    }

    if (btnMore) {
      btnMore.onclick = () => {
        currentVisibleCount += getStepLimit();
        updateVisibility();
      };
    }

    if (btnLess) {
      btnLess.onclick = () => {
        currentVisibleCount = getInitialLimit();
        updateVisibility();

        const sectionWrapper = document.getElementById('similar-posts-wrapper');
        if (sectionWrapper) {
          sectionWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
    }

    window.addEventListener('resize', () => {
      const initialLimit = getInitialLimit();
      if (currentVisibleCount < initialLimit) {
        currentVisibleCount = initialLimit;
      }
      updateVisibility();
    });

    updateVisibility();
  }

  document.addEventListener('astro:page-load', initSimilarPostsPagination);
  initSimilarPostsPagination();
</script>

<style>
  .similar-post-card {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out, border-color 0.2s, background-color 0.2s;
  }
</style>
