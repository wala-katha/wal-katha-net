---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt, BiChevronDown, BiChevronUp } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
};
const { posts } = Astro.props;
---

{/* 👑 PREMIUM ULTRA-DARK INNER WRAPPER */}
<div class="w-full py-6 transition-all duration-300 bg-[#050505]" id="similar-posts-wrapper">
  
  {/* 🎯 RESPONSIVE GRID GRID SYSTEM */}
  <div class="row gy-4 gx-2 sm:gx-4 justify-center" id="similar-posts-grid">
    {
      posts.map((post, index) => (
        /* 🎯 DYNAMIC SIMILAR CARD WITH INITIAL DATA ATTRIBUTE */
        <div 
          class="col-6 md:col-4 flex flex-col justify-between group mb-2 text-center bg-[#0d0d0d] p-2 sm:p-3 rounded-xl border border-[#1a1a1a] similar-post-card transition-all duration-300 hidden"
          data-index={index}
        >
          {post.data.image && (
            <a
              href={`/blog/${post.id}/`}
              class="rounded-lg block overflow-hidden group relative bg-[#161616] mx-auto w-full aspect-[3/4]"
            >
              {/* 👑 FIXED: object-contain දමා Crop වීම සම්පූර්ණයෙන්ම වැළැක්වීම */}
              <Image
                class="w-full h-full object-contain rounded-lg border border-white/5 group-hover:border-emerald-500/40 transition-all duration-300 relative z-0"
                src={post.data.image}
                alt={post.data.title}
                width={500}
                height={666}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          
          {/* INFO ROW */}
          <ul class="mt-2 mb-1 flex flex-wrap items-center text-slate-300 text-[10px] sm:text-xs justify-center gap-x-2 gap-y-1">
            <li class="flex items-center flex-wrap">
              <BiCategoryAlt className="mr-0.5 h-3 w-3 sm:h-[14px] sm:w-[14px] text-emerald-400" />
              <ul>
                {post.data.categories.slice(0, 1).map((category: string) => (
                  <li class="inline-block">
                    <a
                      href={`/categories/${slugify(category)}/`}
                      class="hover:text-emerald-400 font-bold text-[9px] sm:text-xs bg-white/5 px-1.5 py-0.5 rounded text-slate-200"
                    >
                      {humanize(category)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
            <li class="flex items-center flex-wrap font-medium text-[9px] sm:text-xs text-slate-400">
              <BiCalendarEdit className="mr-0.5 h-3 w-3 sm:h-4 sm:w-4 text-emerald-400/80" />
              {dateFormat(post.data.date!)}
            </li>
          </ul>

          {/* POST TITLE */}
          <h3 class="mb-1 line-clamp-2 leading-tight text-center mx-auto w-full">
            <a
              href={`/blog/${post.id}/`}
              class="block hover:text-emerald-400 transition duration-200 text-xs sm:text-base font-extrabold text-white text-center"
            >
              {post.data.title}
            </a>
          </h3>
        </div>
      ))
    }
  </div>

  {/* 🔘 DYNAMIC BUTTONS CONTROLLER CONTAINER */}
  {posts.length > 2 && (
    <div class="mt-8 flex flex-wrap justify-center items-center gap-4 w-full">
      
      {/* 🔙 SHOW LESS / BACK BUTTON */}
      <button
        id="btn-similar-less"
        type="button"
        class="text-[11px] sm:text-xs bg-[#111111] border border-white/5 text-slate-400 font-bold px-5 py-2.5 rounded-full shadow-md hover:bg-red-500/10 hover:text-red-400 transition-all flex items-center gap-1 cursor-pointer hidden"
      >
        <BiChevronUp className="h-4 w-4" />
        <span>Back (මුලට)</span>
      </button>

      {/* 🔽 LOAD MORE BUTTON */}
      <button
        id="btn-similar-more"
        type="button"
        class="text-[11px] sm:text-xs bg-emerald-500 text-neutral-950 font-black px-6 py-2.5 rounded-full shadow-md hover:bg-emerald-400 transition-all flex items-center gap-1 cursor-pointer"
      >
        <span>Load More კතා</span>
        <BiChevronDown className="h-4 w-4 font-black" />
      </button>

    </div>
  )}
</div>

{/* 🚀 CLIENT-SIDE DYNAMIC PAGINATION SCRIPT */}
<script>
  function initSimilarPostsPagination() {
    const cards = document.querySelectorAll('.similar-post-card');
    const btnMore = document.getElementById('btn-similar-more');
    const btnLess = document.getElementById('btn-similar-less');
    
    if (cards.length === 0) return;

    // උපාංගය අනුව පියවරවල් තීරණය කිරීම (Mobile: 2, Desktop: 3)
    const isMobile = window.innerWidth < 768;
    const initialItems = isMobile ? 2 : 3;
    const stepItems = isMobile ? 2 : 3;
    
    let currentVisibleCount = initialItems;

    // මුල්ම පෝස්ට් ටික පෙන්වීමේ ශ්‍රිතය
    function updateVisibility() {
      cards.forEach((card, index) => {
        const htmlCard = card as HTMLElement;
        if (index < currentVisibleCount) {
          htmlCard.classList.remove('hidden');
          // Smooth Fade-in Effect
          htmlCard.style.opacity = '1';
          htmlCard.style.transform = 'translateY(0)';
        } else {
          htmlCard.classList.add('hidden');
        }
      });

      // Load More බොත්තම පාලනය
      if (btnMore) {
        if (currentVisibleCount >= cards.length) {
          btnMore.classList.add('hidden');
        } else {
          btnMore.classList.remove('hidden');
        }
      }

      // Back බොත්තම පාලනය (මුල් සීමාවට වඩා වැඩි නම් පමණක් පෙන්වයි)
      if (btnLess) {
        if (currentVisibleCount > initialItems) {
          btnLess.classList.remove('hidden');
        } else {
          btnLess.classList.add('hidden');
        }
      }
    }

    // Load More ක්ලික් කිරීම
    if (btnMore) {
      btnMore.addEventListener('click', () => {
        currentVisibleCount += stepItems;
        updateVisibility();
      });
    }

    // Back / Show Less ක්ලික් කිරීම
    if (btnLess) {
      btnLess.addEventListener('click', () => {
        currentVisibleCount = initialItems; // කෙලින්ම නැවත මුලටම රැගෙන යාම
        updateVisibility();
        
        // පේජ් එක උඩට Smooth Scroll කිරීම
        const wrapper = document.getElementById('similar-posts-wrapper');
        if (wrapper) {
          wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    // Initial Execute
    updateVisibility();
  }

  // Astro View Transitions සහ Normal Load දෙකටම වැඩ කරන සේ සකස් කිරීම
  document.addEventListener('astro:page-load', initSimilarPostsPagination);
  initSimilarPostsPagination();
</script>

<style>
  /* සුමටව කාඩ්ස් මතුවීම සඳහා සරල CSS එකක් */
  .similar-post-card {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
  }
</style>
