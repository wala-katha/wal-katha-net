---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
};
const { posts } = Astro.props;
---

{/* 👑 CLEAN INNER WRAPPER: මවු සෙක්ෂන් එකට බාධා නොවන පරිදි පසුබිම් වර්ණ (Backgrounds) කිසිවක් මෙයට දමා නැත */}
<div class="w-full p-4 sm:p-6 transition-all duration-300">
  
  {/* 🎯 ORIGINAL LAYOUT STRUCT: එක පේළියට 3 බැගින් පෙන්වන මුල් බූට්ස්ට්‍රැප් එක ඒ විදිහටම රැකගත්තා */}
  <div class="row gy-4 gx-2 sm:gx-4 justify-center">
    {
      posts.map((post) => (
        <div class="col-4 flex flex-col justify-between group mb-4 text-center">
          {post.data.image && (
            <a
              href={`/blog/${post.id}/`}
              class="rounded-lg block overflow-hidden group relative bg-[#010203] mx-auto w-full border border-white/10 hover:border-emerald-500/30 transition-all duration-300"
              style="aspect-ratio: 3 / 4;"
            >
              {/* 👑 NO CROP IMAGE FIX: උඹේ මුල් කේතයේ තිබූ object-contain එකමයි, පින්තූර කිසිවක් කැපෙන්නේ නැත */}
              <Image
                class="w-full h-full object-contain rounded-lg border border-white/20 group-hover:border-emerald-400 transition-all duration-300 relative z-0"
                src={post.data.image}
                alt={post.data.title}
                width={500}
                height={666}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          
          {/* INFO ROW: අයිකන වලට මුල් වර්ණය වන [#01AD9F] සහ අකුරු වලට පිරිසිදු සුදු පැහැය යෙදුවා */}
          <ul class="mt-2 mb-1 flex flex-wrap items-center text-white/90 text-[10px] sm:text-xs justify-center gap-x-2">
            <li class="flex items-center flex-wrap">
              <BiCategoryAlt className="mr-0.5 h-3 w-3 sm:h-[14px] sm:w-[14px] text-[#01AD9F]" />
              <ul>
                {post.data.categories.slice(0, 1).map((category: string) => (
                  <li class="inline-block">
                    <a
                      href={`/categories/${slugify(category)}/`}
                      class="hover:text-emerald-400 font-black text-[9px] sm:text-xs bg-white/10 px-1 sm:px-2 py-0.5 rounded text-white"
                    >
                      {humanize(category)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
            <li class="hidden xs:flex items-center flex-wrap font-bold text-[9px] sm:text-xs text-white/80">
              <BiCalendarEdit className="mr-0.5 h-3 w-3 sm:h-4 sm:w-4 text-[#01AD9F]" />
              {dateFormat(post.data.date!)}
            </li>
          </ul>

          {/* POST TITLE: මුල් ටයිටල් ස්ටයිල් එකමයි */}
          <h3 class="mb-1 line-clamp-2 leading-tight text-center mx-auto w-full">
            <a
              href={`/blog/${post.id}/`}
              class="block hover:text-emerald-400 transition duration-300 text-[11px] sm:text-base font-black text-white text-center drop-shadow-sm"
            >
              {post.data.title}
            </a>
          </h3>
        </div>
      ))
    }
  </div>

</div>
