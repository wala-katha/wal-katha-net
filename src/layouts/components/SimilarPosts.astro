---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
};
const { posts } = Astro.props;
---

{/* 👑 CLEAN RICH BLACK INNER WRAPPER */}
<div class="w-full py-6 transition-all duration-300 bg-[#050505]">
  
  {/* 🎯 FIXED: Responsive Bootstrap Row එකක් ලෙස සකස් කිරීම */}
  <div class="row gy-4 gx-2 sm:gx-4 justify-center">
    {
      posts.map((post) => (
        /* 🎯 FIXED GRID: මොබයිල් වලට col-6 (පේළියට 2යි), ටැබ්/ඩෙස්ක්ටොප් වලට md:col-4 (පේළියට 3යි) */
        <div class="col-6 md:col-4 flex flex-col justify-between group mb-2 text-center bg-[#0d0d0d] p-2 sm:p-3 rounded-xl border border-[#1a1a1a]">
          {post.data.image && (
            <a
              href={`/blog/${post.id}/`}
              class="rounded-lg block overflow-hidden group relative bg-[#161616] mx-auto w-full aspect-[3/4]"
            >
              {/* 👑 CLEAN & STATIC FRAME WITH EMERALD HOVER */}
              <Image
                class="w-full h-full object-cover rounded-lg border border-white/5 group-hover:border-emerald-500/40 transition-all duration-300 relative z-0"
                src={post.data.image}
                alt={post.data.title}
                width={500}
                height={666}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          
          {/* INFO ROW */}
          <ul class="mt-2 mb-1 flex flex-wrap items-center text-slate-300 text-[10px] sm:text-xs justify-center gap-x-2 gap-y-1">
            <li class="flex items-center flex-wrap">
              <BiCategoryAlt className="mr-0.5 h-3 w-3 sm:h-[14px] sm:w-[14px] text-emerald-400" />
              <ul>
                {post.data.categories.slice(0, 1).map((category: string) => (
                  <li class="inline-block">
                    <a
                      href={`/categories/${slugify(category)}/`}
                      class="hover:text-emerald-400 font-bold text-[9px] sm:text-xs bg-white/5 px-1.5 py-0.5 rounded text-slate-200"
                    >
                      {humanize(category)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
            <li class="flex items-center flex-wrap font-medium text-[9px] sm:text-xs text-slate-400">
              <BiCalendarEdit className="mr-0.5 h-3 w-3 sm:h-4 sm:w-4 text-emerald-400/80" />
              {dateFormat(post.data.date!)}
            </li>
          </ul>

          {/* POST TITLE */}
          <h3 class="mb-1 line-clamp-2 leading-tight text-center mx-auto w-full">
            <a
              href={`/blog/${post.id}/`}
              class="block hover:text-emerald-400 transition duration-200 text-xs sm:text-base font-extrabold text-white text-center"
            >
              {post.data.title}
            </a>
          </h3>
        </div>
      ))
    }
  </div>

</div>
