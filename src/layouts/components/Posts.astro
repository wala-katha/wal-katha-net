---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { withTrailingSlash } from "@/lib/utils/urlHelper";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt, BiPurchaseTagAlt, BiTime } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const authors = await getSinglePage("authors");
const { className, posts, fluid } = Astro.props;

// 🎯 GLOBAL HARVESTING SEO
const allGlobalPosts = await getSinglePage("posts");
const allTags = allGlobalPosts.flatMap((post) => post.data.tags || []);
const uniqueTags = [...new Set(allTags)].filter(Boolean);

// 🎯 PAGESPEED "IMPROVE IMAGE DELIVERY" FIX (Est savings 14.2 KiB —
// Nandage Duwa post flagged: served 397x598, displayed only 311x443 on
// mobile). ROOT CAUSE: previous sizes value "(max-width: 640px) 50vw,
// 204px" told the browser the image would fill 50% of a 640px-wide
// viewport (=320px) — but the ACTUAL rendered column width on real
// mobile devices (390px viewport, minus container padding/gutters from
// .row/.col-6) is closer to ~180-190px, not 320px. This mismatch made
// the browser over-fetch the 2x density variant needlessly on most
// phones.
//
// PERMANENT FIX: sizes recalculated to match the ACTUAL .col-6/.col-4
// grid math (container max-width 1000px, minus px-4/md:px-8 padding and
// row gx-2/gx-4 gutters):
// - Mobile (<640px, 2-col grid): ~46vw (accounts for gx-2 gutter +
//   container padding, tighter than the old flat 50vw estimate)
// - Tablet (640-768px, 2-col grid persists per "md:col-4" only applying
//   at md breakpoint): ~44vw
// - Desktop (>=768px, 3-col grid, container capped at 1000px): fixed
//   ~300px (matches actual 3-column slot width inside the 1000px
//   container)
//
// This lets the browser's native responsive-image selection pick the
// SMALLEST sufficient file from the widths set instead of defaulting
// to a larger variant on viewports where a smaller one is enough —
// directly eliminating the flagged over-download without changing the
// visual card size, aspect ratio, or grid layout in any way.
//
// NOTE: this comment lives in the frontmatter (script) section rather
// than inline inside the <Image> tag's attribute list — Astro's JSX-like
// component attribute parser cannot safely contain a raw /* */ block
// comment between prop values (it previously caused a hard build
// failure: "Expected ':' but found 'IMPROVE'" from esbuild, because the
// comment's quoted text was misparsed as JSX expression syntax). Keeping
// explanatory comments here in plain JS/TS context avoids that entirely
// while still documenting the exact value chosen below.
const postGridImageSizes = "(max-width: 640px) 46vw, (max-width: 768px) 44vw, 300px";

// 🎯 2026-07 W3C VALIDATOR FIX (vnu.validator.w3.org — 4 errors:
// "Bad value ... for attribute srcset on element img: Expected width
// descriptor but found 1x ... When the sizes attribute is present,
// all image candidate strings must specify a width."):
//
// ROOT CAUSE: The <Image> component below previously used BOTH
// `densities={[1, 2]}` AND `sizes={postGridImageSizes}` together.
// `densities` tells Astro to generate a srcset using density
// descriptors (e.g. "image.webp 1x, image.webp 2x"), while `sizes`
// tells the browser how wide the image will be rendered at different
// viewports. Per the HTML/W3C spec, THESE TWO ARE MUTUALLY EXCLUSIVE
// within the same srcset attribute: when a `sizes` attribute is
// present on an <img>, every candidate string inside its `srcset`
// MUST use a WIDTH descriptor ("NNNw"), never a density descriptor
// ("Nx") — density descriptors are only valid when `sizes` is absent
// entirely. Astro's <Image> component faithfully reproduces whatever
// combination of props it's given, so passing both `densities` and
// `sizes` together produces exactly the spec-invalid
// srcset="...webp 1x, ...webp 2x" combined with a sizes attribute
// that the Nu Html Checker correctly flags as a hard error on every
// single post-grid image (4 flagged instances in the validator
// report, one per visible post card image).
//
// PERMANENT FIX: `densities={[1, 2]}` has been replaced with
// `widths={[204, 408]}` — Astro's width-descriptor equivalent, which
// is 100% spec-compliant when combined with a `sizes` attribute
// (this is in fact Astro's own documented recommendation: use
// `widths` + `sizes` together, and `densities` only when `sizes` is
// NOT used). The two chosen widths (204 = the original @1x display
// width baseline used by the previous `sizes` calc, 408 = its @2x
// retina equivalent) preserve the exact same intent as the original
// densities=[1,2] approach — the browser can still pick either the
// smaller or larger file depending on the viewport/DPR — while now
// generating a fully spec-valid width-descriptor srcset
// (e.g. "image.webp 204w, image.webp 408w"). Zero visual regression:
// same physical image files, same responsive selection behavior,
// same PageSpeed "Improve image delivery" savings intent — only the
// srcset descriptor TYPE changed to satisfy the spec requirement
// triggered by the co-present `sizes` attribute. This is also
// self-healing for any future post images added to this same
// component, since the fix lives at the single shared <Image> call
// site used by every post-grid card site-wide.
---

<div class={`w-full ${className} bg-[#050505]`}>
  {/* ප්‍රධාන පෝස්ට් ග්‍රිඩ් එක - RESPONSIVE ROW */}
  <div class={`row gy-4 gx-2 sm:gx-4 ${posts.length == 1 ? "justify-center" : ""} `}>
    {
      posts.map((post, i: number) => (
        /* 🎯 FIXED: මොබයිල් වලට col-6 සහ ඩෙස්ක්ටොප් වලට md:col-4 දමා Layout එක ආරක්ෂා කිරීම */
        <div class="col-6 md:col-4 flex flex-col justify-between bg-[#0d0d0d] p-2 sm:p-3 rounded-xl border border-[#1a1a1a] min-w-0">
          {post.data.image && (
            <a
              href={withTrailingSlash(`/blog/${post.id}`)}
              class="rounded-lg block overflow-hidden group relative border border-white/5 aspect-[2/3]"
            >
              <Image
                class="group-hover:scale-[1.04] transition duration-300 w-full h-full object-cover"
                src={post.data.image}
                alt={post.data.title}
                width={408}
                height={612}
                widths={[204, 408]}
                sizes={postGridImageSizes}
                loading={i < 3 ? "eager" : "lazy"}
                decoding="async"
              />
            </a>
          )}
          
          {/* INFO ROW — 🎯 FIXED (Horizontal Wobble Root Cause): min-w-0
              parent card එකට එකතු කර ඇති අතර, මෙම badge/date row එකේ
              text content එකට "overflow-hidden truncate" safety එකතු
              කර ඇත. Font-size වැඩි කිරීමෙන් (Mobile Usability fix)
              පසුව, badge + icon + date text තුනම col-6 (50% width)
              narrow mobile screens (320-360px) වල parent width එක
              ඉක්මවා ගිය හැකි තත්වයක් තිබූ නිසා, එය "min-w-0" (flex
              child shrink allow කිරීම) සහ badge text වලට "truncate"
              දමා domument width එක parent container එකෙන් කිසි විටෙකත්
              ඉක්මවා නොයන පරිදි සකසා ඇත. Visual design/spacing එකට
              කිසිදු බලපෑමක් නැත — long category names පමණක් affected
              වේ (... ලෙස truncate වේ). */}
          <ul class="mt-2 mb-1 flex flex-wrap items-center text-slate-200 text-[11px] sm:text-xs justify-between gap-y-1 min-w-0">
            <li class="flex items-center flex-wrap min-w-0 max-w-[65%]">
              <BiCategoryAlt className="mr-0.5 h-3 w-3 sm:h-4 sm:w-4 text-emerald-400 flex-shrink-0" />
              <ul class="min-w-0">
                {post.data.categories.slice(0, 1).map((category) => (
                  <li class="inline-block max-w-full">
                    <a
                      href={withTrailingSlash(`/categories/${slugify(category)}`)}
                      class="hover:text-emerald-400 font-bold text-[10px] sm:text-xs bg-white/5 px-1.5 py-0.5 rounded text-slate-200 truncate block max-w-full"
                    >
                      {humanize(category)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
            <li class="flex items-center flex-wrap font-medium text-[10px] sm:text-xs text-slate-400 flex-shrink-0">
              <BiCalendarEdit className="mr-0.5 h-3 w-3 sm:h-4 sm:w-4 text-emerald-400/80 flex-shrink-0" />
              {dateFormat(post.data.date!)}
            </li>
          </ul>

          {/* POST TITLE — 🎯 2026-07 W3C VALIDATOR FIX ("The heading h3
              follows the heading h1, skipping 1 heading level"):
              ROOT CAUSE: index.astro's hidden SEO <h1> (height:0,
              visually collapsed but semantically real) is the page's
              only h1. This card title was previously an <h3>, which
              means the document's heading outline jumped h1 -> h3
              with no h2 anywhere in between — an invalid heading
              hierarchy per the HTML spec (each subsequent heading
              level may only increase by one at a time in a
              well-formed outline). PERMANENT FIX: changed the
              semantic tag from <h3> to <h2> only — every Tailwind
              utility class on this element (text-xs sm:text-base
              font-extrabold, etc.) is preserved byte-for-byte, so the
              VISUAL size/weight/appearance is 100% unchanged (Tailwind
              utility classes always override the browser's default
              h2 font-size, and this element never relied on
              src/styles/base.css's default "h2, .h2 { @apply
              text-h2-sm md:text-h2 }" sizing rule in the first place
              since it already carried its own explicit text-xs/
              sm:text-base classes). This also correctly fixes the
              document outline for every other component that reuses
              this same Posts.astro card pattern site-wide (category
              pages, tag pages, home page, page/[slug].astro
              pagination pages), since they all render through this
              single shared component. */}
          <h2 class="mb-1 line-clamp-2 leading-tight">
            <a
              href={withTrailingSlash(`/blog/${post.id}`)}
              class="block hover:text-emerald-400 transition duration-200 text-xs sm:text-base font-extrabold text-white"
            >
              {post.data.title}
            </a>
          </h2>

          {/* EXCERPT TEXT */}
          <p class="text-slate-400 text-[11px] sm:text-sm line-clamp-2 mb-1 leading-relaxed">{plainify(post.body ?? "")}</p>

          {/* 🎯 2026 READING TIME: readingTime.ts utility එක (කලින්
              කිසිම component එකකින් use වුනේ නැති dead code) දැන්
              Posts.astro grid card එකේ excerpt text එකට යටින්
              display කරයි. Icon styling එක BiCalendarEdit badge
              pattern එකටම සමාන (text-slate-400, small icon + text),
              visual consistency එක පවත්වා ගනී. */}
          <p class="mb-2 flex items-center text-[10px] sm:text-xs text-slate-500 font-medium">
            <BiTime className="mr-1 h-3 w-3 sm:h-3.5 sm:w-3.5 text-emerald-500/70 flex-shrink-0" />
            {readingTime(post.body ?? "").toString()}
          </p>

          {/* AUTHOR & READ ROW */}
          <div class="flex items-center justify-between border-t border-white/5 pt-2 mt-auto gap-2 min-w-0">
            {authors
              .filter((author) =>
                post.data.authors
                  .map((author) => slugify(author))
                  .includes(slugify(author.data.title))
              )
              .slice(0, 1)
              .map((author) => (
                <a
                  href={withTrailingSlash(`/authors/${slugify(author.data.title)}`)}
                  class="flex items-center hover:text-emerald-400 text-[11px] sm:text-xs font-semibold text-slate-300 min-w-0 flex-shrink-1"
                >
                  {author.data.image && (
                    <Image
                      src={author.data.image}
                      alt={author.data.title}
                      height={24}
                      width={24}
                      class="mr-1 h-4 w-4 sm:h-5 sm:w-5 rounded-full object-cover flex-shrink-0 border border-white/10"
                    />
                  )}
                  <span class="truncate">{author.data.title}</span>
                </a>
              ))}
              
            <a 
              href={withTrailingSlash(`/blog/${post.id}`)} 
              class="text-[11px] sm:text-xs bg-emerald-500 text-neutral-950 px-3 sm:px-5 py-1 sm:py-1.5 rounded-full hover:bg-emerald-400 transition-colors font-bold whitespace-nowrap text-center flex-shrink-0"
            >
              Read
            </a>
          </div>
        </div>
      ))
    }
  </div>

  {/* 🏷️ Blogger Style Labels Section */}
  {uniqueTags.length > 0 && (
    <div class="mt-12 p-4 sm:p-6 bg-[#FFCC00] rounded-xl border border-[#E6B800]">
      <div class="flex items-center gap-2 mb-4 border-b border-[#010203]/10 pb-2">
        <BiPurchaseTagAlt className="text-[#010203] h-5 w-5" />
        <h4 class="text-sm sm:text-base font-black text-[#010203]">Labels (ටැග්ස්)</h4>
      </div>
      
      <div class="relative flex flex-col">
        <nav aria-label="Tags Cloud" class="transition-all duration-300 ease-in-out overflow-hidden max-h-[110px]" id="tags-toggle-container">
          <ul class="flex flex-wrap gap-2 m-0 p-0 list-none">
            {uniqueTags.map((tag, index) => (
              <li class={`tag-item-wrap ${index >= 12 ? 'hidden-tag hidden' : ''}`}>
                <a
                  href={withTrailingSlash(`/tags/${slugify(tag)}`)}
                  rel="tag"
                  class="text-[11px] sm:text-xs bg-[#010203] text-white font-black tracking-wide px-2.5 py-1.5 rounded-md border border-black hover:bg-emerald-600 hover:text-white transition-all shadow-sm flex items-center gap-0.5"
                  title={`${tag} කතා සියල්ල මෙතනින් බලන්න`}
                  aria-label={`View posts tagged with ${tag}`}
                >
                  <span class="opacity-50 text-white font-normal">#</span>{humanize(tag)}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {uniqueTags.length > 12 && (
          <div class="mt-5 flex justify-center w-full">
            <button
              id="btn-toggle-tags"
              type="button"
              class="text-[11px] sm:text-xs bg-[#010203] text-white font-black px-5 py-2 rounded-full shadow-md hover:bg-emerald-600 transition-all flex items-center gap-1 cursor-pointer z-10"
            >
              <span>Show All Tags</span>
            </button>
          </div>
        )}
      </div>
    </div>
  )}
</div>

<script>
  function initTagsToggler() {
    const btn = document.getElementById('btn-toggle-tags');
    const container = document.getElementById('tags-toggle-container');
    const hiddenTags = document.querySelectorAll('.hidden-tag');
    
    if (!btn || !container || hiddenTags.length === 0) return;
    
    let isOpen = false;
    
    btn.addEventListener('click', () => {
      isOpen = !isOpen;
      
      if (isOpen) {
        container.style.maxHeight = '2000px';
        hiddenTags.forEach(tag => tag.classList.remove('hidden'));
        btn.querySelector('span')!.textContent = 'Show Less';
      } else {
        container.style.maxHeight = '110px';
        btn.querySelector('span')!.textContent = 'Show All Tags';
        
        setTimeout(() => {
          if (!isOpen) {
            hiddenTags.forEach(tag => tag.classList.add('hidden'));
          }
        }, 300);
      }
    });
  }

  document.addEventListener('astro:page-load', initTagsToggler);
  initTagsToggler();
</script>
