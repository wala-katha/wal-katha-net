---
import { humanize, sanitizeUrlPath } from "@/lib/utils/textConverter";
import { withTrailingSlash } from "@/lib/utils/urlHelper";
import { existsSync, readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import path from "node:path";

// PAGESPEED "IMPROVE IMAGE DELIVERY" FIX (2026-07 - slide-2.webp
// flagged: 86.6 KiB delivered on mobile, displayed at only ~11.7 KiB
// worth of pixels needed). ROOT CAUSE: this component previously used
// a single plain <img src={slide.image}> with NO responsive
// srcset/picture logic at all - every viewport, including small
// phones, always downloaded the same full 1200px-wide desktop master.
//
// FIX: each slide now also carries a "mobileImage" path pointing at a
// companion "-mobile.webp" file (generated by
// .github/workflows/optimize-images.yml's dedicated slider
// dual-output pipeline - see that workflow's own comments for the
// generation logic). The template below renders a <picture> element
// with a <source media="(max-width: 767px)"> pointing at the
// lightweight mobile file, falling back to the existing desktop
// "image" path for tablet/desktop viewports and any browser without
// <picture> support. The desktop "image" filenames/paths are 100%
// unchanged, so this is purely additive - zero regression for
// existing desktop/tablet delivery.
const demoSlides = [
  {
    id: "thaththa-duwa-wal-katha",
    title: "thaththa duwa wal katha - තාත්තයි දුවයි වල් කතා",
    image: "/images/slider/slide-1.webp",
    mobileImage: "/images/slider/slide-1-mobile.webp",
    category: "Wal Katha"
  },
  {
    id: "methsala-akka-wal-katha",
    title: "methsala akka wal katha - මෙත්සලා අක්කා වල් කතා",
    image: "/images/slider/slide-2.webp",
    mobileImage: "/images/slider/slide-2-mobile.webp",
    category: "Wela Katha"
  },
  {
    id: "nandage-duwa-wal-katha",
    title: "Nandage duwa wal katha - නැන්දගේ දුව වල් කතා",
    image: "/images/slider/slide-3.webp",
    mobileImage: "/images/slider/slide-3-mobile.webp",
    category: "wala katha"
  },
  {
    id: "gedara-driver-wal-katha",
    title: "Gedara driver wal katha - ගෙදර ඩ්‍රයිවර් වල් කතා",
    image: "/images/slider/slide-4.webp",
    mobileImage: "/images/slider/slide-4-mobile.webp",
    category: "True Story"
  }
];

// 🎯 2026-08 PERMANENT CACHE-BUSTING FIX (PageSpeed "Improve image
//    delivery" still reporting stale/old file size after a real
//    optimize-images.yml re-encode): ROOT CAUSE was public/_headers'
//    "/*.webp -> Cache-Control: public, max-age=31536000, immutable"
//    rule. Since slider filenames NEVER change (only their bytes do,
//    when quality/compression settings are re-tuned), browsers and
//    Cloudflare's edge cache can keep serving the OLD cached bytes
//    for a full year under the "immutable" contract, even after the
//    origin has genuinely been updated with a smaller, better-
//    compressed file.
//
//    FIX: at build time (this frontmatter runs once per `astro
//    build`, on every Cloudflare Pages deployment), each slider
//    image's REAL file bytes on disk are hashed (SHA-256, first 10
//    hex chars) and appended as a "?v=<hash>" query string. Because
//    the query string is part of the URL, ANY change to the
//    underlying .webp file's bytes automatically produces a brand
//    new, never-before-cached URL - guaranteeing every browser/CDN/
//    PageSpeed test always fetches the current file, with zero
//    manual cache-purge step ever required again. If the file's
//    bytes are unchanged between builds, the hash (and therefore the
//    URL) stays identical, so the 1-year immutable caching benefit
//    for genuinely unchanged assets is fully preserved.
function getAssetVersion(publicRelativePath) {
  try {
    const cleanRelPath = publicRelativePath.replace(/^\/+/, "");
    const absPath = path.join(process.cwd(), "public", cleanRelPath);
    if (!existsSync(absPath)) return "";
    const fileBuffer = readFileSync(absPath);
    return createHash("sha256").update(fileBuffer).digest("hex").slice(0, 10);
  } catch {
    return "";
  }
}
function withVersion(publicRelativePath) {
  const version = getAssetVersion(publicRelativePath);
  return version ? `${publicRelativePath}?v=${version}` : publicRelativePath;
}
const demoSlidesWithVersion = demoSlides.map((slide) => ({
  ...slide,
  image: withVersion(slide.image),
  mobileImage: withVersion(slide.mobileImage),
}));
---

<div class="relative w-full overflow-hidden rounded-xl bg-[#010203] mb-8 border border-white/10" id="astro-featured-slider">
  <div class="flex transition-transform duration-500 ease-in-out" id="slider-wrapper" style="width: 400%;">
    {demoSlidesWithVersion.map((slide, index) => (
      <div class="w-full flex-shrink-0 relative" style="width: 25%;">
        {/*
          2026-08 TOUCH-TARGET / OVERLAP FIX (PageSpeed "Touch targets
          do not have sufficient size or spacing"): only the currently
          ACTIVE slide's link stays interactive/focusable. Every other
          slide's link (visually off-screen due to the wrapper's
          transform, but still a full w-full h-full box in the DOM)
          gets pointer-events-none + aria-hidden + tabindex="-1" so it
          can never register as an overlapping/duplicate touch target
          or a stray tab-stop. initSlider() below keeps this in sync
          every time the active slide changes.
        */}
        <a
          href={withTrailingSlash(`/blog/${sanitizeUrlPath(slide.id)}`)}
          class={`slide-link block w-full h-full group ${index !== 0 ? "pointer-events-none" : ""}`}
          aria-label={`Read story: ${slide.title}`}
          aria-hidden={index !== 0 ? "true" : undefined}
          tabindex={index !== 0 ? -1 : 0}
        >
          <div class="relative w-full aspect-[16/8] sm:aspect-[21/8] md:aspect-[24/8] bg-[#010203] overflow-hidden">
            {/* <picture> + <source media> - serves the lightweight
                ~700w "-mobile.webp" variant to any viewport at or
                below 767px (matches Tailwind's md breakpoint used
                elsewhere in this component for the aspect-ratio
                classes), and falls back to the existing full 1200px
                desktop file above that width, or in browsers that
                don't support <picture> at all.

                2026-08 ASPECT-RATIO FIX (SEO Site Checkup "Image
                Aspect Ratio Test" failure on homepage): this fallback
                <img> ONLY ever actually renders at md+ (768px and up)
                viewports, since the <source media="max-width:767px">
                above already covers every viewport from 0 up to and
                including 767px (which is also where the "sm:" Tailwind
                breakpoint, 640-767px, lives). At md+ the operative CSS
                class is "md:aspect-[24/8]" = 24/8 = a 3:1 ratio.
                width/height below were previously 1200x450 (a 2.667:1
                ratio) - mismatched against the actual 3:1 box this
                element renders into at every viewport where it is
                genuinely used, which automated aspect-ratio checkers
                (and, more importantly, the browser's own CLS space
                reservation before the CSS aspect-ratio rule takes
                over) can flag as inconsistent. height is now 400
                (1200 / 400 = 3), giving an exact match to
                "md:aspect-[24/8]" while keeping the same width=1200
                that matches the real desktop master file generated by
                optimize-images.yml's sliderDesktopMaxWidth.

                NOTE: slide.image / slide.mobileImage now carry a
                "?v=<hash>" cache-busting query string (see
                demoSlidesWithVersion above) - width/height attributes
                below still describe the image's real intrinsic pixel
                dimensions and are completely unaffected by the query
                string. */}
            <picture>
              <source media="(max-width: 767px)" srcset={slide.mobileImage} />
              <img
                src={slide.image}
                alt={slide.title}
                width={1200}
                height={400}
                loading={index === 0 ? "eager" : "lazy"}
                decoding={index === 0 ? "sync" : "async"}
                fetchpriority={index === 0 ? "high" : "low"}
                class="w-full h-full object-cover object-center transition duration-500 group-hover:scale-[1.02]"
              />
            </picture>
          </div>

          <div class="absolute bottom-3 left-4 z-10">
            <span class="bg-[#FFCC00] text-[#010203] px-2.5 py-1 text-[11px] sm:text-xs font-black rounded uppercase tracking-wider shadow-md">
              {humanize(slide.category)}
            </span>
          </div>
        </a>
      </div>
    ))}
  </div>

  {/*
    2026-08 TOUCH-TARGET FIX (PageSpeed "Touch targets do not have
    sufficient size or spacing" - Failing elements: "Go to slide N"
    buttons at w-2 h-2 = 8x8 CSS px, well under the 24x24 CSS px
    minimum required by WCAG 2.5.8 / Lighthouse's target-size audit).

    ROOT CAUSE: the button itself WAS the visible 8px dot, so its real
    DOM bounding box (what Lighthouse measures) was only 8x8.

    FIX: the button is now a 24x24 (w-6 h-6) real clickable box with
    NO visible background of its own. The small visible dot moved into
    a nested <span class="slider-dot-visual"> sized exactly like the
    original dot (w-2 h-2), centered via flex. This means:
      - getBoundingClientRect() on the button now reports 24x24,
        satisfying the audit.
      - The on-screen appearance is unchanged - visitors still see the
        same small dot indicator.
    Since each button now already meets the 24x24 minimum on its own,
    a small gap-1 (4px) between buttons is enough spacing - no
    "insufficient spacing" flag either.
  */}
  <div class="absolute bottom-3 right-4 flex items-center gap-1 z-20">
    {demoSlidesWithVersion.map((_, index) => (
      <button
        type="button"
        class="slider-dot relative flex h-6 w-6 items-center justify-center rounded-full transition-all duration-300"
        data-index={index}
        aria-label={`Go to slide ${index + 1}`}
      >
        <span
          class={`slider-dot-visual block h-2 w-2 rounded-full transition-all duration-300 ${index === 0 ? 'bg-[#01AD9F] scale-125' : 'bg-white/40'}`}
          aria-hidden="true"
        ></span>
      </button>
    ))}
  </div>
</div>

<script>
  function initSlider() {
    const slider = document.getElementById('astro-featured-slider');
    const wrapper = document.getElementById('slider-wrapper');
    const dots = document.querySelectorAll('.slider-dot');
    const dotVisuals = document.querySelectorAll('.slider-dot-visual');
    const slideLinks = document.querySelectorAll('.slide-link');

    if (!slider || !wrapper || dots.length === 0) return;

    let currentIndex = 0;
    const totalSlides = dots.length;
    const intervalTime = 4000;
    let slideInterval: any;

    function updateSlider(index: number) {
      currentIndex = index;
      wrapper.style.transform = `translateX(-${index * 25}%)`;

      // Visual dot state now lives on the inner span, not the button
      // itself (button is the 24x24 hit area, span is the 8x8 dot).
      dotVisuals.forEach((dotVisual, i) => {
        if (i === index) {
          dotVisual.classList.add('bg-[#01AD9F]', 'scale-125');
          dotVisual.classList.remove('bg-white/40');
        } else {
          dotVisual.classList.remove('bg-[#01AD9F]', 'scale-125');
          dotVisual.classList.add('bg-white/40');
        }
      });

      // Keep only the active slide's link interactive/focusable so
      // off-screen slides never register as overlapping/duplicate
      // touch targets or stray tab-stops.
      slideLinks.forEach((link, i) => {
        if (i === index) {
          link.classList.remove('pointer-events-none');
          link.removeAttribute('aria-hidden');
          link.setAttribute('tabindex', '0');
        } else {
          link.classList.add('pointer-events-none');
          link.setAttribute('aria-hidden', 'true');
          link.setAttribute('tabindex', '-1');
        }
      });
    }

    function startInterval() {
      slideInterval = setInterval(() => {
        const nextIndex = (currentIndex + 1) % totalSlides;
        updateSlider(nextIndex);
      }, intervalTime);
    }

    function stopInterval() {
      clearInterval(slideInterval);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        stopInterval();
        // FIX: use e.currentTarget (the button, which always carries
        // data-index) instead of e.target - now that the button has a
        // nested <span>, a tap landing exactly on the visible dot
        // would set e.target to the span, which has no data-index
        // attribute, silently breaking navigation to a wrong slide.
        const index = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0');
        updateSlider(index);
        startInterval();
      });
    });

    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', (e) => {
      touchStartX = (e as TouchEvent).changedTouches[0].screenX;
      stopInterval();
    }, { passive: true });

    slider.addEventListener('touchend', (e) => {
      touchEndX = (e as TouchEvent).changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        const nextIndex = diff > 0
          ? (currentIndex + 1) % totalSlides
          : (currentIndex - 1 + totalSlides) % totalSlides;
        updateSlider(nextIndex);
      }
      startInterval();
    }, { passive: true });

    slider.addEventListener('mouseenter', stopInterval);
    slider.addEventListener('mouseleave', startInterval);

    startInterval();
  }

  document.addEventListener('astro:page-load', initSlider);
  initSlider();
</script>
