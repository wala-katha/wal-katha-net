---
import { humanize, sanitizeUrlPath } from "@/lib/utils/textConverter";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

// 🎯 PAGESPEED "IMPROVE IMAGE DELIVERY" FIX (2026-07 — slide-2.webp
// flagged: 86.6 KiB delivered on mobile, displayed at only ~11.7 KiB
// worth of pixels needed). ROOT CAUSE: this component previously used
// a single plain <img src={slide.image}> with NO responsive
// srcset/picture logic at all — every viewport, including small
// phones, always downloaded the same full 1200px-wide desktop master.
//
// FIX: each slide now also carries a "mobileImage" path pointing at a
// companion "-mobile.webp" file (generated by
// .github/workflows/optimize-images.yml's new dedicated slider
// dual-output pipeline — see that workflow's own comments for the
// generation logic). The template below renders a <picture> element
// with a <source media="(max-width: 767px)"> pointing at the
// lightweight mobile file, falling back to the existing desktop
// "image" path for tablet/desktop viewports and any browser without
// <picture> support. The desktop "image" filenames/paths are 100%
// unchanged, so this is purely additive — zero regression for
// existing desktop/tablet delivery.
const demoSlides = [
  {
    id: "thaththa-duwa-wal-katha",
    title: "thaththa duwa wal katha - තාත්තයි දුවයි වල් කතා",
    image: "/images/slider/slide-1.webp",
    mobileImage: "/images/slider/slide-1-mobile.webp",
    category: "Wal Katha"
  },
  {
    id: "methsala-akka-wal-katha",
    title: "methsala akka wal katha - මෙත්සලා අක්කා වල් කතා",
    image: "/images/slider/slide-2.webp",
    mobileImage: "/images/slider/slide-2-mobile.webp",
    category: "Wela Katha"
  },
  {
    id: "nandage-duwa-wal-katha",
    title: "Nandage duwa wal katha - නැන්දගේ දුව වල් කතා",
    image: "/images/slider/slide-3.webp",
    mobileImage: "/images/slider/slide-3-mobile.webp",
    category: "wala katha"
  },
  {
    id: "gedara-driver-wal-katha",
    title: "Gedara driver wal katha - ගෙදර ඩ්‍රයිවර් වල් කතා",
    image: "/images/slider/slide-4.webp",
    mobileImage: "/images/slider/slide-4-mobile.webp",
    category: "True Story"
  }
];
---

<div class="relative w-full overflow-hidden rounded-xl bg-[#010203] mb-8 border border-white/10" id="astro-featured-slider">
  <div class="flex transition-transform duration-500 ease-in-out" id="slider-wrapper" style="width: 400%;">
    {demoSlides.map((slide, index) => (
      <div class="w-full flex-shrink-0 relative" style="width: 25%;">
        <a href={withTrailingSlash(`/blog/${sanitizeUrlPath(slide.id)}`)} class="block w-full h-full group" aria-label={`Read story: ${slide.title}`}>
          <div class="relative w-full aspect-[16/8] sm:aspect-[21/8] md:aspect-[24/8] bg-[#010203] overflow-hidden">
            {/* 🎯 <picture> + <source media> — serves the lightweight
                ~700w "-mobile.webp" variant to any viewport at or
                below 767px (matches Tailwind's md breakpoint used
                elsewhere in this component for the aspect-ratio
                classes), and falls back to the existing full 1200px
                desktop file above that width, or in browsers that
                don't support <picture> at all. */}
            <picture>
              <source media="(max-width: 767px)" srcset={slide.mobileImage} />
              <img
                src={slide.image}
                alt={slide.title}
                width={1200}
                height={450}
                loading={index === 0 ? "eager" : "lazy"}
                decoding={index === 0 ? "sync" : "async"}
                fetchpriority={index === 0 ? "high" : "low"}
                class="w-full h-full object-cover object-center transition duration-500 group-hover:scale-[1.02]"
              />
            </picture>
          </div>

          <div class="absolute bottom-3 left-4 z-10">
            <span class="bg-[#FFCC00] text-[#010203] px-2.5 py-1 text-[11px] sm:text-xs font-black rounded uppercase tracking-wider shadow-md">
              {humanize(slide.category)}
            </span>
          </div>
        </a>
      </div>
    ))}
  </div>

  <div class="absolute bottom-3 right-4 flex gap-1.5 z-20">
    {demoSlides.map((_, index) => (
      <button
        class={`w-2 h-2 rounded-full transition-all duration-300 slider-dot ${index === 0 ? 'bg-[#01AD9F] scale-125' : 'bg-white/40'}`}
        data-index={index}
        aria-label={`Go to slide ${index + 1}`}
      ></button>
    ))}
  </div>
</div>

<script>
  function initSlider() {
    const slider = document.getElementById('astro-featured-slider');
    const wrapper = document.getElementById('slider-wrapper');
    const dots = document.querySelectorAll('.slider-dot');

    if (!slider || !wrapper || dots.length === 0) return;

    let currentIndex = 0;
    const totalSlides = dots.length;
    const intervalTime = 4000;
    let slideInterval: any;

    function updateSlider(index: number) {
      currentIndex = index;
      wrapper.style.transform = `translateX(-${index * 25}%)`;

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('bg-[#01AD9F]', 'scale-125');
          dot.classList.remove('bg-white/40');
        } else {
          dot.classList.remove('bg-[#01AD9F]', 'scale-125');
          dot.classList.add('bg-white/40');
        }
      });
    }

    function startInterval() {
      slideInterval = setInterval(() => {
        const nextIndex = (currentIndex + 1) % totalSlides;
        updateSlider(nextIndex);
      }, intervalTime);
    }

    function stopInterval() {
      clearInterval(slideInterval);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        stopInterval();
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        updateSlider(index);
        startInterval();
      });
    });

    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', (e) => {
      touchStartX = (e as TouchEvent).changedTouches[0].screenX;
      stopInterval();
    }, { passive: true });

    slider.addEventListener('touchend', (e) => {
      touchEndX = (e as TouchEvent).changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        const nextIndex = diff > 0
          ? (currentIndex + 1) % totalSlides
          : (currentIndex - 1 + totalSlides) % totalSlides;
        updateSlider(nextIndex);
      }
      startInterval();
    }, { passive: true });

    slider.addEventListener('mouseenter', stopInterval);
    slider.addEventListener('mouseleave', startInterval);

    startInterval();
  }

  document.addEventListener('astro:page-load', initSlider);
  initSlider();
</script>
