---
// src/layouts/components/AdcashAds.astro
//
// MyAdCash banner ad slot. Renders ONLY a reserved-space placeholder -
// the actual aclib.runBanner() call is triggered by the global
// controller script /public/scripts/adcash-ads.js, loaded once
// site-wide from Base.astro (aclib.js synchronously first, then
// adcash-ads.js deferred after it).
//
// BUG FIX (2026-09): the outer slot now carries a unique "id" AND the
// data attribute is "data-zoneid" (no hyphen) - both are required to
// exactly match what adcash-ads.js's SLOT_SELECTOR
// (".adcash-ad-slot[data-zoneid]") and its renderIn: "#" + id target
// expect. The previous version emitted "data-zone-id" (with a hyphen,
// which the controller's selector never matched) and no "id" at all
// (so renderIn resolved to the empty/invalid "#") - the ad silently
// never rendered on any page. The renderIn target now points at the
// inner ".adcash-ad-container" div specifically (not the outer slot),
// so the "Advertisement" label text never ends up inside Adcash's own
// rendered ad markup.
interface Props {
  zoneId: string;
  width?: number;
  height?: number;
  label?: string;
}

const {
  zoneId,
  width = 300,
  height = 250,
  label = "Advertisement",
} = Astro.props;

// Unique per-instance id (stable per generated page - crypto.randomUUID()
// runs at build time in Astro frontmatter, not per client render), so
// multiple AdcashAds placements on the same page never collide on the
// same "#id" renderIn target.
const slotId = `adcash-slot-${zoneId}-${crypto.randomUUID().slice(0, 8)}`;
const containerId = `${slotId}-container`;
---

<div
  id={slotId}
  class="adcash-ad-slot"
  data-zoneid={zoneId}
  style={`min-height:${height}px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;margin:1.75rem auto;max-width:100%;`}
>
  {label && (
    <p
      class="adcash-ad-label"
      style="text-align:center;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:rgba(248,248,255,0.35);margin:0 0 6px 0;"
    >
      {label}
    </p>
  )}
  <div
    id={containerId}
    class="adcash-ad-container"
    style={`width:${width}px;max-width:100%;height:${height}px;margin:0 auto;`}
  ></div>
</div>
