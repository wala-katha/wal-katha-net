---
import { BiErrorCircle, BiCheckCircle } from "react-icons/bi";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

interface Props {
  // Policy pages (e.g. parental-control) skip the gate entirely.
  // Base.astro computes this from the pathname and passes it down.
  skip?: boolean;
}
const { skip = false } = Astro.props;
---

{!skip && (
<div
  id="age-gate-overlay"
  class="age-gate-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="age-gate-title"
  aria-describedby="age-gate-desc"
  data-nosnippet
>
  <div id="age-gate-card" class="age-gate-card">
    <span class="age-gate-live-dot" aria-hidden="true"></span>

    <div id="age-gate-form-state">
      <div class="age-gate-icon-badge" aria-hidden="true">
        <BiErrorCircle className="age-gate-icon-svg"/>
      </div>

      <p class="age-gate-brand">WAL KATHA</p>

      <h2 id="age-gate-title" class="age-gate-title">
        මෙම වෙබ් අඩවිය <span class="age-gate-title-accent">වැඩිහිටියන් (18+) සඳහා පමණි!</span>
      </h2>

      <p id="age-gate-desc" class="age-gate-desc">
        මෙම වෙබ් අඩවියට පිවිසීමෙන්, ඔබගේ වයස අවුරුදු 18ට වැඩි බව තහවුරු කරන අතර, මෙහි ඇති සියලුම කතා ප්‍රබන්ධ (Fiction) බවත් මෙම අන්තර්ගතය නීත්‍යානුකූලව ප්‍රවේශ වීමට ඔබට අයිතිය ඇති බව පිළිගන්නෙමු.
        පහත <a href={withTrailingSlash("/terms-and-conditions")} class="age-gate-link" target="_blank" rel="noopener noreferrer">භාවිත නියමයන් සහ කොන්දේසි</a> සහ <a href={withTrailingSlash("/privacy-policy")} class="age-gate-link" target="_blank" rel="noopener noreferrer">පුද්ගලිකත්ව ප්‍රතිපත්තිය</a> වලට මම එකඟ වෙමි.
      </p>

      <div class="age-gate-actions">
        <button id="age-gate-enter-btn" type="button" class="age-gate-enter-btn">
          ඇතුල් වන්න - මට වයස අවුරුදු 18ට වැඩිය
        </button>
        <a href="https://www.google.com" class="age-gate-exit-btn">
          මට වයස අවුරුදු 18ට අඩුයි — පිටවන්න
        </a>
      </div>

      <noscript>
        <p class="age-gate-noscript-note">
          තහවුරු කිරීමේ බොත්තම ක්‍රියාත්මක වීම සඳහා ඔබේ බ්‍රවුසරයේ (Browser) JavaScript සක්‍රීය කර තිබිය යුතුය. කරුණාකර මෙම වෙබ් අඩවියට පිවිසීම සඳහා ඔබේ බ්‍රවුසරයේ සැකසුම් (Settings) වෙත ගොස් JavaScript සක්‍රීය කර, ඉන්පසු මෙම වෙබ් අඩවිය නැවත Refresh (Reload) කරන්න.
        </p>
      </noscript>

      <p class="age-gate-footer-note">
        <a
          href={withTrailingSlash("/parental-control")}
          target="_blank"
          rel="noopener noreferrer"
          class="age-gate-parents-link"
        >
          දෙමව්පියන් සඳහා - ඔබේ දරුවන් ආරක්ෂා කර ගැනීමට මෙය කියවන්න
        </a>
      </p>
    </div>

    <div id="age-gate-success-state" class="age-gate-success-state" hidden>
      <div class="age-gate-success-badge" aria-hidden="true">
        <BiCheckCircle className="age-gate-success-svg"/>
      </div>
      <p class="age-gate-success-text">
        ස්තූතියි! දැන් ඔබට මෙම වෙබ් අඩවිය සම්පූර්ණයෙන් පරිශීලනය කළ හැක.
      </p>
    </div>
  </div>
</div>
)}

<script is:inline>
  (function () {
    var STORAGE_KEY = "wk_age_verified";
    var SUCCESS_VISIBLE_MS = 1700;
    var FADE_OUT_MS = 500;

    function isVerified() {
      try {
        return localStorage.getItem(STORAGE_KEY) === "true";
      } catch (e) {
        return false;
      }
    }
    function setVerified() {
      try {
        localStorage.setItem(STORAGE_KEY, "true");
      } catch (e) {}
      // Notifies same-page listeners (e.g. exo-ads.js) that gating just
      // ended, so ad slots skipped on initial render can fill immediately
      // without waiting for the next full astro:page-load navigation.
      try {
        document.dispatchEvent(new CustomEvent("wk:age-verified"));
      } catch (e) {}
    }
    // Hard state sync: gate state always follows verification state.
    // Runs on first load AND every astro:page-load, so client-side
    // navigations (ClientRouter) can never leak an un-gated page or
    // re-show the gate to an already verified visitor.
    function syncState() {
      var overlay = document.getElementById("age-gate-overlay");
      if (!overlay) return;
      if (isVerified()) {
        document.documentElement.classList.remove("age-gate-pending");
        overlay.style.display = "none";
      } else {
        document.documentElement.classList.add("age-gate-pending");
      }
    }
    function initAgeGate() {
      var enterBtn = document.getElementById("age-gate-enter-btn");
      var overlay = document.getElementById("age-gate-overlay");
      var formState = document.getElementById("age-gate-form-state");
      var successState = document.getElementById("age-gate-success-state");
      if (!enterBtn || !overlay || !formState || !successState) return;

      syncState();

      var freshBtn = enterBtn.cloneNode(true);
      enterBtn.parentNode.replaceChild(freshBtn, enterBtn);

      freshBtn.addEventListener("click", function () {
        setVerified();

        formState.hidden = true;
        successState.hidden = false;

        setTimeout(function () {
          overlay.classList.add("age-gate-overlay--closing");
          document.documentElement.classList.remove("age-gate-pending");

          setTimeout(function () {
            overlay.style.display = "none";
          }, FADE_OUT_MS);
        }, SUCCESS_VISIBLE_MS);
      });
    }
    document.addEventListener("astro:page-load", initAgeGate);
    initAgeGate();
  })();
</script>
