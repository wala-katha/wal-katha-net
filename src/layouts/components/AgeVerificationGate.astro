---
import { BiErrorCircle, BiCheckCircle } from "react-icons/bi";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

interface Props {
  // Policy pages (e.g. parental-control) skip the gate
  skip?: boolean;
}

const { skip = false } = Astro.props;
---

{!skip && (
  <div
    id="age-gate-overlay"
    class="age-gate-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="age-gate-title"
    aria-describedby="age-gate-desc"
  >
    <div class="age-gate-card" id="age-gate-card">
      <span class="age-gate-live-dot" aria-hidden="true"></span>

      <div id="age-gate-form-state">
        <div class="age-gate-icon-badge" aria-hidden="true">
          <BiErrorCircle className="age-gate-icon-svg" />
        </div>

        <p class="age-gate-brand">WAL KATHA</p>

        <h2 id="age-gate-title" class="age-gate-title">
          මෙම වෙබ් අඩවිය වැඩිහිටියන් (18+) සඳහා පමණි
        </h2>

        <p id="age-gate-desc" class="age-gate-desc">
          මෙහි අන්තර්ගතය නිර්මාණාත්මක ප්‍රබන්ධ (Fiction) වන අතර, වයස අවුරුදු 18 ට වැඩි පුද්ගලයින් සඳහා පමණක් සුදුසුය.
          <br />
          ඉදිරියට යාමෙන් ඔබ ඔබගේ වයස අවුරුදු 18 ට වැඩි බව තහවුරු කරන අතර, මෙම අන්තර්ගතය නීත්‍යානුකූලව ප්‍රවේශ වීමට ඔබට අයිතිය ඇති බව පිළිගන්නෙමු.
        </p>

        <div class="age-gate-actions">
          <button
            id="age-gate-enter"
            class="age-gate-btn age-gate-btn-primary"
            type="button"
          >
            මට වයස අවුරුදු 18ට වැඩිය — ඉදිරියට යන්න
          </button>

          <a
            href="https://www.google.com"
            class="age-gate-btn age-gate-btn-secondary"
            rel="noopener noreferrer"
          >
            මට වයස අවුරුදු 18ට අඩුයි — පිටවන්න
          </a>
        </div>

        <p class="age-gate-footer">
          දෙමාපියන් සඳහා මාර්ගෝපදේශ:
          <a href={withTrailingSlash("/parental-control")} class="age-gate-link">
            Parental Control Guide
          </a>
        </p>
      </div>

      <div id="age-gate-success-state" class="age-gate-success-state" hidden>
        <div class="age-gate-success-badge" aria-hidden="true">
          <BiCheckCircle className="age-gate-success-svg" />
        </div>
        <p class="age-gate-success-text">ස්වයංක්‍රීයව ඉදිරියට යමින්...</p>
      </div>
    </div>
  </div>
)}

<script is:inline>
(function () {
  const OVERLAY_ID = "age-gate-overlay";
  const CARD_ID = "age-gate-card";
  const BTN_ID = "age-gate-enter";
  const FORM_STATE_ID = "age-gate-form-state";
  const SUCCESS_STATE_ID = "age-gate-success-state";
  const STORAGE_KEY = "wk_age_verified_v1";

  function getOverlay() {
    return document.getElementById(OVERLAY_ID);
  }
  function getCard() {
    return document.getElementById(CARD_ID);
  }

  function dismissGate() {
    const overlay = getOverlay();
    const card = getCard();
    if (!overlay || !card) return;

    card.classList.add("age-gate-card-exit");
    setTimeout(function () {
      overlay.classList.add("age-gate-hidden");
      document.body.classList.remove("age-gate-locked");
    }, 420);
  }

  function showSuccessThenDismiss() {
    const formState = document.getElementById(FORM_STATE_ID);
    const successState = document.getElementById(SUCCESS_STATE_ID);
    if (!formState || !successState) {
      dismissGate();
      return;
    }
    formState.hidden = true;
    successState.hidden = false;
    setTimeout(dismissGate, 680);
  }

  function verifyAndStore() {
    try {
      localStorage.setItem(STORAGE_KEY, "1");
    } catch (e) {
      // noop — private mode or storage disabled
    }
    showSuccessThenDismiss();
  }

  function isVerified() {
    try {
      return localStorage.getItem(STORAGE_KEY) === "1";
    } catch (e) {
      return false;
    }
  }

  function init() {
    if (isVerified()) {
      const overlay = getOverlay();
      if (overlay) overlay.classList.add("age-gate-hidden");
      return;
    }

    document.body.classList.add("age-gate-locked");

    var btn = document.getElementById(BTN_ID);
    if (!btn) return;

    function onClick(e) {
      e.preventDefault();
      verifyAndStore();
    }
    function onKey(e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        verifyAndStore();
      }
    }

    btn.addEventListener("click", onClick);
    btn.addEventListener("keydown", onKey);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>

<style is:inline>
  /* Prevent body scroll while gate is open */
  body.age-gate-locked {
    overflow: hidden !important;
  }

  .age-gate-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background-color: rgba(1, 2, 3, 0.92);
    backdrop-filter: blur(8px) saturate(140%);
    -webkit-backdrop-filter: blur(8px) saturate(140%);
    opacity: 1;
    transition: opacity 0.42s ease, visibility 0.42s ease;
    visibility: visible;
  }

  .age-gate-overlay.age-gate-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .age-gate-card {
    position: relative;
    width: 100%;
    max-width: 28rem;
    background-color: #0d1117;
    border: 1px solid #1f2937;
    border-radius: 1.25rem;
    padding: 2rem 1.5rem 1.5rem;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.04);
    text-align: center;
    transform: translateY(0) scale(1);
    opacity: 1;
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .age-gate-card-exit {
    transform: translateY(-12px) scale(0.98);
    opacity: 0;
  }

  .age-gate-live-dot {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background-color: #ef4444;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55);
    z-index: 2;
    animation: age-gate-dot-pulse 1.8s ease-in-out infinite;
    will-change: transform, background-color, box-shadow;
  }

  @keyframes age-gate-dot-pulse {
    0% {
      background-color: #010203;
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55);
      transform: scale(1);
    }
    50% {
      background-color: #dc2626;
      box-shadow: 0 0 0 5px rgba(239, 68, 68, 0);
      transform: scale(1.3);
    }
    100% {
      background-color: #010203;
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
      transform: scale(1);
    }
  }

  .age-gate-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.75rem;
    border-radius: 999px;
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #ef4444;
  }

  .age-gate-icon-svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .age-gate-brand {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #01AD9F;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }

  .age-gate-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #F8F8FF;
    line-height: 1.35;
    margin: 0 0 0.6rem;
  }

  .age-gate-desc {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }

  .age-gate-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .age-gate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 0.85rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    line-height: 1.3;
  }

  .age-gate-btn:hover {
    transform: translateY(-1px);
  }

  .age-gate-btn:active {
    transform: translateY(0);
  }

  .age-gate-btn-primary {
    background-color: #01AD9F;
    color: #010203;
    border-color: #01AD9F;
    box-shadow: 0 6px 18px rgba(1, 173, 159, 0.22);
  }

  .age-gate-btn-primary:hover {
    background-color: #02c4b4;
    box-shadow: 0 8px 24px rgba(1, 173, 159, 0.32);
  }

  .age-gate-btn-secondary {
    background-color: transparent;
    color: #94a3b8;
    border-color: #1f2937;
  }

  .age-gate-btn-secondary:hover {
    color: #F8F8FF;
    border-color: #374151;
    background-color: rgba(255, 255, 255, 0.03);
  }

  .age-gate-footer {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
  }

  .age-gate-link {
    color: #01AD9F;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .age-gate-link:hover {
    color: #02c4b4;
  }

  .age-gate-success-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 0.5rem;
    text-align: center;
  }

  .age-gate-success-state[hidden] {
    display: none;
  }

  .age-gate-success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.75rem;
    border-radius: 999px;
    background-color: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.25);
    color: #01AD9F;
    animation: age-gate-success-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes age-gate-success-pop {
    0% {
      transform: scale(0.6);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .age-gate-success-svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .age-gate-success-text {
    font-size: 1rem;
    font-weight: 700;
    color: #01AD9F;
    margin: 0;
  }

  @media (max-width: 480px) {
    .age-gate-card {
      padding: 1.5rem 1.1rem 1.25rem;
      border-radius: 1rem;
    }
    .age-gate-live-dot {
      top: 0.7rem;
      right: 0.7rem;
    }
    .age-gate-icon-badge {
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: 0.6rem;
    }
    .age-gate-icon-svg {
      width: 1.35rem;
      height: 1.35rem;
    }
    .age-gate-brand {
      font-size: 0.7rem;
      letter-spacing: 0.14em;
    }
    .age-gate-title {
      font-size: 1.05rem;
    }
    .age-gate-desc {
      font-size: 0.88rem;
    }
    .age-gate-btn {
      padding: 0.75rem 0.9rem;
      font-size: 0.9rem;
    }
    .age-gate-success-badge {
      width: 3rem;
      height: 3rem;
    }
    .age-gate-success-svg {
      width: 1.5rem;
      height: 1.5rem;
    }
    .age-gate-success-text {
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .age-gate-overlay,
    .age-gate-success-badge,
    .age-gate-icon-badge,
    .age-gate-live-dot {
      transition: none;
      animation: none;
    }
  }
</style>
