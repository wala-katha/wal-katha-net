---
import { BiErrorCircle, BiCheckCircle } from "react-icons/bi";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

interface Props {
  // "parental-control" page එකට gate එක සම්පූර්ණයෙන්ම skip කිරීමට.
  // Base.astro එකෙන් pathname එක අනුව ගණනය කර pass කරයි.
  skip?: boolean;
}
const { skip = false } = Astro.props;
---

{!skip && (
<div
  id="age-gate-overlay"
  class="age-gate-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="age-gate-title"
  aria-describedby="age-gate-desc"
>
  <div id="age-gate-card" class="age-gate-card">
    <div id="age-gate-form-state">
      <div class="age-gate-icon-badge" aria-hidden="true">
        <BiErrorCircle className="age-gate-icon-svg" />
      </div>

      <p class="age-gate-brand">WAL KATHA</p>

      <h2 id="age-gate-title" class="age-gate-title">
        මෙම වෙබ් අඩවිය <span class="age-gate-title-accent">වැඩිහිටියන් (18+) සඳහා පමණි!</span>
      </h2>

      <p id="age-gate-desc" class="age-gate-desc">
        මෙම වෙබ් අඩවියට පිවිසීමෙන්, මට වයස අවුරුදු 18ට වැඩි බවත්, මෙහි ඇති සියලුම කතා ප්‍රබන්ධ (Fiction) බවත් මම තහවුරු කරමි.
        පහත <a href={withTrailingSlash("/privacy-policy")} class="age-gate-link" target="_blank" rel="noopener noreferrer">නියම සහ කොන්දේසි</a> වලට මම එකඟ වෙමි.
      </p>

      <div class="age-gate-actions">
        <button id="age-gate-enter-btn" type="button" class="age-gate-enter-btn">
          ඇතුල් වන්න - මට වයස අවුරුදු 18ට වැඩිය
        </button>
        <a href="https://www.google.com" class="age-gate-exit-btn">
          මට අවුරුදු 18 නෑ - පිටවෙන්න
        </a>
      </div>

      <p class="age-gate-footer-note">
        <a
          href={withTrailingSlash("/parental-control")}
          target="_blank"
          rel="noopener noreferrer"
          class="age-gate-parents-link"
        >
          දෙමව්පියන් සඳහා - ඔබේ දරුවන් ආරක්ෂා කර ගැනීමට මෙය කියවන්න
        </a>
      </p>
    </div>

    <div id="age-gate-success-state" class="age-gate-success-state" hidden>
      <div class="age-gate-success-badge" aria-hidden="true">
        <BiCheckCircle className="age-gate-success-svg" />
      </div>
      <p class="age-gate-success-text">
        ස්තූතියි! දැන් ඔබට මෙම වෙබ් අඩවිය සම්පූර්ණයෙන් පරිශීලනය කළ හැක.
      </p>
    </div>
  </div>
</div>
)}

<script is:inline>
  (function () {
    var STORAGE_KEY = "wk_age_verified";
    // 🎯 පරිශීලකයාට ස්තූති පණිවිඩය කියවීමට ප්‍රමාණවත් වේලාවක් දීම
    // සඳහා පෙන්වන කාලය සුළුවෙන් වැඩි කරන ලදී (950ms -> 1700ms).
    var SUCCESS_VISIBLE_MS = 1700;
    var FADE_OUT_MS = 500;

    function setVerified() {
      try {
        localStorage.setItem(STORAGE_KEY, "true");
      } catch (e) {}
    }
    function initAgeGate() {
      var enterBtn = document.getElementById("age-gate-enter-btn");
      var overlay = document.getElementById("age-gate-overlay");
      var formState = document.getElementById("age-gate-form-state");
      var successState = document.getElementById("age-gate-success-state");
      if (!enterBtn || !overlay || !formState || !successState) return;

      var freshBtn = enterBtn.cloneNode(true);
      enterBtn.parentNode.replaceChild(freshBtn, enterBtn);

      freshBtn.addEventListener("click", function () {
        setVerified();

        formState.hidden = true;
        successState.hidden = false;

        setTimeout(function () {
          overlay.classList.add("age-gate-overlay--closing");
          document.documentElement.classList.remove("age-gate-pending");

          setTimeout(function () {
            overlay.style.display = "none";
          }, FADE_OUT_MS);
        }, SUCCESS_VISIBLE_MS);
      });
    }
    document.addEventListener("astro:page-load", initAgeGate);
    initAgeGate();
  })();
</script>

<style>
  .age-gate-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    opacity: 1;
    transition: opacity 0.45s ease;
  }
  .age-gate-overlay--closing {
    opacity: 0;
    pointer-events: none;
  }
  .age-gate-card {
    width: 100%;
    max-width: 26rem;
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.35);
    border-radius: 1.25rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
    padding: 1.75rem 1.5rem;
    text-align: center;
  }
  .age-gate-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.75rem;
    border-radius: 999px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #f87171;
    /* 🎯 නොනවත්වා දිගටම, වේගවත්ව pulse වන animation එකක් - "!" icon
       එක නොනවත්වා ලොකු-කුඩා වෙමින්, glow ring එකක් ඉස්සුරින් යවමින්
       දිගටම ක්‍රියාත්මක වේ (infinite loop). */
    animation: age-gate-icon-pulse 1.4s ease-in-out infinite;
  }
  .age-gate-icon-svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  @keyframes age-gate-icon-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 0 12px rgba(239, 68, 68, 0);
    }
  }
  .age-gate-brand {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #01ad9f;
    margin: 0 0 0.5rem;
  }
  .age-gate-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }
  .age-gate-title-accent {
    color: #f87171;
  }
  .age-gate-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem;
  }
  .age-gate-link {
    color: #01ad9f;
    text-decoration: underline;
  }
  .age-gate-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .age-gate-enter-btn {
    width: 100%;
    background-color: #01ad9f;
    color: #010203;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.85rem 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .age-gate-enter-btn:hover {
    background-color: #01c4b4;
  }
  .age-gate-exit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .age-gate-exit-btn:hover {
    background-color: #ef4444;
    color: #ffffff;
  }
  .age-gate-footer-note {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .age-gate-parents-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #01ad9f;
    text-decoration: underline;
  }
  .age-gate-success-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
  }
  .age-gate-success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1rem;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #01ad9f;
    animation: age-gate-success-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .age-gate-success-svg {
    width: 2rem;
    height: 2rem;
  }
  .age-gate-success-text {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f8f8ff;
    line-height: 1.6;
  }
  @keyframes age-gate-success-pop {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .age-gate-overlay,
    .age-gate-success-badge,
    .age-gate-icon-badge {
      transition: none;
      animation: none;
    }
  }
</style>
