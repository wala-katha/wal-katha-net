---
import { BiErrorCircle, BiCheckCircle } from "react-icons/bi";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

interface Props {
  // "parental-control" පිටුව වගේ policy පිටුවලට gate එක සම්පූර්ණයෙන්ම
  // skip කිරීමට. Base.astro එකෙන් pathname එක අනුව ගණනය කර pass කරයි.
  skip?: boolean;
}
const { skip = false } = Astro.props;
---

{!skip && (
<div
  id="age-gate-overlay"
  class="age-gate-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="age-gate-title"
  aria-describedby="age-gate-desc"
>
  <div id="age-gate-card" class="age-gate-card">
    <span class="age-gate-live-dot" aria-hidden="true"></span>

    <div id="age-gate-form-state">
      <div class="age-gate-icon-badge" aria-hidden="true">
        <BiErrorCircle className="age-gate-icon-svg" />
      </div>

      <p class="age-gate-brand">WAL KATHA</p>

      <h2 id="age-gate-title" class="age-gate-title">
        මෙම වෙබ් අඩවිය <span class="age-gate-title-accent">වැඩිහිටියන් (18+) සඳහා පමණි!</span>
      </h2>

      <p id="age-gate-desc" class="age-gate-desc">
        මෙම වෙබ් අඩවියට පිවිසීමෙන්, මට වයස අවුරුදු 18ට වැඩි බවත්, මෙහි ඇති සියලුම කතා ප්‍රබන්ධ (Fiction) බවත් මම තහවුරු කරමි.
        පහත <a href={withTrailingSlash("/terms-and-conditions")} class="age-gate-link" target="_blank" rel="noopener noreferrer">භාවිත නියමයන් සහ කොන්දේසි</a> සහ <a href={withTrailingSlash("/privacy-policy")} class="age-gate-link" target="_blank" rel="noopener noreferrer">පුද්ගලිකත්ව ප්‍රතිපත්තිය</a> වලට මම එකඟ වෙමි.
      </p>

      <div class="age-gate-actions">
        <button id="age-gate-enter-btn" type="button" class="age-gate-enter-btn">
          ඇතුල් වන්න - මට වයස අවුරුදු 18ට වැඩිය
        </button>
        <a href="https://www.google.com" class="age-gate-exit-btn">
          මට අවුරුදු 18 නෑ - පිටවෙන්න
        </a>
      </div>

      <p class="age-gate-footer-note">
        <a
          href={withTrailingSlash("/parental-control")}
          target="_blank"
          rel="noopener noreferrer"
          class="age-gate-parents-link"
        >
          දෙමව්පියන් සඳහා - ඔබේ දරුවන් ආරක්ෂා කර ගැනීමට මෙය කියවන්න
        </a>
      </p>
    </div>

    <div id="age-gate-success-state" class="age-gate-success-state" hidden>
      <div class="age-gate-success-badge" aria-hidden="true">
        <BiCheckCircle className="age-gate-success-svg" />
      </div>
      <p class="age-gate-success-text">
        ස්තූතියි! දැන් ඔබට මෙම වෙබ් අඩවිය සම්පූර්ණයෙන් පරිශීලනය කළ හැක.
      </p>
    </div>
  </div>
</div>
)}

<script is:inline>
  (function () {
    var STORAGE_KEY = "wk_age_verified";
    var SUCCESS_VISIBLE_MS = 1700;
    var FADE_OUT_MS = 500;

    function setVerified() {
      try {
        localStorage.setItem(STORAGE_KEY, "true");
      } catch (e) {}
    }
    function initAgeGate() {
      var enterBtn = document.getElementById("age-gate-enter-btn");
      var overlay = document.getElementById("age-gate-overlay");
      var formState = document.getElementById("age-gate-form-state");
      var successState = document.getElementById("age-gate-success-state");
      if (!enterBtn || !overlay || !formState || !successState) return;

      var freshBtn = enterBtn.cloneNode(true);
      enterBtn.parentNode.replaceChild(freshBtn, enterBtn);

      freshBtn.addEventListener("click", function () {
        setVerified();

        formState.hidden = true;
        successState.hidden = false;

        setTimeout(function () {
          overlay.classList.add("age-gate-overlay--closing");
          document.documentElement.classList.remove("age-gate-pending");

          setTimeout(function () {
            overlay.style.display = "none";
          }, FADE_OUT_MS);
        }, SUCCESS_VISIBLE_MS);
      });
    }
    document.addEventListener("astro:page-load", initAgeGate);
    initAgeGate();
  })();
</script>

<style>
  /* ==========================================================
     🎯 FULLY RESPONSIVE ACROSS MOBILE / TABLET / DESKTOP
     ==========================================================
     BASE (mobile-first): card sits centered with fluid clamp()
     typography so text scales smoothly between the smallest and
     largest breakpoints without needing a media query for every
     step in between. max-height + overflow-y:auto guards against
     short-viewport landscape phones where the card could otherwise
     overflow past the top/bottom of the screen.
  ========================================================== */
  .age-gate-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(1, 2, 3, 0.75);
    opacity: 1;
    transition: opacity 0.45s ease;
  }
  .age-gate-overlay--closing {
    opacity: 0;
    pointer-events: none;
  }
  .age-gate-card {
    position: relative;
    width: 100%;
    max-width: 26rem;
    max-height: 92vh;
    overflow-y: auto;
    background: #0c0d10;
    border: 1px solid rgba(1, 173, 159, 0.35);
    border-radius: 1.25rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
    padding: clamp(1.25rem, 4vw, 1.75rem) clamp(1rem, 4vw, 1.5rem);
    text-align: center;
  }

  /* ==========================================================
     🎯 STATIC RED DOT — fixed to the top-right corner of the
     card. No animation - a plain, always-visible solid red dot.
  ========================================================== */
  .age-gate-live-dot {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background-color: #ef4444;
    z-index: 2;
  }

  .age-gate-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 0.75rem;
    border-radius: 999px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #f87171;
    animation: age-gate-icon-pulse 1.4s ease-in-out infinite;
  }
  .age-gate-icon-svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  @keyframes age-gate-icon-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
    }
    50% {
      transform: scale(1.15);
      box-shadow: 0 0 0 12px rgba(239, 68, 68, 0);
    }
  }
  .age-gate-brand {
    font-size: clamp(0.65rem, 1.6vw, 0.7rem);
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #01ad9f;
    margin: 0 0 0.5rem;
  }
  .age-gate-title {
    font-size: clamp(1rem, 4vw, 1.2rem);
    font-weight: 800;
    color: #f8f8ff;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }
  .age-gate-title-accent {
    color: #f87171;
  }
  .age-gate-desc {
    font-size: clamp(0.76rem, 2.6vw, 0.84rem);
    line-height: 1.6;
    color: rgba(248, 248, 255, 0.65);
    margin: 0 0 1.25rem;
  }
  .age-gate-link {
    color: #01ad9f;
    text-decoration: underline;
  }
  .age-gate-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .age-gate-enter-btn {
    width: 100%;
    background-color: #01ad9f;
    color: #010203;
    font-weight: 800;
    font-size: clamp(0.8rem, 2.8vw, 0.87rem);
    padding: clamp(0.7rem, 2.5vw, 0.85rem) 1.5rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .age-gate-enter-btn:hover {
    background-color: #01c4b4;
  }
  .age-gate-exit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
    font-weight: 700;
    font-size: clamp(0.68rem, 2.2vw, 0.74rem);
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .age-gate-exit-btn:hover {
    background-color: #ef4444;
    color: #ffffff;
  }
  .age-gate-footer-note {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .age-gate-parents-link {
    font-size: clamp(0.7rem, 2.4vw, 0.76rem);
    font-weight: 700;
    color: #01ad9f;
    text-decoration: underline;
  }
  .age-gate-success-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
  }
  .age-gate-success-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1rem;
    border-radius: 999px;
    background: rgba(1, 173, 159, 0.12);
    border: 1px solid rgba(1, 173, 159, 0.4);
    color: #01ad9f;
    animation: age-gate-success-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .age-gate-success-svg {
    width: 2rem;
    height: 2rem;
  }
  .age-gate-success-text {
    font-size: clamp(0.85rem, 2.8vw, 0.9rem);
    font-weight: 700;
    color: #f8f8ff;
    line-height: 1.6;
  }
  @keyframes age-gate-success-pop {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ==========================================================
     🎯 SMALL PHONES (<=360px width) — tighten spacing further so
     the card never feels cramped against the screen edges on the
     narrowest common devices.
  ========================================================== */
  @media (max-width: 360px) {
    .age-gate-overlay {
      padding: 0.75rem;
    }
    .age-gate-card {
      border-radius: 1rem;
    }
    .age-gate-live-dot {
      top: 0.7rem;
      right: 0.7rem;
    }
    .age-gate-icon-badge {
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: 0.6rem;
    }
    .age-gate-icon-svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  /* ==========================================================
     🎯 TABLETS & UP (>=768px) — card gets a touch more breathing
     room and slightly larger typography so it doesn't look
     undersized/lost in the middle of a large screen.
  ========================================================== */
  @media (min-width: 768px) {
    .age-gate-card {
      max-width: 30rem;
      padding: 2.25rem 2.25rem;
      border-radius: 1.5rem;
    }
    .age-gate-icon-badge {
      width: 3.75rem;
      height: 3.75rem;
      margin-bottom: 1rem;
    }
    .age-gate-icon-svg {
      width: 2rem;
      height: 2rem;
    }
    .age-gate-actions {
      flex-direction: row;
      justify-content: center;
      gap: 0.9rem;
    }
    .age-gate-enter-btn {
      width: auto;
      flex: 1 1 auto;
      max-width: 20rem;
    }
  }

  /* ==========================================================
     🎯 DESKTOP / LARGE SCREENS (>=1200px) — cap the card at a
     comfortable reading width; centered layout already handles
     positioning, this just prevents it from feeling small on very
     wide monitors while staying visually consistent with the
     mobile/tablet design.
  ========================================================== */
  @media (min-width: 1200px) {
    .age-gate-card {
      max-width: 32rem;
    }
  }

  /* ==========================================================
     🎯 SHORT-HEIGHT VIEWPORTS (landscape phones, small laptops
     with browser chrome eating vertical space) — shrink vertical
     paddings/gaps so the whole card comfortably fits without
     needing to scroll on most devices; max-height + overflow-y on
     .age-gate-card above still catches any remaining overflow.
  ========================================================== */
  @media (max-height: 480px) {
    .age-gate-card {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    .age-gate-icon-badge {
      width: 2.25rem;
      height: 2.25rem;
      margin-bottom: 0.4rem;
    }
    .age-gate-icon-svg {
      width: 1.25rem;
      height: 1.25rem;
    }
    .age-gate-desc {
      margin-bottom: 0.75rem;
    }
    .age-gate-footer-note {
      margin-top: 0.6rem;
      padding-top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .age-gate-overlay,
    .age-gate-success-badge,
    .age-gate-icon-badge {
      transition: none;
      animation: none;
    }
  }
</style>
