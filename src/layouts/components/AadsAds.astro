---
// A-ADS network sticky-footer ad unit. Site-wide (mounted once from
// Base.astro), not per-post - this fully replaces the previous
// MyAdCash (Adcash) integration (aclib.js + adcash-ads.js +
// AdcashAds.astro), which has been removed entirely.
// Pure iframe embed, no external ad-delivery script required, so no
// CSP script-src addition is needed (frame-src already allows any
// https: origin in public/_headers).
const AAD_UNIT_ID = "2456378";
const AAD_TOGGLE_ID = "aadsstickymuh9nyc7";
---

<div class="aads-sticky-wrap" data-nosnippet aria-label="Advertisement">
  <input autocomplete="off" type="checkbox" id={AAD_TOGGLE_ID} hidden />
  <div class="aads-sticky-inner">
    <div class="aads-sticky-bar">
      <label for={AAD_TOGGLE_ID} class="aads-close-btn" aria-label="Close advertisement">
        <svg
          fill="#000000"
          height="16px"
          width="16px"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 490 490"
          aria-hidden="true"
        >
          <polygon points="456.851,0 245,212.564 33.149,0 0.708,32.337 212.669,245.004 0.708,457.678 33.149,490 245,277.443 456.851,490 489.292,457.678 277.331,245.004 489.292,32.337 "></polygon>
        </svg>
      </label>
      <div id={`aads-frame-${AAD_UNIT_ID}`} class="aads-frame">
        <iframe
          data-aa={AAD_UNIT_ID}
          src={`//acceptable.a-ads.com/${AAD_UNIT_ID}/?size=Adaptive`}
          style="border:0; padding:0; width:70%; height:auto; overflow:hidden; margin:auto"
          loading="lazy"
          title="Advertisement"
        ></iframe>
      </div>
    </div>
  </div>
</div>

<style>
  .aads-sticky-wrap {
    position: fixed;
    z-index: 99999;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .aads-sticky-inner {
    padding-top: 0;
    padding-bottom: auto;
  }
  .aads-sticky-bar {
    width: 100%;
    height: auto;
    position: fixed;
    text-align: center;
    font-size: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto;
  }
  .aads-close-btn {
    top: 50%;
    transform: translateY(-50%);
    right: 24px;
    position: absolute;
    border-radius: 4px;
    background: rgba(248, 248, 249, 0.7);
    padding: 4px;
    z-index: 99999;
    cursor: pointer;
  }
  .aads-frame {
    width: 100%;
    margin: auto;
    position: relative;
    z-index: 99998;
  }
  input[type="checkbox"]:checked + .aads-sticky-inner {
    display: none;
  }
  /* Hard-hide during the age-verification gate, same pattern as
     ReaderTools's .rt-root, so an unverified visitor can never see or
     focus the ad while the page is blurred/locked. */
  :global(html.age-gate-pending) .aads-sticky-wrap {
    display: none !important;
  }
</style>
