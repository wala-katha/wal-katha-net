---
// ReaderToolsHead.astro
// Base.astro <head> එකේ අන්තිමට. Blocking inline script.
// සුරකින ලද පෙනුම first paint එකට කලින් <html> එකට යොදනවා.
// reader-tools.css එක Astro bundle එකේ head එකට යන නිසා මේ attributes
// වලට ගැළපෙන rules දැනටමත් parse වෙලා ඉවරයි - flash එකක් නෑ.
---

<script is:inline>
  (function () {
    var r = document.documentElement;
    var p = {};
    try {
      var raw = localStorage.getItem("wk:reader:v1");
      if (raw) p = JSON.parse(raw) || {};
    } catch (e) {
      p = {};
    }

    var PAGES = ["dark", "paper", "sepia", "contrast"];
    var FONTS = ["sinhala", "serif", "system"];
    var MEAS = ["narrow", "normal", "wide"];

    function pick(v, list, fb) {
      return list.indexOf(v) >= 0 ? v : fb;
    }
    function nclamp(v, lo, hi, fb) {
      v = typeof v === "number" && isFinite(v) ? v : fb;
      return Math.min(hi, Math.max(lo, v));
    }

    r.setAttribute("data-rt-page", pick(p.page, PAGES, "dark"));
    r.setAttribute("data-rt-font", pick(p.font, FONTS, "sinhala"));
    r.setAttribute("data-rt-measure", pick(p.measure, MEAS, "normal"));
    r.setAttribute("data-rt-focus", p.focus ? "on" : "off");
    r.style.setProperty("--rt-font-scale", String(nclamp(p.fontScale, 0.85, 1.6, 1)));
    r.style.setProperty("--rt-line-height", String(nclamp(p.lineHeight, 1.4, 2.4, 1.85)));
    r.style.setProperty("--rt-letter", nclamp(p.letter, -0.01, 0.06, 0) + "em");
  })();
</script>
