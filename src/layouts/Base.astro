---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  isArticle?: boolean; // 🎯 පෝස්ට් එකක්ද කියලා අඳුරගන්න අලුත් Prop එකක්
}

const { title, meta_title, description, image, noindex, canonical, isArticle = false } = Astro.props;

const calculatedTitle = plainify(
  meta_title && meta_title.trim() !== ""
    ? meta_title
    : title && title.trim() !== ""
      ? `${title} - Wala Katha`
      : config.site.title
);

const calculatedDescription = plainify(
  description && description.trim() !== ""
    ? description
    : config.metadata.meta_description
);

// 🎯 2026 GOOGLE-SAFE KEYWORD STRUCTURE
const siteKeywords = "Wala Katha, Wal Katha, සිංහල වල් කතා, Sinhala Wal Katha, Wela Katha, Sinhala Wela Katha";

const cleanBaseUrl = config.site.base_url.endsWith("/")
  ? config.site.base_url.slice(0, -1)
  : config.site.base_url;

// 🎯 CLOUDFLARE PAGES TRAILING-SLASH FIX:
// Cloudflare Pages (Git-integrated deployment, not native Workers Static
// Assets) ignores wrangler.jsonc's html_handling setting completely and
// enforces its own default: any no-trailing-slash directory-style URL
// (e.g. "/authors") is 308-redirected to the trailing-slash version
// ("/authors/"). This is a Cloudflare Pages platform-level default that
// cannot be overridden via _redirects for this direction.
//
// Rather than fight the platform, we align the canonical tag itself with
// Cloudflare's actual serving behavior: every canonical URL now ends in
// a trailing slash (except file-like paths that contain a dot, e.g.
// sitemap.xml, robots.txt — which should never get a trailing slash).
// This guarantees the canonical URL always resolves with 0 redirects,
// which is what Ahrefs/Google check for.
function ensureTrailingSlash(url: string): string {
  // Don't touch URLs that already end in "/"
  if (url.endsWith("/")) return url;

  // Don't touch file-like URLs (has a dot in the last path segment,
  // e.g. /sitemap-index.xml, /robots.txt, /favicon.ico)
  const lastSegment = url.split("/").pop() || "";
  if (lastSegment.includes(".")) return url;

  return `${url}/`;
}

const currentCanonical = ensureTrailingSlash(
  canonical ? canonical : `${cleanBaseUrl}${Astro.url.pathname}`
);

const finalImageUrl = image
  ? image.startsWith("http")
    ? image
    : `${cleanBaseUrl}${image.startsWith("/") ? image : "/" + image}`
  : `${cleanBaseUrl}${config.metadata.meta_image.startsWith("/") ? config.metadata.meta_image : "/" + config.metadata.meta_image}`;

// ✅ Home page පමණයි slider preload කරනවා
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

// ==========================================================
// 🎯 UNIVERSAL hreflang / CONTENT-LANGUAGE INJECTION (NEW —
// SEO Enhancement Pass #1: hreflang & Content-Language Consistency)
//
// ROOT CAUSE THIS SOLVES: previously, "content-language" meta +
// "hreflang" self-referencing <link> tags existed ONLY inside
// search.astro, manually hand-written there and nowhere else. Every
// other route on the site ([regular].astro, blog/[single].astro,
// authors/[single].astro, categories/*, tags/*, contact.astro,
// page/[slug].astro, 404.astro, index.astro) had ZERO hreflang or
// content-language signal — an inconsistent, page-by-page patchwork
// instead of a site-wide guarantee.
//
// Even for a genuinely single-language site (si only, no translated
// variants), explicitly declaring hreflang="si" + hreflang="x-default"
// self-referencing tags on every page removes ambiguity for search
// engines about which language/region variant is canonical — this
// matters most when a domain is reachable via multiple host variants
// (www vs non-www) or when third-party aggregators scrape and re-host
// content, since it gives Google an unambiguous, page-level signal of
// "this exact URL is the canonical si-language version" independent
// of the html lang attribute alone.
//
// PERMANENT, SELF-HEALING FIX: this block now lives ONCE, in
// Base.astro (the single layout every page in the site imports),
// computed from the SAME "currentCanonical" value already used for
// <link rel="canonical"> below — so hreflang/content-language can
// never drift out of sync with the canonical URL, no matter how many
// new page types are added in the future. Any new route added later
// automatically inherits this without any additional code, since it
// is impossible to render a page through Base.astro without also
// getting these tags.
//
// NOTE: the previous manual duplicate of these exact three tags
// inside src/pages/search.astro has been removed as part of this same
// change, since rendering them twice on the same page (once from
// here, once from search.astro's own <Fragment slot="head">) would be
// an invalid duplicate <link>/<meta> emission.
//
// 🎯 2026-07 W3C VALIDATOR FIX (vnu.validator.w3.org — 2 errors):
// ROOT CAUSE 1: A previous version of this file manually emitted
// <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
// inside <head>. Astro ALREADY auto-injects its own
// <meta charset="UTF-8" /> as the very first node inside every page's
// <head> (this happens automatically at the framework level and
// cannot be disabled/is not written anywhere in this file's source —
// it is emitted by Astro's compiler itself). The W3C HTML spec
// (and the Nu Html Checker) explicitly FORBIDS a document from having
// BOTH a <meta charset="..."> element AND a
// <meta http-equiv="Content-Type" content="...; charset=..."> element
// at the same time — exactly one charset-declaring meta is permitted.
// Since Astro's own <meta charset="UTF-8"> already satisfies this
// requirement completely, the manual http-equiv="Content-Type" meta
// tag was 100% redundant AND spec-violating. It has been permanently
// removed. No charset functionality is lost — Astro's own directive
// is the single source of truth for this site's character encoding on
// every single page, permanently and automatically (self-healing: any
// future page added to the site automatically inherits Astro's
// charset meta with zero manual code required, and can never
// re-introduce this duplicate-charset error since there is no longer
// any manual charset-related meta tag anywhere in this file).
//
// ROOT CAUSE 2: A previous version of this file also manually emitted
// <meta http-equiv="content-language" content="si" />. The W3C HTML
// spec has marked the "content-language" http-equiv meta as OBSOLETE
// — the correct, modern, spec-compliant way to declare a document's
// primary language is the <html lang="..."> attribute alone, which
// this file ALREADY sets via <html lang="si" ...> below. Since that
// attribute already fully satisfies the language-declaration
// requirement (and is what search engines/browsers actually consult),
// the obsolete http-equiv="content-language" meta tag has been
// permanently removed. No language signal is lost — <html lang="si">
// remains the single, spec-compliant source of truth for this site's
// declared language on every page, permanently.
// ==========================================================
---

<!doctype html>
<html lang="si" class="bg-[#050505]">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    <style>
      /* 🎯 FIXED (CRITICAL — Horizontal Page Wobble/Shake Bug — Android Chrome):
         .row class එකට (tw-bs-grid.mjs) Bootstrap-style negative margin
         (calc(var(--bs-gutter-x) / -2)) තියෙනවා — මේක grid gutter alignment
         සඳහා අවශ්‍ය සාමාන්‍ය pattern එකක්. 

         මීට පෙර html/body වලට විතරක් overflow-x: hidden දාලා තිබ්බා, ඒත් ඒක
         scrollbar එක "hide" කරනවා විතරයි — Android Chrome එකේ, document එකේ
         actual scrollable width එක viewport එකට වඩා ලොකු වුනොත් (negative
         margins, transforms, badge/tag text content නිසා), touch-drag කරන
         විට Chrome එකේ horizontal pan gesture එක තාමත් "catch" වෙලා content
         එක පොඩ්ඩක් පැත්තට move වෙනවා (elastic/rubber-band නොවුනත් drag
         ස්වභාවයක්) — scrollbar නොපෙනුනත් underlying overflow එක තිබුණු නිසා.

         🎯 PERMANENT ROOT-LEVEL FIX (2-Layer Defense):
         1. touch-action: pan-y — html/body මට්ටමින්ම browser එකට කියනවා
            vertical pan/scroll පමණක් allow කරන්න, horizontal pan gesture
            එකක් කිසිසේත් trigger වෙන්නේ නැති පරිදි hard-block කරනවා. මේක
            Android Chrome + iOS Safari දෙකෙටම වැඩ කරන cross-browser fix
            එකක්, vertical scroll එකට කිසිම බලපෑමක් නැත.
         2. .row (Bootstrap-grid negative margin source) එකටම සෘජුවම
            overflow-x: hidden + max-width: 100% දාලා, root cause එකම
            (negative margin causing width overflow) contain කරනවා —
            html/body level fix එක විතරක් "safety net" එකක් විදිහට තියාගෙන,
            .row level එකේ ම root cause එක clamp කරනවා. මේක site එකේ .row
            පාවිච්චි කරන ඕනෑම component එකකට (Posts.astro, SimilarPosts.astro,
            Authors.astro, PostSingle.astro ආදී) automatic ලෙස apply වෙනවා —
            single central point එකෙන් අනාගතයේ අලුත් component එකකින්
            wobble bug එකක් ආවත් මෙතනින්ම block වෙනවා (self-healing).

         මේ දෙකම එකතු කිරීමෙන්, existing layout, design, spacing, gutter
         alignment කිසිවකට බලපෑමක් නැත — document width එක viewport width
         එකට strictly clamp කරලා, horizontal pan gesture එකම browser එකෙන්
         hard-disable කරනවා. */
      html, body {
        background-color: #050505;
        color: #f8fafc;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
        max-width: 100vw;
        touch-action: pan-y;
        overscroll-behavior-x: none;
      }
      .row {
        overflow-x: hidden;
        max-width: 100%;
      }
      #main-content { min-height: 60vh; }
    </style>

    <link rel="shortcut icon" href={config.site.favicon} />

    {/* 🎯 2026 PWA MANIFEST: "Add to Home Screen" installability සඳහා.
        ⚠️ NOTE: public/manifest.json හි icons (192x192, 512x512) දැන්
        app-icon.webp (512x512 square PWA icon) reference කරයි —
        optimize-images.yml workflow එකෙන් auto-synced. */}
    <link rel="manifest" href="/manifest.json" />

    {/* 🎯 FIXED SYNTAX ERROR: ඩූපිලිකේට් වැටිලා තිබ්බ <link ටැග් එක හැදුවා */}
    {isHomePage && (
      <link rel="preload" as="image" href="/images/slider/slide-1.webp" fetchpriority="high" />
    )}

    {fontEntries.map(([key]) => {
      const cssVar = `--font-${key}` as any;
      return <Font cssVariable={cssVar} preload />;
    })}

    <meta name="theme-color" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#050505" />
    <meta name="msapplication-TileColor" content="#050505" />
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="generator" content={Astro.generator} />

    {/* 🎯 UNIVERSAL hreflang BLOCK (SEO Enhancement Pass #1) — see full
        rationale in the frontmatter comment above. Rendered site-wide,
        once, for every page that goes through Base.astro. Computed
        from the same currentCanonical value used by
        <link rel="canonical"> below, so these can never drift out of
        sync with the canonical URL.
        NOTE (2026-07 W3C fix): the manual
        <meta http-equiv="content-language" content="si" /> tag that
        used to sit here has been permanently removed — it was flagged
        obsolete by the W3C Nu Html Checker. <html lang="si"> above is
        the single, spec-compliant source of truth for this site's
        declared language now. */}
    <link rel="alternate" hreflang="si" href={currentCanonical} />
    <link rel="alternate" hreflang="x-default" href={currentCanonical} />

    {/* 👑 CORE SEO TAGS (භාවිතා වෙන්නේ එක පාරක් පමණි) */}
    <title>{calculatedTitle}</title>
    <link rel="canonical" href={currentCanonical} />
    <meta name="description" content={calculatedDescription} />

    {/* 🎯 Article එකක් නොවේ නම් පමණක් Base Meta ටැග්ස් දමයි (Duplicate වැළැක්වීමට) */}
    {!isArticle && (
      <>
        <meta name="keywords" content={siteKeywords} />
        <meta name="author" content={config.metadata.meta_author} />
        {noindex
          ? <meta name="robots" content="noindex,nofollow" />
          : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
        }
        
        {/* Open Graph for Default Pages */}
        <meta property="og:title" content={calculatedTitle} />
        <meta property="og:description" content={calculatedDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={currentCanonical} />
        <meta property="og:locale" content="si_LK" />
        <meta property="og:site_name" content={config.site.title} />

        {/* Twitter for Default Pages */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={calculatedTitle} />
        <meta name="twitter:description" content={calculatedDescription} />
      </>
    )}

    {/* Image tags හැමෝටම පොදුවේ දුවන්න පුළුවන් */}
    <meta property="og:image" content={finalImageUrl} />
    <meta property="og:image:secure_url" content={finalImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={finalImageUrl} />

    {/* ⚡ DYNAMIC HEAD SLOT: PostSingle.astro එකෙන් එවන Meta/Schema ටැග්ස් මෙතනට වදියි */}
    <slot name="head" />

    {/* ==========================================================
        🎯 PWA SERVICE WORKER — EARLY (HEAD-LEVEL) REGISTRATION FIX
        (Home page එකේ "Install app" simple dialog vs Post page එකේ
        "Install + Create shortcut" richer dialog අතර වෙනස විසඳීම)

        🔍 ROOT CAUSE: කලින් SW registration script එක <body> එකේ
        අගට දාලා, "load" event එකට පස්සේ විතරක් register වුනා. Chrome
        ගේ richer install dialog (Install + Create shortcut options
        දෙකම) එක trigger වෙන්නේ, SW එක page එකට "controller" විදිහට
        active වෙලා තියෙනවා කියලා Chrome ට high-confidence එකක් තියෙනකොට
        විතරයි. පළමු visit එකේදී (cold load) "load" event එකට පස්සේ
        register කළාම, SW එක install වෙනවා ඒත් එම load එකේදීම page එක
        control කරන්නේ නෑ (SW spec එකේම standard behavior එකක් —
        පළමු register වෙන SW එක current page එක control කරන්නේ නෑ,
        ඊළඟ navigation එකේදී විතරයි). ඒ නිසා Home page එකේ පළමු visit
        එකේදී Chrome ට low-confidence, simple dialog එකක් පෙන්නන්න
        සිද්ධ වුනා. Blog post එකට navigate කරනකොට (2 වෙනි navigation),
        SW එක දැනටමත් "controlling" state එකේ තියෙන නිසා richer dialog
        එක පෙන්නුනා.

        ✅ PERMANENT FIX: Registration script එක <head> එකට, ඉතාම
        ඉක්මනින්ම (blocking network request එකක් නොවන "register()"
        call එකක්, main content render එකට කිසිම බලපෑමක් නැති
        async/non-blocking call එකක්) දාලා, "load" event එකට කලින්ම
        trigger කරනවා. මෙය Chrome ට SW එක install+active වෙන්න
        හැකි තරම් ඉක්මනින්ම ලැබෙන chance එක වැඩි කරනවා, page load
        එකේම (හෝ ඊළඟ ඉක්මන් reload එකකදී) richer dialog එකට
        eligible වෙන්න පුළුවන් වෙනවා — Home page එකද, Post page
        එකද කියලා වෙනසක් නැතුව site එක පුරාම consistent PWA install
        experience එකක් සහතික කරනවා.

        🛡️ SELF-HEALING GUARDS (unchanged from before, retained):
        - "serviceWorker" API නොමැති browsers වල silently skip වෙනවා.
        - astro:page-load listener එකෙන් View Transitions (ClientRouter)
          client-side navigation වලදීත් duplicate registration
          attempts වළක්වයි (browser එකෙන්ම දැනටමත් registered SW
          එකක් නම් .register() call එක silently no-op වෙනවා, error
          එකක් හෝ duplicate registration side-effect එකක් නෑ).
        - registration fail උනොත් (offline, unsupported browser
          edge-case ආදී) silently log කරලා core site functionality
          කිසිවකට බලපෑමක් නැතුව ඉදිරියට යනවා.
       ========================================================== */}
    <script is:inline>
      (function registerServiceWorkerEarly() {
        if (!("serviceWorker" in navigator)) return;

        function doRegister() {
          navigator.serviceWorker
            .register("/sw.js")
            .then((registration) => {
              console.log("SW registered (early):", registration.scope);
            })
            .catch((err) => {
              console.warn("SW registration failed:", err);
            });
        }

        // 🎯 ASAP TRIGGER: "load" event එකට කලින්ම, script tag එක
        // parse වෙන ගමන්ම register() call කරනවා. register() call එක
        // itself non-blocking (Promise-based) නිසා, main content
        // render/paint එකට කිසිම delay එකක් හෝ blocking side-effect
        // එකක් ඇති නොකරයි — Network Information API/Fetch handler
        // setup එක background thread එකක (Service Worker thread)
        // සිදු වෙනවා.
        doRegister();

        // 🎯 View Transitions (ClientRouter) client-side navigation
        // සඳහාත් register logic එකම attach කරනවා — browser එකෙන්ම
        // existing registration එකක් තියෙනවා නම් silently no-op වෙනවා
        // (duplicate registration නෑ), නමුත් යම් හෙයකින් පළමු
        // registration එක fail වුනා නම් (offline first-load ආදී)
        // ඊළඟ page navigation එකේදී retry වෙන්නත් මේක උදව් වෙනවා.
        document.addEventListener("astro:page-load", doRegister);
      })();
    </script>

    <ClientRouter />
  </head>

  <body class="bg-[#050505] text-[#f8fafc] min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-[#34d399] overflow-x-hidden" style="touch-action: pan-y; overscroll-behavior-x: none;">
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh] flex-1 bg-[#050505]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
