---
import AgeVerificationGate from "@/components/AgeVerificationGate.astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
// + Reader Tools — reading panel (TOC, typography, TTS, focus mode, translate)
import ReaderToolsHead from "@/components/ReaderToolsHead.astro";
import ReaderTools from "@/components/ReaderTools.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  canonical?: string;
  isArticle?: boolean;
}

const {
  title,
  meta_title,
  description,
  image,
  imageWidth,
  imageHeight,
  noindex,
  canonical,
  isArticle = false,
} = Astro.props;

const calculatedTitle = plainify(
  meta_title && meta_title.trim() !== ""
    ? meta_title
    : title && title.trim() !== ""
      ? `${title} - Wal Katha | Sinhala Wal Katha & Wela Katha (2026)`
      : config.site.title
);

const calculatedDescription = plainify(
  description && description.trim() !== ""
    ? description
    : config.metadata.meta_description
);

const siteKeywords = "Wal Katha, Sinhala Wal Katha, Aluth Wal Katha, Wal Katha PDF, Wala Katha, Wela Katha, New Sinhala Wal Katha, Sinhala Wela Katha, Wal Katha New, Aluth Sinhala Wal Katha";

const cleanBaseUrl = config.site.base_url.endsWith("/")
  ? config.site.base_url.slice(0, -1)
  : config.site.base_url;

// TRAILING-SLASH NORMALIZER - origin-aware.
// The previous version tested `url.split("/").pop()` for a dot to detect
// file-like URLs. For a bare origin ("https://www.walakatha.net") that
// last segment is the HOSTNAME, which always contains dots, so the
// homepage was classed as a file and returned unslashed. Result: the
// homepage canonical, og:url and hreflang all disagreed with the sitemap
// entry ("https://www.walakatha.net/") and Cloudflare Pages answered "/"
// requests with a 308 redirect. Splitting the origin off first means the
// dot test only ever runs against a real path segment.
function ensureTrailingSlash(url: string): string {
  if (!url) return url;
  if (url.endsWith("/")) return url;

  // Preserve query strings / hashes if present.
  const [pathPart, ...rest] = url.split(/([?#].*)/);
  const suffix = rest.join("");

  const originMatch = pathPart.match(/^([a-z][a-z0-9+.-]*:\/\/[^/]+)(\/.*)?$/i);
  const origin = originMatch ? originMatch[1] : "";
  const path = originMatch ? (originMatch[2] || "") : pathPart;

  // Bare origin, or root path: always exactly one slash.
  if (path === "" || path === "/") return `${origin}/${suffix}`;

  const lastSegment = path.split("/").pop() || "";
  if (lastSegment.includes(".")) return url;

  return `${origin}${path}/${suffix}`;
}

const currentCanonical = ensureTrailingSlash(
  canonical ? canonical : `${cleanBaseUrl}${Astro.url.pathname}`
);

const finalImageUrl = image
  ? image.startsWith("http")
    ? image
    : `${cleanBaseUrl}${image.startsWith("/") ? image : "/" + image}`
  : `${cleanBaseUrl}${config.metadata.meta_image.startsWith("/") ? config.metadata.meta_image : "/" + config.metadata.meta_image}`;

// OG IMAGE DIMENSIONS - declared, not assumed.
// These used to be hardcoded 1200x630 for every page. Any page passing a
// differently-sized image (the homepage passed logo.webp at 300x50) then
// declared dimensions up to 24x larger than the real file, and Facebook,
// X and WhatsApp all validate declared dimensions before rendering a
// large summary card - on mismatch they silently fall back to no card.
// Callers can now override; the defaults still match the purpose-built
// 1200x630 og-image.webp referenced by config.metadata.meta_image.
const finalImageWidth = imageWidth && imageWidth > 0 ? imageWidth : 1200;
const finalImageHeight = imageHeight && imageHeight > 0 ? imageHeight : 630;

const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

// og:image MIME type auto-detection from file extension, for accurate
// social-crawler (Facebook/Twitter/LinkedIn) preview rendering.
function detectImageMimeType(url: string): string {
  const ext = url.split(".").pop()?.toLowerCase().split("?")[0] ?? "";
  switch (ext) {
    case "webp":
      return "image/webp";
    case "png":
      return "image/png";
    case "jpg":
    case "jpeg":
      return "image/jpeg";
    case "gif":
      return "image/gif";
    case "svg":
      return "image/svg+xml";
    default:
      return "image/webp";
  }
}
const finalImageMimeType = detectImageMimeType(finalImageUrl);

const AGE_GATE_EXCLUDED_PATHS = [
  "/parental-control",
  "/privacy-policy",
  "/terms-and-conditions",
  "/copyright-credit-policy",
  "/contact",
];
const normalizedPathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isAgeGateExcludedPage = AGE_GATE_EXCLUDED_PATHS.includes(normalizedPathname);
---

<!doctype html>
<html
  lang="si"
  class:list={["bg-[#050505]", !isAgeGateExcludedPage && "age-gate-pending"]}
>
  <head>
    {/* charset must land inside the first 1024 bytes of <head>. The HTTP
        Content-Type header already declares utf-8, but the meta tag is
        what keeps Sinhala text rendering correctly when a page is saved,
        proxied or fetched by a crawler that ignores the header. */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="color-scheme" content="dark" />

    <script is:inline define:vars={{ skipAgeGate: isAgeGateExcludedPage }}>
      (function () {
        try {
          var cl = document.documentElement.classList;
          var verified = localStorage.getItem("wk_age_verified") === "true";
          if (verified || skipAgeGate) {
            cl.remove("age-gate-pending");
          } else {
            cl.add("age-gate-pending");
          }
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      // Age-gate swap guard. ClientRouter's swapRootAttributes() re-applies
      // the static "age-gate-pending" class from every incoming document,
      // while the blocking head guard above does not re-run on swap. That
      // race repaints the overlay for one frame on verified sessions.
      // Mutating the incoming document in astro:before-swap runs BEFORE
      // paint, so the flash never reaches the screen.
      (function () {
        if (window.__wkAgeGateSwapGuard) return;
        window.__wkAgeGateSwapGuard = true;

        var STORAGE_KEY = "wk_age_verified";
        var PENDING_CLASS = "age-gate-pending";

        function isVerified() {
          try {
            return localStorage.getItem(STORAGE_KEY) === "true";
          } catch (e) {
            return false;
          }
        }

        document.addEventListener("astro:before-swap", function (event) {
          if (!isVerified()) return;
          try {
            var incoming = event.newDocument;
            if (!incoming) return;
            if (incoming.documentElement) {
              incoming.documentElement.classList.remove(PENDING_CLASS);
            }
            var overlay = incoming.getElementById("age-gate-overlay");
            if (overlay) overlay.style.display = "none";
          } catch (e) {}
        });

        // Safety net: still executes before the next paint.
        document.addEventListener("astro:after-swap", function () {
          if (!isVerified()) return;
          try {
            document.documentElement.classList.remove(PENDING_CLASS);
            var overlay = document.getElementById("age-gate-overlay");
            if (overlay) overlay.style.display = "none";
          } catch (e) {}
        });
      })();
    </script>

    <style is:inline>
      html {
        background-color: #050505;
      }
      html.age-gate-pending,
      html.age-gate-pending body {
        height: 100%;
        overflow: hidden !important;
        overscroll-behavior: none;
      }
      html.age-gate-pending body {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        touch-action: none;
      }
      html.age-gate-pending body > *:not(#age-gate-overlay) {
        filter: blur(6px);
        pointer-events: none;
        user-select: none;
        -webkit-user-select: none;
        transition: filter 0.4s ease;
      }
      #age-gate-overlay {
        display: none;
      }
      html.age-gate-pending #age-gate-overlay {
        display: flex;
      }

      .age-gate-overlay {
        position: fixed;
        inset: 0;
        z-index: 999999;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(1, 2, 3, 0.4);
        -webkit-backdrop-filter: blur(18px);
        backdrop-filter: blur(18px);
        opacity: 1;
        transition: opacity 0.45s ease;
      }
      .age-gate-overlay--closing {
        opacity: 0;
        pointer-events: none;
      }
      .age-gate-card {
        position: relative;
        width: 100%;
        max-width: 26rem;
        max-height: 92vh;
        overflow-y: auto;
        background: #0c0d10;
        border: 1px solid rgba(1, 173, 159, 0.35);
        border-radius: 1.25rem;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
        padding: clamp(1.25rem, 4vw, 1.75rem) clamp(1rem, 4vw, 1.5rem);
        text-align: center;
      }
      .age-gate-live-dot {
        position: absolute;
        top: 0.85rem;
        right: 0.85rem;
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 999px;
        background-color: #ef4444;
        z-index: 2;
      }
      .age-gate-icon-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.25rem;
        height: 3.25rem;
        margin: 0 auto 0.75rem;
        border-radius: 999px;
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #f87171;
        animation: age-gate-icon-pulse 1.4s ease-in-out infinite;
      }
      .age-gate-icon-svg {
        width: 1.75rem;
        height: 1.75rem;
      }
      @keyframes age-gate-icon-pulse {
        0%, 100% {
          transform: scale(1);
          box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 0 12px rgba(239, 68, 68, 0);
        }
      }
      .age-gate-brand {
        font-size: clamp(0.65rem, 1.6vw, 0.7rem);
        font-weight: 800;
        letter-spacing: 0.15em;
        color: #01ad9f;
        margin: 0 0 0.5rem;
      }
      .age-gate-title {
        font-size: clamp(1rem, 4vw, 1.2rem);
        font-weight: 800;
        color: #f8f8ff;
        margin: 0 0 0.75rem;
        line-height: 1.5;
      }
      .age-gate-title-accent {
        color: #f87171;
      }
      .age-gate-desc {
        font-size: clamp(0.76rem, 2.6vw, 0.84rem);
        line-height: 1.6;
        color: rgba(248, 248, 255, 0.65);
        margin: 0 0 1.25rem;
      }
      .age-gate-link {
        color: #01ad9f;
        text-decoration: underline;
      }
      .age-gate-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
      }
      .age-gate-enter-btn {
        width: 100%;
        background-color: #01ad9f;
        color: #010203;
        font-weight: 800;
        font-size: clamp(0.8rem, 2.8vw, 0.87rem);
        padding: clamp(0.7rem, 2.5vw, 0.85rem) 1.5rem;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }
      .age-gate-enter-btn:hover {
        background-color: #01c4b4;
      }
      .age-gate-exit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.4);
        font-weight: 700;
        font-size: clamp(0.68rem, 2.2vw, 0.74rem);
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
      }
      .age-gate-exit-btn:hover {
        background-color: #ef4444;
        color: #ffffff;
      }
      .age-gate-noscript-note {
        font-size: clamp(0.68rem, 2.2vw, 0.74rem);
        line-height: 1.6;
        color: #01ad9f;
        background-color: rgba(1, 173, 159, 0.08);
        border: 1px solid rgba(1, 173, 159, 0.35);
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        margin: 0.9rem 0 0;
      }
      .age-gate-footer-note {
        margin-top: 1.1rem;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
      }
      .age-gate-parents-link {
        font-size: clamp(0.7rem, 2.4vw, 0.76rem);
        font-weight: 700;
        color: #01ad9f;
        text-decoration: underline;
      }
      .age-gate-success-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 0;
      }
      .age-gate-success-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        margin: 0 auto 1rem;
        border-radius: 999px;
        background: rgba(1, 173, 159, 0.12);
        border: 1px solid rgba(1, 173, 159, 0.4);
        color: #01ad9f;
        animation: age-gate-success-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .age-gate-success-svg {
        width: 2rem;
        height: 2rem;
      }
      .age-gate-success-text {
        font-size: clamp(0.85rem, 2.8vw, 0.9rem);
        font-weight: 700;
        color: #f8f8ff;
        line-height: 1.6;
      }
      @keyframes age-gate-success-pop {
        0% { transform: scale(0.5); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
      }

      @media (max-width: 360px) {
        .age-gate-overlay {
          padding: 0.75rem;
        }
        .age-gate-card {
          border-radius: 1rem;
        }
        .age-gate-live-dot {
          top: 0.7rem;
          right: 0.7rem;
        }
        .age-gate-icon-badge {
          width: 2.75rem;
          height: 2.75rem;
          margin-bottom: 0.6rem;
        }
        .age-gate-icon-svg {
          width: 1.5rem;
          height: 1.5rem;
        }
      }

      @media (min-width: 768px) {
        .age-gate-card {
          max-width: 30rem;
          padding: 2.25rem 2.25rem;
          border-radius: 1.5rem;
        }
        .age-gate-icon-badge {
          width: 3.75rem;
          height: 3.75rem;
          margin-bottom: 1rem;
        }
        .age-gate-icon-svg {
          width: 2rem;
          height: 2rem;
        }
        .age-gate-actions {
          flex-direction: row;
          justify-content: center;
          gap: 0.9rem;
        }
        .age-gate-enter-btn {
          width: auto;
          flex: 1 1 auto;
          max-width: 20rem;
        }
      }

      @media (min-width: 1200px) {
        .age-gate-card {
          max-width: 32rem;
        }
      }

      @media (max-height: 480px) {
        .age-gate-card {
          padding-top: 1rem;
          padding-bottom: 1rem;
        }
        .age-gate-icon-badge {
          width: 2.25rem;
          height: 2.25rem;
          margin-bottom: 0.4rem;
        }
        .age-gate-icon-svg {
          width: 1.25rem;
          height: 1.25rem;
        }
        .age-gate-desc {
          margin-bottom: 0.75rem;
        }
        .age-gate-footer-note {
          margin-top: 0.6rem;
          padding-top: 0.5rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .age-gate-overlay,
        .age-gate-success-badge,
        .age-gate-icon-badge {
          transition: none;
          animation: none;
        }
      }
    </style>

    <style>
      html, body {
        background-color: #050505;
        color: #f8fafc;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
        max-width: 100vw;
        touch-action: pan-y;
        overscroll-behavior-x: none;
      }
      .row {
        overflow-x: hidden;
        max-width: 100%;
      }
      #main-content { min-height: 60vh; }
    </style>

    <style>
      body {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }
      input,
      textarea,
      select,
      option,
      [contenteditable="true"],
      [contenteditable=""] {
        -webkit-user-select: text !important;
        -moz-user-select: text !important;
        -ms-user-select: text !important;
        user-select: text !important;
      }
      img {
        -webkit-user-drag: none;
        user-drag: none;
      }
    </style>
    <style is:global>
      #content-protection-toast {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        width: min(78vw, 240px);
        background: #0c0d10;
        border: 1px solid rgba(1, 173, 159, 0.35);
        color: #F8F8FF;
        padding: 18px 16px 16px;
        border-radius: 1.25rem;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.03);
        text-align: center;
        user-select: none;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, -50%) scale(0.9);
        transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      #content-protection-toast.show {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
      #content-protection-toast .cp-icon-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        background: rgba(1, 173, 159, 0.12);
        border: 1px solid rgba(1, 173, 159, 0.35);
        color: #01AD9F;
        flex-shrink: 0;
        box-shadow: 0 0 14px rgba(1, 173, 159, 0.25);
      }
      #content-protection-toast .cp-icon-wrap svg {
        display: block;
        width: 17px;
        height: 17px;
      }
      #content-protection-toast .cp-text {
        font-size: 12.5px;
        font-weight: 700;
        line-height: 1.5;
      }
      @media (prefers-reduced-motion: reduce) {
        #content-protection-toast {
          transition: opacity 0.15s ease;
        }
      }
    </style>

    {/* rel="shortcut icon" is a legacy alias no spec has required since
        HTML5; rel="icon" is the current form and every browser honours it.
        apple-touch-icon was missing entirely, so iOS "Add to Home Screen"
        fell back to a screenshot - app-icon.jpg already ships in public/. */}
    <link rel="icon" href={config.site.favicon} />
    <link rel="apple-touch-icon" href="/images/app-icon.jpg" />
    <link rel="manifest" href="/manifest.json" />

    {/* The comments/likes Cloudflare Worker is already allowed by the CSP
        connect-src in public/_headers, but the DNS lookup and TLS
        handshake only began when the first fetch fired. Warming the
        connection here removes that round-trip from interaction latency,
        which is what INP measures. */}
    <link rel="preconnect" href="https://comments.wala-katha.workers.dev" crossorigin />
    <link rel="dns-prefetch" href="https://comments.wala-katha.workers.dev" />

    {isHomePage && (
      <link rel="preload" as="image" href="/images/slider/slide-1.webp" fetchpriority="high" />
    )}

    {fontEntries.map(([key]) => {
      const cssVar = `--font-${key}` as any;
      return <Font cssVariable={cssVar} preload />;
    })}

    <meta name="theme-color" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#050505" />
    <meta name="msapplication-TileColor" content="#050505" />
    {/* REMOVED: meta name="theme-name" content="bookworm-light-astro" -
        leftover starter-template metadata. It carries no SEO or rendering
        value and publicly discloses the theme this site was built from. */}
    <meta name="generator" content={Astro.generator} />

    <link rel="alternate" hreflang="si" href={currentCanonical} />
    <link rel="alternate" hreflang="x-default" href={currentCanonical} />

    <title>{calculatedTitle}</title>
    <link rel="canonical" href={currentCanonical} />
    <meta name="description" content={calculatedDescription} />

    {/* robots must apply to EVERY page including articles. Previously it
        sat inside the !isArticle block, so blog posts shipped no robots
        tag at all - losing max-image-preview:large (small thumbnails in
        SERPs) and silently ignoring the noindex prop. PostSingle.astro
        deliberately does not emit robots, so there is no duplicate.
        noindex now pairs with "follow" rather than "nofollow": the pages
        that need noindex here are utility pages (internal search), and
        nofollow would strand the link equity already pointing through
        them instead of letting it flow on to the real articles. */}
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    }

    {!isArticle && (
      <>
        <meta name="keywords" content={siteKeywords} />
        <meta name="author" content={config.metadata.meta_author} />
        <meta property="og:title" content={calculatedTitle} />
        <meta property="og:description" content={calculatedDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={currentCanonical} />
        <meta property="og:locale" content="si_LK" />
        <meta property="og:site_name" content={config.site.title} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={calculatedTitle} />
        <meta name="twitter:description" content={calculatedDescription} />
        {/* REMOVED: twitter:image:width / twitter:image:height - neither
            exists in the Twitter Cards specification, so every crawler
            discarded them. Real image dimensions travel in the og:image:*
            tags below, which X reads as a fallback. */}
      </>
    )}

    <meta property="og:image" content={finalImageUrl} />
    <meta property="og:image:secure_url" content={finalImageUrl} />
    <meta property="og:image:width" content={String(finalImageWidth)} />
    <meta property="og:image:height" content={String(finalImageHeight)} />
    <meta property="og:image:type" content={finalImageMimeType} />
    <meta name="twitter:image" content={finalImageUrl} />

    <slot name="head" />

    <script is:inline>
      (function registerServiceWorkerEarly() {
        if (!("serviceWorker" in navigator)) return;
        navigator.serviceWorker
          .register("/sw.js")
          .then((registration) => {
            console.log("SW registered (early):", registration.scope);
          })
          .catch((err) => {
            console.warn("SW registration failed:", err);
          });
      })();
    </script>

    <script is:inline define:vars={{ gtmEnabled: config.google_tag_manager.enable }}>
      (function initWebVitalsMonitoring() {
        if (typeof PerformanceObserver === "undefined") return;

        function reportMetric(name, value, extra) {
          const displayValue = name === "CLS" ? value.toFixed(3) : Math.round(value);
          const analyticsValue = Math.round(name === "CLS" ? value * 1000 : value);
          console.log(`[Web Vitals] ${name}:`, displayValue, extra || "");
          if (gtmEnabled && window.dataLayer) {
            window.dataLayer.push({
              event: "web_vitals",
              metric_name: name,
              metric_value: analyticsValue,
            });
          }
        }

        window.addEventListener("load", function () {
          try {
            new PerformanceObserver((list) => {
              const entries = list.getEntries();
              const last = entries[entries.length - 1];
              if (last) reportMetric("LCP", last.renderTime || last.loadTime || last.startTime);
            }).observe({ type: "largest-contentful-paint", buffered: true });

            let clsValue = 0;
            new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (!entry.hadRecentInput) clsValue += entry.value;
              }
              reportMetric("CLS", clsValue);
            }).observe({ type: "layout-shift", buffered: true });

            new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (entry.duration) reportMetric("INP", entry.duration, entry.name);
              }
            }).observe({ type: "event", buffered: true, durationThreshold: 40 });
          } catch (err) {
            console.warn("Web Vitals monitoring unavailable:", err);
          }
        });
      })();
    </script>

    <script is:inline>
      (function initContentProtection() {
        let lastNoticeAt = 0;
        const NOTICE_THROTTLE_MS = 2200;
        const NOTICE_VISIBLE_MS = 2600;
        const NOTICE_MESSAGE = "මෙම අන්තර්ගතය පිටපත් කිරීම වළක්වා ඇත";

        function isEditableTarget(target) {
          if (!target || !target.tagName) return false;
          const tag = target.tagName.toLowerCase();
          if (tag === "input" || tag === "textarea" || tag === "select" || tag === "option") return true;
          if (target.isContentEditable) return true;
          if (target.closest && target.closest("[data-allow-select]")) return true;
          return false;
        }

        function buildLockIconSvg() {
          return (
            '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
            'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
            '<rect x="4" y="10.5" width="16" height="9.5" rx="2.2"></rect>' +
            '<path d="M7.5 10.5V7.2a4.5 4.5 0 019 0v3.3"></path>' +
            '<circle cx="12" cy="14.7" r="1.4" fill="currentColor" stroke="none"></circle>' +
            "</svg>"
          );
        }

        function showProtectionNotice() {
          const now = Date.now();
          if (now - lastNoticeAt < NOTICE_THROTTLE_MS) return;
          lastNoticeAt = now;

          let toast = document.getElementById("content-protection-toast");
          if (!toast) {
            toast = document.createElement("div");
            toast.id = "content-protection-toast";
            toast.setAttribute("role", "status");
            toast.setAttribute("aria-live", "polite");

            const iconWrap = document.createElement("span");
            iconWrap.className = "cp-icon-wrap";
            iconWrap.setAttribute("aria-hidden", "true");
            iconWrap.innerHTML = buildLockIconSvg();

            const text = document.createElement("span");
            text.className = "cp-text";

            toast.appendChild(iconWrap);
            toast.appendChild(text);
            document.body.appendChild(toast);
          }

          const textEl = toast.querySelector(".cp-text");
          if (textEl) textEl.textContent = NOTICE_MESSAGE;

          toast.classList.add("show");
          clearTimeout(toast._cpHideTimer);
          toast._cpHideTimer = setTimeout(() => {
            toast.classList.remove("show");
          }, NOTICE_VISIBLE_MS);
        }

        document.addEventListener("contextmenu", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
          showProtectionNotice();
        });

        document.addEventListener("copy", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
          showProtectionNotice();
        });

        document.addEventListener("cut", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
        });

        document.addEventListener("selectstart", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
        });

        document.addEventListener("dragstart", function (e) {
          const target = e.target;
          if (target && target.tagName && target.tagName.toLowerCase() === "img") {
            e.preventDefault();
          }
        });
      })();
    </script>

    <ClientRouter fallback="swap" />

    {/* + Reader Tools — blocking inline script that restores the saved
        reading preferences (surface colour, font, size, line-height)
        before first paint. Placed last in <head>, mirroring the age-gate
        guard pattern above: without it the first frame renders with the
        default dark surface and then repaints to the reader's chosen
        paper/sepia surface, producing a visible flash on every
        navigation. Reads localStorage only - no network, no blocking I/O. */}
    <ReaderToolsHead />
  </head>

  <body class="bg-[#050505] text-[#f8fafc] min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-[#34d399] overflow-x-hidden" style="touch-action: pan-y; overscroll-behavior-x: none;">
    <AgeVerificationGate skip={isAgeGateExcludedPage} />
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh] flex-1 bg-[#050505]">
      <slot />
    </main>
    <Footer />

    {/* + Reader Tools — floating reading panel (edge FAB + slide-in
        drawer). Mounted last so it paints above Footer without needing a
        stacking-context hack, and stays below #age-gate-overlay
        (z-index 999999) so an unverified visitor cannot reach it. */}
    <ReaderTools />
  </body>
</html>
