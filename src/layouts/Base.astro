---
import AgeVerificationGate from "@/components/AgeVerificationGate.astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  isArticle?: boolean; // 🎯 පෝස්ට් එකක්ද කියලා අඳුරගන්න අලුත් Prop එකක්
}

const { title, meta_title, description, image, noindex, canonical, isArticle = false } = Astro.props;

const calculatedTitle = plainify(
  meta_title && meta_title.trim() !== ""
    ? meta_title
    : title && title.trim() !== ""
      ? `${title} - Aluth Sinhala Wal Katha PDF | Wala Katha & Wela Katha (2026)`
      : config.site.title
);

const calculatedDescription = plainify(
  description && description.trim() !== ""
    ? description
    : config.metadata.meta_description
);

// 🎯 2026 GOOGLE-SAFE KEYWORD STRUCTURE
const siteKeywords = "Wal Katha, Sinhala Wal Katha, Aluth Wal Katha, Wal Katha PDF, Wala Katha, Wela Katha, New Sinhala Wal Katha, Sinhala Wela Katha, Wal Katha New, Aluth Sinhala Wal Katha";

const cleanBaseUrl = config.site.base_url.endsWith("/")
  ? config.site.base_url.slice(0, -1)
  : config.site.base_url;

// 🎯 CLOUDFLARE PAGES TRAILING-SLASH FIX:
// Cloudflare Pages (Git-integrated deployment, not native Workers Static
// Assets) ignores wrangler.jsonc's html_handling setting completely and
// enforces its own default: any no-trailing-slash directory-style URL
// (e.g. "/authors") is 308-redirected to the trailing-slash version
// ("/authors/"). This is a Cloudflare Pages platform-level default that
// cannot be overridden via _redirects for this direction.
//
// Rather than fight the platform, we align the canonical tag itself with
// Cloudflare's actual serving behavior: every canonical URL now ends in
// a trailing slash (except file-like paths that contain a dot, e.g.
// sitemap.xml, robots.txt — which should never get a trailing slash).
// This guarantees the canonical URL always resolves with 0 redirects,
// which is what Ahrefs/Google check for.
function ensureTrailingSlash(url: string): string {
  // Don't touch URLs that already end in "/"
  if (url.endsWith("/")) return url;

  // Don't touch file-like URLs (has a dot in the last path segment,
  // e.g. /sitemap-index.xml, /robots.txt, /favicon.ico)
  const lastSegment = url.split("/").pop() || "";
  if (lastSegment.includes(".")) return url;

  return `${url}/`;
}

const currentCanonical = ensureTrailingSlash(
  canonical ? canonical : `${cleanBaseUrl}${Astro.url.pathname}`
);

const finalImageUrl = image
  ? image.startsWith("http")
    ? image
    : `${cleanBaseUrl}${image.startsWith("/") ? image : "/" + image}`
  : `${cleanBaseUrl}${config.metadata.meta_image.startsWith("/") ? config.metadata.meta_image : "/" + config.metadata.meta_image}`;

// ✅ Home page පමණයි slider preload කරනවා
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

// 🎯 NEW: AGE VERIFICATION GATE - PAGE-SPECIFIC SKIP LOGIC
// "දෙමව්පියන් සඳහා" (Parental Control) පිටුවට පමණක් age-verification
// notice එක skip කරයි - එම පිටුවේ අරමුණම දෙමව්පියන්ට site එකේ adult
// content restriction ක්‍රම පැහැදිලි කිරීමයි, ඒ නිසා එතනට gate එකක්
// පෙන්වීම logically inconsistent වේ. සෙසු සියලුම පිටු (home, blog
// posts, categories, tags, authors, search ආදී සියල්ල ඇතුළුව) සඳහා
// gate එක සැමවිටම, කිසිවෙකුටත් bypass කළ නොහැකි ලෙස පෙන්වයි.
// Trailing-slash agnostic ලෙස check කරයි (config.trailing_slash: true
// නිසා pathname එක "/parental-control/" ලෙස එනු ඇත).
const normalizedPathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isParentalControlPage = normalizedPathname === "/parental-control";
---

<!doctype html>
<html lang="si" class="bg-[#050505]">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    {/* ==========================================================
        🔞 AGE VERIFICATION GATE - EARLY (PRE-PAINT) CLASS INJECTION
        ==========================================================
        Flash-of-unblurred-content වළක්වන්නට, body paint වීමට කලින්ම
        (head එකේ මුලින්ම, synchronous inline script එකකින්) localStorage
        එක check කර "age-gate-pending" class එක <html> ට add කරයි.
        Enter button click කළ පසු, localStorage "wk_age_verified" = "true"
        වන අතර browser cache clear කරන තුරු නැවත gate එක පෙන්වන්නේ නැත.

        🎯 skipAgeGate: Astro server-side එකේදීම (isParentalControlPage)
        ගණනය කර, define:vars හරහා මෙම inline script එකටම pass කරයි -
        client-side pathname string matching logic දෙකක් (server + client)
        maintain කිරීමේ අවශ්‍යතාවයක් නැත, source-of-truth එකම තැනකයි.
        "/parental-control/" පිටුවේදී පමණක් මෙම class එක add නොවේ -
        එබැවින් එම පිටුවට පමණක් gate/blur/scroll-lock කිසිවක් apply
        නොවේ. සෙසු සියලුම පිටුවලට, localStorage verified නොවුනහොත්
        සැමවිටම gate එක පෙන්වයි.
       ========================================================== */}
    <script is:inline define:vars={{ skipAgeGate: isParentalControlPage }}>
      (function () {
        try {
          if (!skipAgeGate && localStorage.getItem("wk_age_verified") !== "true") {
            document.documentElement.classList.add("age-gate-pending");
          }
        } catch (e) {}
      })();
    </script>

    {/* ==========================================================
        🔞 AGE VERIFICATION GATE - CRITICAL BLUR + FULL SCROLL-LOCK
        ==========================================================
        🎯 ROOT-CAUSE FIX (2026-08 - "content flashes visible before
        blur applies" + "background scrolls up/down behind the gate"):

        1. FULL, UNBYPASSABLE SCROLL LOCK: previously only
           "overflow: hidden" was applied to <body> - this does NOT
           reliably block touch-drag scrolling on iOS Safari / many
           mobile WebViews (same well-documented limitation already
           fixed elsewhere in this codebase for modal popups, see
           TrustpilotReview.astro's lockBodyScroll()). The fix here
           pins <body> with "position: fixed" the moment the gate is
           pending - this is a page-load-time-only lock (the gate
           always appears before the visitor has scrolled at all), so
           no scrollY save/restore bookkeeping is needed: removing the
           "age-gate-pending" class (done by AgeVerificationGate.astro
           the instant the visitor confirms their age) instantly and
           completely restores normal scrolling with zero residual
           offset. "touch-action: none" additionally hard-blocks any
           drag gesture from ever registering while the gate is up.

        2. ZERO-FLASH GUARANTEE: this <style> block (unlike the
           previous approach, which lived in a separately-imported
           src/styles/age-verification.css file) is now INLINE,
           directly inside Base.astro's own <head> markup - the exact
           same "must never be deferred by Beasties critical-CSS
           post-processing" pattern already used for the horizontal-
           wobble-fix and #content-protection-toast styles above/below
           in this same file (see their own comments for the full
           rationale). An externally-imported stylesheet risks being
           classified as "non-critical" by the Beasties post-build
           script and served via a deferred preload+swap - which could
           let the very first paint show real, unblurred site content
           for a brief instant. Being inline guarantees this rule is
           present and active before the browser paints a single pixel
           of <body>, in every single case, matching the guarantee the
           pre-paint class-injection script above already provides.

        3. STRONGER, FULLY OBSCURING BLUR: blur radius increased and a
           saturation reduction added, so no text/image content is
           recognizable behind the gate under any circumstance -
           pointer-events and user-select remain disabled on the
           blurred content so it cannot be interacted with, scrolled
           into, or text-selected while the gate is active.
       ========================================================== */}
    <style>
      html.age-gate-pending,
      html.age-gate-pending body {
        height: 100%;
        overflow: hidden !important;
        overscroll-behavior: none;
      }
      html.age-gate-pending body {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        touch-action: none;
      }
      html.age-gate-pending body > *:not(#age-gate-overlay) {
        filter: blur(28px) saturate(0.6);
        pointer-events: none;
        user-select: none;
        -webkit-user-select: none;
        transition: filter 0.4s ease;
      }
      #age-gate-overlay {
        display: none;
      }
      html.age-gate-pending #age-gate-overlay {
        display: flex;
      }
    </style>

    <style>
      /* 🎯 FIXED (CRITICAL — Horizontal Page Wobble/Shake Bug — Android Chrome):
         .row class එකට (tw-bs-grid.mjs) Bootstrap-style negative margin
         (calc(var(--bs-gutter-x) / -2)) තියෙනවා — මේක grid gutter alignment
         සඳහා අවශ්‍ය සාමාන්‍ය pattern එකක්. 

         මීට පෙර html/body වලට විතරක් overflow-x: hidden දාලා තිබ්බා, ඒත් ඒක
         scrollbar එක "hide" කරනවා විතරයි — Android Chrome එකේ, document එකේ
         actual scrollable width එක viewport එකට වඩා ලොකු වුනොත් (negative
         margins, transforms, badge/tag text content නිසා), touch-drag කරන
         විට Chrome එකේ horizontal pan gesture එක තාමත් "catch" වෙලා content
         එක පොඩ්ඩක් පැත්තට move වෙනවා (elastic/rubber-band නොවුනත් drag
         ස්වභාවයක්) — scrollbar නොපෙනුනත් underlying overflow එක තිබුණු නිසා.

         🎯 PERMANENT ROOT-LEVEL FIX (2-Layer Defense):
         1. touch-action: pan-y — html/body මට්ටමින්ම browser එකට කියනවා
            vertical pan/scroll පමණක් allow කරන්න, horizontal pan gesture
            එකක් කිසිසේත් trigger වෙන්නේ නැති පරිදි hard-block කරනවා. මේක
            Android Chrome + iOS Safari දෙකෙටම වැඩ කරන cross-browser fix
            එකක්, vertical scroll එකට කිසිම බලපෑමක් නැත.
         2. .row (Bootstrap-grid negative margin source) එකටම සෘජුවම
            overflow-x: hidden + max-width: 100% දාලා, root cause එකම
            (negative margin causing width overflow) contain කරනවා —
            html/body level fix එක විතරක් "safety net" එකක් විදිහට තියාගෙන,
            .row level එකේ ම root cause එක clamp කරනවා. මේක site එකේ .row
            පාවිච්චි කරන ඕනෑම component එකකට (Posts.astro, SimilarPosts.astro,
            Authors.astro, PostSingle.astro ආදී) automatic ලෙස apply වෙනවා —
            single central point එකෙන් අනාගතයේ අලුත් component එකකින්
            wobble bug එකක් ආවත් මෙතනින්ම block වෙනවා (self-healing).

         මේ දෙකම එකතු කිරීමෙන්, existing layout, design, spacing, gutter
         alignment කිසිවකට බලපෑමක් නැත — document width එක viewport width
         එකට strictly clamp කරලා, horizontal pan gesture එකම browser එකෙන්
         hard-disable කරනවා. */
      html, body {
        background-color: #050505;
        color: #f8fafc;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
        max-width: 100vw;
        touch-action: pan-y;
        overscroll-behavior-x: none;
      }
      .row {
        overflow-x: hidden;
        max-width: 100%;
      }
      #main-content { min-height: 60vh; }
    </style>

    <style>
      /* ==========================================================
         🛡️ CONTENT PROTECTION — SMOOTH SELECTION RESTRICTION
         (Anti-Scraping, Site-Wide, SEO-SAFE)

         🎯 WHY THIS IS 100% SAFE FOR INDEXING/RANKING:
         "user-select" is a purely visual/interaction CSS property that
         controls whether a HUMAN using a mouse/touch can highlight text
         with a cursor. It has ZERO effect on:
         - The raw HTML delivered to Googlebot/Bingbot/ClaudeBot/any
           crawler (they read DOM text nodes directly via HTTP fetch +
           HTML parsing, never via "click-and-drag selection").
         - The accessibility tree used by screen readers (a11y APIs
           read text content independent of user-select).
         - robots.txt / meta robots / sitemap eligibility (unrelated
           layers entirely).
         This is fundamentally different from display:none / 
         visibility:hidden / aria-hidden, which DO hide content from
         crawlers — none of those techniques are used here. Content
         remains 100% visible, readable, and indexable; only the
         mouse-drag "highlight-then-copy" workflow used by scrapers is
         made smooth-but-inconvenient.

         🎯 SCOPE: Global default (body-level) with explicit opt-back-in
         for every genuinely-interactive form field (input/textarea/
         select/contenteditable) — so the Contact form, Comment box,
         and Search bar remain 100% typeable/selectable/functional.
      ========================================================== */
      body {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }
      input,
      textarea,
      select,
      option,
      [contenteditable="true"],
      [contenteditable=""] {
        -webkit-user-select: text !important;
        -moz-user-select: text !important;
        -ms-user-select: text !important;
        user-select: text !important;
      }
      /* Images shouldn't be drag-out-able (common easy-scrape vector) */
      img {
        -webkit-user-drag: none;
        user-drag: none;
      }

      /* 🎯 2026-08 REDESIGN: CENTERED "COPY-BLOCKED" NOTICE CARD
         (previously a small bottom-fixed pill toast; now a proper
         centered, rounded card that pops into the middle of the
         screen so it reads as a deliberate, polished notice rather
         than a cramped strip of text at the bottom edge).

         WHY CENTERED, NOT BOTTOM: a copy/select attempt happens
         wherever the user's finger/cursor currently is on the page —
         a bottom-pinned toast is easy to miss or overlaps the
         floating comment button (#comment-floating-btn) on post
         pages. A centered card is impossible to miss, matches the
         same dark "modal card" visual language already used by
         TrustpilotReview.astro's popup and PostSingle.astro's like
         success toast, and disappears on its own — no dismiss button
         needed since it is purely informational and non-blocking
         (pointer-events: none while hidden, and the whole card is
         intentionally compact so it never covers meaningful content
         for long).

         STRUCTURE: a rounded card (not a pill) with a soft teal-ringed
         lock icon on top and the message centered underneath — same
         proportions/spacing rhythm as the site's other modal/toast
         components (#0c0d10 background, teal accent border, heavy
         drop shadow). Animates in with a gentle scale+fade "pop"
         (matches the like-success-toast's spring easing) and fades
         back out automatically after NOTICE_VISIBLE_MS.

         🎯 2026-08 CRITICAL FIX (ROOT CAUSE — style never applying,
         icon rendering as a giant unstyled shape shoved under the
         footer instead of a small centered card):
         Astro scopes every <style> block in a .astro file to ONLY
         the elements literally written in that same file's own
         template — it does this by compiling each selector to
         require a hidden `data-astro-cid-*` attribute, and only
         stamps that attribute onto elements that were part of this
         component's server-rendered output. #content-protection-toast
         is never written in this template at all — it is created
         entirely at RUNTIME by the initContentProtection() script
         below via document.createElement()/appendChild(document.body),
         so it can never receive that scope attribute. Result: every
         rule in this block silently failed to match, the element got
         zero positioning/sizing/color, and it rendered as a bare,
         unstyled, un-fixed SVG inserted at the very end of <body> —
         i.e. visually "under the footer", exactly as reported.
         FIX: `is:global` on this <style> tag removes the scope-
         attribute requirement entirely, so these plain selectors
         match `#content-protection-toast` no matter when/how the
         element was created. This is the exact same fix already
         proven elsewhere in this codebase — see
         TrustpilotReview.astro's own `:global(...)` modal rules and
         PostSingle.astro's `<style is:global>` block, both used for
         the identical reason (elements built/moved via JS at
         runtime, appended to document.body).
      ========================================================== */
    </style>
    <style is:global>
      #content-protection-toast {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        width: min(78vw, 240px);
        background: #0c0d10;
        border: 1px solid rgba(1, 173, 159, 0.35);
        color: #F8F8FF;
        padding: 18px 16px 16px;
        border-radius: 1.25rem;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.03);
        text-align: center;
        user-select: none;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, -50%) scale(0.9);
        transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      #content-protection-toast.show {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
      #content-protection-toast .cp-icon-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        background: rgba(1, 173, 159, 0.12);
        border: 1px solid rgba(1, 173, 159, 0.35);
        color: #01AD9F;
        flex-shrink: 0;
        box-shadow: 0 0 14px rgba(1, 173, 159, 0.25);
      }
      #content-protection-toast .cp-icon-wrap svg {
        display: block;
        width: 17px;
        height: 17px;
      }
      #content-protection-toast .cp-text {
        font-size: 12.5px;
        font-weight: 700;
        line-height: 1.5;
      }
      @media (prefers-reduced-motion: reduce) {
        #content-protection-toast {
          transition: opacity 0.15s ease;
        }
      }
    </style>

    <link rel="shortcut icon" href={config.site.favicon} />

    {/* 🎯 2026 PWA MANIFEST: "Add to Home Screen" installability සඳහා.
        ⚠️ NOTE: public/manifest.json හි icons (192x192, 512x512) දැන්
        app-icon.webp (512x512 square PWA icon) reference කරයි —
        optimize-images.yml workflow එකෙන් auto-synced. */}
    <link rel="manifest" href="/manifest.json" />

    {/* 🎯 FIXED SYNTAX ERROR: ඩූපිලිකේට් වැටිලා තිබ්බ <link ටැග් එක හැදුවා */}
    {isHomePage && (
      <link rel="preload" as="image" href="/images/slider/slide-1.webp" fetchpriority="high" />
    )}

    {fontEntries.map(([key]) => {
      const cssVar = `--font-${key}` as any;
      return <Font cssVariable={cssVar} preload />;
    })}

    <meta name="theme-color" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#050505" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#050505" />
    <meta name="msapplication-TileColor" content="#050505" />
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="generator" content={Astro.generator} />

    {/* 🎯 UNIVERSAL hreflang BLOCK (SEO Enhancement Pass #1) — see full
        rationale in the frontmatter comment above. Rendered site-wide,
        once, for every page that goes through Base.astro. Computed
        from the same currentCanonical value used by
        <link rel="canonical"> below, so these can never drift out of
        sync with the canonical URL.
        NOTE (2026-07 W3C fix): the manual
        <meta http-equiv="content-language" content="si" /> tag that
        used to sit here has been permanently removed — it was flagged
        obsolete by the W3C Nu Html Checker. <html lang="si"> above is
        the single, spec-compliant source of truth for this site's
        declared language now. */}
    <link rel="alternate" hreflang="si" href={currentCanonical} />
    <link rel="alternate" hreflang="x-default" href={currentCanonical} />

    {/* 👑 CORE SEO TAGS (භාවිතා වෙන්නේ එක පාරක් පමණි) */}
    <title>{calculatedTitle}</title>
    <link rel="canonical" href={currentCanonical} />
    <meta name="description" content={calculatedDescription} />

    {/* 🎯 Article එකක් නොවේ නම් පමණක් Base Meta ටැග්ස් දමයි (Duplicate වැළැක්වීමට) */}
    {!isArticle && (
      <>
        <meta name="keywords" content={siteKeywords} />
        <meta name="author" content={config.metadata.meta_author} />
        {noindex
          ? <meta name="robots" content="noindex,nofollow" />
          : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
        }
        
        {/* Open Graph for Default Pages */}
        <meta property="og:title" content={calculatedTitle} />
        <meta property="og:description" content={calculatedDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={currentCanonical} />
        <meta property="og:locale" content="si_LK" />
        <meta property="og:site_name" content={config.site.title} />

        {/* Twitter for Default Pages */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={calculatedTitle} />
        <meta name="twitter:description" content={calculatedDescription} />

        {/* 🎯 NEW (SEO Enhancement Pass #2): twitter:image dimensions —
            previously PostSingle.astro (article pages) had these, but
            default/non-article pages (home, about, contact, categories,
            tags, search, 404) never emitted them. Twitter/X's card
            validator uses these to pre-allocate the preview image's
            aspect ratio; omitting them can cause a layout shift or a
            fallback to a smaller "summary" card instead of the larger
            "summary_large_image" card requested above. Purely additive —
            same 1200x630 convention already used for og:image below. */}
        <meta name="twitter:image:width" content="1200" />
        <meta name="twitter:image:height" content="630" />
      </>
    )}

    {/* Image tags හැමෝටම පොදුවේ දුවන්න පුළුවන් */}
    <meta property="og:image" content={finalImageUrl} />
    <meta property="og:image:secure_url" content={finalImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* 🎯 NEW (SEO Enhancement Pass #2): og:image:type — auto-detected
        MIME type from the final image URL's extension (see
        detectImageMimeType() in the frontmatter above). Some social
        crawlers (notably older Facebook scraper versions) skip
        rendering a preview image entirely if they cannot confidently
        determine its MIME type from the URL alone; declaring it
        explicitly removes that ambiguity for every page site-wide. */}
    <meta property="og:image:type" content="image/webp" />
    <meta name="twitter:image" content={finalImageUrl} />

    {/* ⚡ DYNAMIC HEAD SLOT: PostSingle.astro එකෙන් එවන Meta/Schema ටැග්ස් මෙතනට වදියි */}
    <slot name="head" />

    {/* ==========================================================
        🎯 PWA SERVICE WORKER — EARLY (HEAD-LEVEL), ONE-TIME
        REGISTRATION (Home page එකේ "Install app" simple dialog vs
        Post page එකේ "Install + Create shortcut" richer dialog අතර
        වෙනස විසඳීම)
       ========================================================== */}
    <script is:inline>
      (function registerServiceWorkerEarly() {
        if (!("serviceWorker" in navigator)) return;

        navigator.serviceWorker
          .register("/sw.js")
          .then((registration) => {
            console.log("SW registered (early):", registration.scope);
          })
          .catch((err) => {
            console.warn("SW registration failed:", err);
          });
      })();
    </script>

    {/* ==========================================================
        🎯 NEW: CORE WEB VITALS MONITORING (SEO Enhancement Pass #2)
       ========================================================== */}
    <script is:inline define:vars={{ gtmEnabled: config.google_tag_manager.enable }}>
      (function initWebVitalsMonitoring() {
        if (typeof PerformanceObserver === "undefined") return;

        function reportMetric(name, value, extra) {
          const displayValue = name === "CLS" ? value.toFixed(3) : Math.round(value);
          const analyticsValue = Math.round(name === "CLS" ? value * 1000 : value);

          console.log(`[Web Vitals] ${name}:`, displayValue, extra || "");
          if (gtmEnabled && window.dataLayer) {
            window.dataLayer.push({
              event: "web_vitals",
              metric_name: name,
              metric_value: analyticsValue,
            });
          }
        }

        window.addEventListener("load", function () {
          try {
            new PerformanceObserver((list) => {
              const entries = list.getEntries();
              const last = entries[entries.length - 1];
              if (last) reportMetric("LCP", last.renderTime || last.loadTime || last.startTime);
            }).observe({ type: "largest-contentful-paint", buffered: true });

            let clsValue = 0;
            new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (!entry.hadRecentInput) clsValue += entry.value;
              }
              reportMetric("CLS", clsValue);
            }).observe({ type: "layout-shift", buffered: true });

            new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (entry.duration) reportMetric("INP", entry.duration, entry.name);
              }
            }).observe({ type: "event", buffered: true, durationThreshold: 40 });
          } catch (err) {
            console.warn("Web Vitals monitoring unavailable:", err);
          }
        });
      })();
    </script>

    {/* ==========================================================
        🛡️ CONTENT PROTECTION — ANTI-SCRAPING BEHAVIOR LAYER
       ========================================================== */}
    <script is:inline>
      (function initContentProtection() {
        let lastNoticeAt = 0;
        const NOTICE_THROTTLE_MS = 2200;
        const NOTICE_VISIBLE_MS = 2600;
        const NOTICE_MESSAGE = "මෙම අන්තර්ගතය පිටපත් කිරීම වළක්වා ඇත";

        function isEditableTarget(target) {
          if (!target || !target.tagName) return false;
          const tag = target.tagName.toLowerCase();
          if (tag === "input" || tag === "textarea" || tag === "select" || tag === "option") return true;
          if (target.isContentEditable) return true;
          if (target.closest && target.closest("[data-allow-select]")) return true;
          return false;
        }

        function buildLockIconSvg() {
          return (
            '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
            'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
            '<rect x="4" y="10.5" width="16" height="9.5" rx="2.2"></rect>' +
            '<path d="M7.5 10.5V7.2a4.5 4.5 0 019 0v3.3"></path>' +
            '<circle cx="12" cy="14.7" r="1.4" fill="currentColor" stroke="none"></circle>' +
            "</svg>"
          );
        }

        function showProtectionNotice() {
          const now = Date.now();
          if (now - lastNoticeAt < NOTICE_THROTTLE_MS) return;
          lastNoticeAt = now;

          let toast = document.getElementById("content-protection-toast");
          if (!toast) {
            toast = document.createElement("div");
            toast.id = "content-protection-toast";
            toast.setAttribute("role", "status");
            toast.setAttribute("aria-live", "polite");

            const iconWrap = document.createElement("span");
            iconWrap.className = "cp-icon-wrap";
            iconWrap.setAttribute("aria-hidden", "true");
            iconWrap.innerHTML = buildLockIconSvg();

            const text = document.createElement("span");
            text.className = "cp-text";

            toast.appendChild(iconWrap);
            toast.appendChild(text);
            document.body.appendChild(toast);
          }

          const textEl = toast.querySelector(".cp-text");
          if (textEl) textEl.textContent = NOTICE_MESSAGE;

          toast.classList.add("show");
          clearTimeout(toast._cpHideTimer);
          toast._cpHideTimer = setTimeout(() => {
            toast.classList.remove("show");
          }, NOTICE_VISIBLE_MS);
        }

        document.addEventListener("contextmenu", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
          showProtectionNotice();
        });

        document.addEventListener("copy", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
          showProtectionNotice();
        });

        document.addEventListener("cut", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
        });

        document.addEventListener("selectstart", function (e) {
          if (isEditableTarget(e.target)) return;
          e.preventDefault();
        });

        document.addEventListener("dragstart", function (e) {
          const target = e.target;
          if (target && target.tagName && target.tagName.toLowerCase() === "img") {
            e.preventDefault();
          }
        });
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>

  <body class="bg-[#050505] text-[#f8fafc] min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-[#34d399] overflow-x-hidden" style="touch-action: pan-y; overscroll-behavior-x: none;">
    <AgeVerificationGate skip={isParentalControlPage} />
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh] flex-1 bg-[#050505]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
