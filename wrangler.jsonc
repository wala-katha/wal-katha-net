// ⚠️ CLOUDFLARE PAGES CONFIGURATION
//
// 🎯 PURPOSE OF THIS FILE:
// Cloudflare Pages build system auto-scans the repository root for a Wrangler
// configuration file at the start of every build.
//
// 🛠️ FIXES APPLIED:
// 1. "pages_build_output_dir": Declares "./dist" as the build output directory to
//    satisfy the Pages build scanner validation check.
// 2. "assets" BLOCK REMOVED: Cloudflare Pages strictly forbids the "assets" property
//    (which is exclusively reserved for Cloudflare Workers Static Assets).
//    Including "assets" causes a fatal validation crash on Pages builds.
{
  "name": "walakatha",
  "compatibility_date": "2026-03-01",
  "pages_build_output_dir": "./dist"
}
