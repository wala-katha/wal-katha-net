-  animation: rt-stop-pulse 1.1s ease-in-out infinite;
+  color: #b91c1c;
 }
-@keyframes rt-stop-pulse {
-  0%,
-  100% {
-    opacity: 1;
-  }
-  50% {
-    opacity: 0.25;
-  }
+.rt-stopfab-badge svg {
+  display: block;
+  width: 13px;
+  height: 13px;
+}
+.rt-stopfab-txt {
+  letter-spacing: 0.01em;
