-}
-html[data-rt-focus="on"][data-rt-has-article="1"] [data-rt-dim] {
-  opacity: 0.55;
-}
-html[data-rt-focus="on"][data-rt-has-article="1"] [data-rt-dim]:hover,
-html[data-rt-focus="on"][data-rt-has-article="1"] [data-rt-dim]:focus-within {
-  opacity: 1;
-}
-
