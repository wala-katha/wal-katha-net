+/* percentage chip - tabular numerals so the width never jitters */
+.rt-stopfab-pct {
+  min-width: 36px;
+  padding: 3px 7px;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.14);
+  font-size: 10.5px;
+  font-variant-numeric: tabular-nums;
+  text-align: center;
 }
 
 /* on phones the pill sits slightly higher so the browser chrome and the
    comments FAB do not cover it */
 @media (max-width: 640px) {
   .rt-stopfab {
-    bottom: calc(4.75rem + env(safe-area-inset-bottom));
-    padding: 10px 16px 10px 13px;
+    bottom: calc(4.9rem + env(safe-area-inset-bottom));
+    padding: 6px 14px 6px 6px;
     font-size: 12px;
   }
+  .rt-stopfab-badge {
+    width: 30px;
+    height: 30px;
+  }
